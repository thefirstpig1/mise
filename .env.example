# ============================================================
# Mise — Environment Variables Template
# Copy this file to .env and fill in your values
# ============================================================

# ------------------------------------------------------------
# Database — Neon (PostgreSQL cloud), region ap-southeast-1
# ------------------------------------------------------------
# THREE URLs, and they are three different ROLES doing three different jobs.
# Getting them confused is silent, not loud (ADR 0003 / ADR 0030 / Pitfall #18).
#
#   DATABASE_URL       pooled   (hostname has "-pooler")  role: mise_app
#                      The application. SUBJECT TO row-level security since
#                      Part 30 — owns nothing, has no BYPASSRLS, and cannot
#                      create a table. A query with no tenant context is
#                      REFUSED by Postgres rather than silently returning
#                      zero rows.
#
#   DIRECT_URL         direct   (no "-pooler")            role: neondb_owner
#                      `prisma migrate deploy` and every file in
#                      prisma/manual/. The owner, because those files create
#                      roles, grants and policies.
#
#   ADMIN_DATABASE_URL pooled                             role: neondb_owner
#                      The deliberate bypass door (src/lib/db-admin.ts), with
#                      an allowlist of one. Falls back to DATABASE_URL when
#                      unset, which is wrong for anything but a scratch setup.
DATABASE_URL="postgresql://mise_app:PASSWORD@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/DB?sslmode=require"
DIRECT_URL="postgresql://neondb_owner:PASSWORD@ep-xxx.ap-southeast-1.aws.neon.tech/DB?sslmode=require"
ADMIN_DATABASE_URL="postgresql://neondb_owner:PASSWORD@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/DB?sslmode=require"

# The password `enforce_rls.sql` SETS on the mise_app role, every time the
# manual SQL runs (`pnpm db:manual`, and Fly's release command on every deploy).
#
# 🔴 It must be byte-identical to the password inside DATABASE_URL above, or the
#    application cannot log in to its own database. scripts/apply-manual-sql.mjs
#    refuses to run when they disagree, rather than letting a deploy discover it.
#
# Accepted characters: A-Z a-z 0-9 . _ ~ + -   (it is spliced into a SQL string
# literal). Generate one with:  openssl rand -base64 32 | tr -d '/=+'
MISE_APP_DB_PASSWORD=""

# ------------------------------------------------------------
# Auth.js
# ------------------------------------------------------------
AUTH_SECRET="your-random-secret-here-generate-with-openssl-rand-base64-32"

# The magic link is a URL, and it is the only way anyone gets in — so this is
# the one variable that makes a deployment real (ADR 0031, ADR 0033 Q10).
# Local: http://localhost:3000 · Fly: https://<app-name>.fly.dev
AUTH_URL="http://localhost:3000"

# ------------------------------------------------------------
# Outbound email — SMTP (Part 31, ADR 0031)
# ------------------------------------------------------------
# Through nodemailer, which has been in package.json since Sprint 0. The vendor
# is Resend today and is reversible by editing the hostname here — that is what
# shrank "choose an email vendor" from a blocker to a line in a file.
#
# The switch between logging the link to the console and actually sending it is
# "are there credentials", NOT NODE_ENV: a production server printing a magic
# link to its logs is a working credential sitting in a log file.
EMAIL_FROM="Mise <noreply@your-domain>"
EMAIL_SERVER_HOST="smtp.resend.com"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER="resend"
EMAIL_SERVER_PASSWORD=""

# ------------------------------------------------------------
# Diagnostics (optional)
# ------------------------------------------------------------
# MISE_TX_TRACE=1 reports how long each transaction took to START. Use it
# BEFORE forming a hypothesis about a flaky suite — "could not begin" and "ran
# too long" are different failures that look the same (ADR 0023).
# MISE_TX_TRACE_MS=400 reports only the spikes.
# MISE_TX_TRACE="1"
# MISE_TX_TRACE_MS="400"
