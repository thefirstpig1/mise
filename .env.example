# ============================================================
# Mise — Environment Variables Template
# Copy this file to .env and fill in your values
# ============================================================

# Database — Neon (PostgreSQL cloud). Need BOTH URLs (see ADR 0003 / Pitfall #18):
#   DATABASE_URL = pooled  (hostname has "-pooler")  — app runtime
#   DIRECT_URL   = direct  (no "-pooler")            — prisma migrate
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.ap-southeast-1.aws.neon.tech/DB?sslmode=require"

# Auth.js
AUTH_SECRET="your-random-secret-here-generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# Email provider (for magic link login)
# Sprint 0: log to console (no SMTP needed)
# Production: use SendGrid / Resend / etc.
EMAIL_FROM="noreply@mise.local"
EMAIL_SERVER_HOST="localhost"
EMAIL_SERVER_PORT="1025"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""

# Dev mode flag — enables console-log email
NODE_ENV="development"
