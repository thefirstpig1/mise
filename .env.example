# ============================================================
# Mise — Environment Variables Template
# Copy this file to .env and fill in your values
# ============================================================

# Database (Local Postgres via Docker — Sprint 0)
DATABASE_URL="postgresql://mise:mise_dev_password@localhost:5432/mise_db?schema=public"

# For production, use Neon connection string instead:
# DATABASE_URL="postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/mise_db?sslmode=require"

# Auth.js
AUTH_SECRET="your-random-secret-here-generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# Email provider (for magic link login)
# Sprint 0: log to console (no SMTP needed)
# Production: use SendGrid / Resend / etc.
EMAIL_FROM="noreply@mise.local"
EMAIL_SERVER_HOST="localhost"
EMAIL_SERVER_PORT="1025"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""

# Dev mode flag — enables console-log email
NODE_ENV="development"
