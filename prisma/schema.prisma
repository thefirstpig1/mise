// ============================================================
// Mise — Prisma Schema (Sprint 0 — Identity Layer)
// ============================================================
// Based on Master Spec v1.4
// Tables: tenant, branch, app_user, tenant_membership,
//         user_branch_access, department, user_department_assignment
//
// Additional Sprint 0 tables (for Auth.js + RLS support):
//         Account, Session, VerificationToken
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// AUTH.JS TABLES (managed by @auth/prisma-adapter)
// ============================================================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("account")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_token")
}

// ============================================================
// IDENTITY LAYER (Mise — Sprint 0)
// ============================================================

model Tenant {
  id                   String  @id @default(uuid()) @db.Uuid
  name                 String
  legalName            String? @map("legal_name")
  taxId                String? @map("tax_id")
  timezone             String  @default("Asia/Bangkok")
  currency             String  @default("THB")
  fiscalYearStartMonth Int     @default(1) @map("fiscal_year_start_month")
  plan                 String  @default("trial") // trial, basic, pro, enterprise

  // v1.2 opt-in features
  enableDepartments     Boolean @default(false) @map("enable_departments")
  isVatRegistered       Boolean @default(false) @map("is_vat_registered")
  vatRegistrationNo     String? @map("vat_registration_no")
  defaultVatRatePercent Decimal @default(7.00) @map("default_vat_rate_percent") @db.Decimal(5, 2)

  settings Json? @db.JsonB

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  branches                Branch[]
  memberships             TenantMembership[]
  departments             Department[]
  suppliers               Supplier[]
  categories              Category[]
  products                Product[]
  supplierProductMappings SupplierProductMapping[]
  stockMovements          StockMovement[]
  stockAdjustments        StockAdjustment[]
  purchaseOrders          PurchaseOrder[]
  purchaseOrderItems      PurchaseOrderItem[]
  poItemAllocations       PurchaseOrderItemAllocation[]

  @@map("tenant")
}

model Branch {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  name     String
  /// NOT NULL since Part 11 (ADR 0012 Q8b) — it prefixes every po_number of this
  /// branch ({CODE}-PO-####), so a branch without one cannot issue a PO.
  /// Uniqueness = PARTIAL unique (tenant_id, code) WHERE deleted_at IS NULL in
  /// prisma/manual/branch_code_unique.sql — a FULL unique would let a soft-deleted
  /// branch reserve its code forever (Pitfall #22/#23). NOTE: Department.code
  /// above still uses a FULL @@unique and carries that trap; not fixed here.
  code     String
  address  String?
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  tenant                  Tenant                   @relation(fields: [tenantId], references: [id])
  userAccess              UserBranchAccess[]
  supplierProductMappings SupplierProductMapping[]
  stockMovements          StockMovement[]
  stockAdjustments        StockAdjustment[]
  purchaseOrders          PurchaseOrder[]

  @@index([tenantId])
  @@map("branch")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime? @map("email_verified") // For Auth.js
  name          String?
  image         String? // For Auth.js
  phone         String?
  authProvider  String?   @map("auth_provider")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  accounts             Account[]
  sessions             Session[]
  memberships          TenantMembership[]
  stockMovements       StockMovement[]
  stockAdjustments     StockAdjustment[]
  purchaseOrdersMade   PurchaseOrder[]    @relation("PoCreatedBy")
  purchaseOrdersSent   PurchaseOrder[]    @relation("PoSentBy")
  purchaseOrdersVoided PurchaseOrder[]    @relation("PoCancelledBy")

  @@map("app_user")
}

model TenantMembership {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  userId   String  @map("user_id")
  role     String // owner, manager, purchaser, kitchen_staff, accountant, viewer
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant          Tenant                     @relation(fields: [tenantId], references: [id])
  user            User                       @relation(fields: [userId], references: [id])
  branchAccess    UserBranchAccess[]
  deptAssignments UserDepartmentAssignment[]

  @@unique([tenantId, userId])
  @@map("tenant_membership")
}

model UserBranchAccess {
  id                 String @id @default(uuid()) @db.Uuid
  tenantMembershipId String @map("tenant_membership_id") @db.Uuid
  branchId           String @map("branch_id") @db.Uuid

  membership TenantMembership @relation(fields: [tenantMembershipId], references: [id])
  branch     Branch           @relation(fields: [branchId], references: [id])

  @@unique([tenantMembershipId, branchId])
  @@map("user_branch_access")
}

model Department {
  id           String  @id @default(uuid()) @db.Uuid
  tenantId     String  @map("tenant_id") @db.Uuid
  name         String
  code         String
  description  String?
  parentDeptId String? @map("parent_dept_id") @db.Uuid
  isActive     Boolean @default(true) @map("is_active")
  displayOrder Int?    @map("display_order")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  tenant            Tenant                        @relation(fields: [tenantId], references: [id])
  parentDept        Department?                   @relation("DeptHierarchy", fields: [parentDeptId], references: [id])
  childDepts        Department[]                  @relation("DeptHierarchy")
  assignments       UserDepartmentAssignment[]
  poItemAllocations PurchaseOrderItemAllocation[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("department")
}

model UserDepartmentAssignment {
  id                 String @id @default(uuid()) @db.Uuid
  tenantMembershipId String @map("tenant_membership_id") @db.Uuid
  departmentId       String @map("department_id") @db.Uuid

  isPrimary     Boolean @default(false) @map("is_primary")
  canRequestFor Boolean @default(false) @map("can_request_for")
  canApproveFor Boolean @default(false) @map("can_approve_for")
  canReceiveFor Boolean @default(false) @map("can_receive_for")

  membership TenantMembership @relation(fields: [tenantMembershipId], references: [id])
  department Department       @relation(fields: [departmentId], references: [id])

  @@unique([tenantMembershipId, departmentId])
  @@map("user_department_assignment")
}

// ============================================================
// REFERENCE TABLES (Sprint 1 — system-wide, no RLS)
// ============================================================

model UnitTemplate {
  id             String   @id @default(uuid()) @db.Uuid
  unitName       String   @unique @map("unit_name")
  unitDimension  String   @map("unit_dimension") // "WEIGHT" | "VOLUME" | "COUNT"
  toSiRatio      Decimal? @map("to_si_ratio") @db.Decimal(15, 6) // g for WEIGHT, ml for VOLUME, null for COUNT
  displayOrderTh Int?     @map("display_order_th")
  displayOrderEn Int?     @map("display_order_en")

  @@map("unit_template")
}

model LiquidDensityTemplate {
  id           String  @id @default(uuid()) @db.Uuid
  /// FULL unique safe เพราะ table นี้ไม่มี soft-delete (Q7).
  /// ถ้าเพิ่ม deletedAt ในอนาคต → ต้อง swap เป็น partial index
  /// ใน prisma/manual/ (precedent: supplier_code_unique.sql)
  /// เพื่อกัน Pitfall #22/#23 family (full unique + ghost row)
  name         String  @unique
  gPerMl       Decimal @map("g_per_ml") @db.Decimal(15, 6)
  description  String?
  displayOrder Int?    @map("display_order")

  products Product[]

  @@map("liquid_density_template")
}

// ============================================================
// MASTER DATA (Sprint 1 — tenant-scoped, RLS required)
// ============================================================

model Supplier {
  id                    String   @id @default(uuid()) @db.Uuid
  tenantId              String   @map("tenant_id") @db.Uuid
  /// Uniqueness enforced by partial unique index in
  /// prisma/manual/supplier_code_unique.sql (per-tenant, excludes soft-deleted + NULL).
  /// Not a Prisma @@unique because Prisma can't express partial indexes.
  code                  String?
  nameFull              String   @map("name_full")
  nameShort             String?  @map("name_short")
  contactName           String?  @map("contact_name")
  contactPhone          String?  @map("contact_phone")
  contactEmail          String?  @map("contact_email")
  lineId                String?  @map("line_id")
  address               String?
  taxId                 String?  @map("tax_id")
  paymentTerms          String?  @map("payment_terms")
  isActive              Boolean  @default(true) @map("is_active")
  isVatRegistered       Boolean  @default(false) @map("is_vat_registered")
  defaultVatRatePercent Decimal? @map("default_vat_rate_percent") @db.Decimal(5, 2)
  defaultSubjectToWht   Boolean  @default(false) @map("default_subject_to_wht")
  defaultWhtRatePercent Decimal? @map("default_wht_rate_percent") @db.Decimal(5, 2)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  tenant                  Tenant                   @relation(fields: [tenantId], references: [id])
  supplierProductMappings SupplierProductMapping[]
  purchaseOrders          PurchaseOrder[]

  @@index([tenantId])
  @@map("supplier")
}

model Category {
  id                String @id @default(uuid()) @db.Uuid
  tenantId          String @map("tenant_id") @db.Uuid
  account           String
  accountingSection String @map("accounting_section")
  groupName         String @map("group")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  products Product[]

  @@unique([tenantId, account, accountingSection, groupName])
  @@index([tenantId])
  @@map("category")
}

model Product {
  id                      String   @id @default(uuid()) @db.Uuid
  tenantId                String   @map("tenant_id") @db.Uuid
  /// Uniqueness enforced by partial unique index in
  /// prisma/manual/product_sku_unique.sql (per-tenant, excludes soft-deleted).
  /// Not a Prisma @@unique because Prisma can't express partial indexes.
  sku                     String
  name                    String
  nameEn                  String?  @map("name_en")
  type                    String // "RAW" | "PREPPED"
  primaryDimension        String   @map("primary_dimension") // "WEIGHT" | "VOLUME" | "COUNT"
  categoryId              String?  @map("category_id") @db.Uuid
  liquidDensityTemplateId String?  @map("liquid_density_template_id") @db.Uuid
  densityGPerMlOverride   Decimal? @map("density_g_per_ml_override") @db.Decimal(15, 6)
  yieldPercent            Decimal? @map("yield_percent") @db.Decimal(5, 2)
  parentProductId         String?  @map("parent_product_id") @db.Uuid
  expectedYieldG          Decimal? @map("expected_yield_g") @db.Decimal(15, 6)
  targetMarketPrice       Decimal? @map("target_market_price") @db.Decimal(15, 4)
  imageUrl                String?  @map("image_url")
  isActive                Boolean  @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  tenant                  Tenant                   @relation(fields: [tenantId], references: [id])
  category                Category?                @relation(fields: [categoryId], references: [id])
  liquidDensityTemplate   LiquidDensityTemplate?   @relation(fields: [liquidDensityTemplateId], references: [id])
  parentProduct           Product?                 @relation("ProductPrepped", fields: [parentProductId], references: [id])
  childProducts           Product[]                @relation("ProductPrepped")
  productUnits            ProductUnit[]
  supplierProductMappings SupplierProductMapping[]
  stockMovements          StockMovement[]
  stockAdjustments        StockAdjustment[]
  purchaseOrderItems      PurchaseOrderItem[]

  /// NOTE: per-tenant sku uniqueness is a PARTIAL unique index (WHERE deleted_at
  /// IS NULL) in prisma/manual/product_sku_unique.sql — NOT a Prisma @@unique,
  /// which Prisma 5.22 can only express as a FULL index (Pitfall #23). See sku field.
  @@index([tenantId])
  @@map("product")
}

model ProductUnit {
  id               String  @id @default(uuid()) @db.Uuid
  productId        String  @map("product_id") @db.Uuid
  unitName         String  @map("unit_name")
  unitDimension    String  @map("unit_dimension")
  toBaseRatio      Decimal @map("to_base_ratio") @db.Decimal(15, 6)
  isBase           Boolean @default(false) @map("is_base")
  isDefaultBuyUnit Boolean @default(false) @map("is_default_buy_unit")
  source           String?
  displayOrder     Int?    @map("display_order")

  product                 Product                  @relation(fields: [productId], references: [id])
  supplierProductMappings SupplierProductMapping[]
  stockAdjustments        StockAdjustment[]
  purchaseOrderItems      PurchaseOrderItem[]

  @@unique([productId, unitName])
  @@index([productId])
  @@map("product_unit")
}

model SupplierProductMapping {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  supplierId       String    @map("supplier_id") @db.Uuid
  productId        String    @map("product_id") @db.Uuid
  branchId         String?   @map("branch_id") @db.Uuid // NULL = tenant default, NOT NULL = branch override
  supplierItemCode String?   @map("supplier_item_code")
  supplierItemName String?   @map("supplier_item_name")
  orderUnitId      String?   @map("order_unit_id") @db.Uuid
  currentUnitPrice Decimal?  @map("current_unit_price") @db.Decimal(15, 4)
  minOrderQty      Decimal?  @map("min_order_qty") @db.Decimal(15, 6)
  leadTimeDays     Int?      @map("lead_time_days")
  isPreferred      Boolean   @default(false) @map("is_preferred")
  effectiveFrom    DateTime  @map("effective_from") @db.Date
  effectiveTo      DateTime? @map("effective_to") @db.Date

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  tenant             Tenant              @relation(fields: [tenantId], references: [id])
  supplier           Supplier            @relation(fields: [supplierId], references: [id])
  product            Product             @relation(fields: [productId], references: [id])
  branch             Branch?             @relation(fields: [branchId], references: [id])
  orderUnit          ProductUnit?        @relation(fields: [orderUnitId], references: [id])
  /// Provenance only (ADR 0012 Q3) — a PO line snapshots the numbers it needs and
  /// never reads back through this link.
  purchaseOrderItems PurchaseOrderItem[]

  /// Composite uniqueness enforced by partial unique index in
  /// prisma/manual/supplier_product_mapping_unique.sql
  /// (tenant_id, supplier_id, product_id, branch_id, effective_from)
  /// WHERE deleted_at IS NULL + NULLS NOT DISTINCT.
  /// Not a Prisma @@unique because Prisma can't express partial indexes
  /// (WHERE / NULLS NOT DISTINCT). Closes Pitfall #22/#23 family (soft-deleted
  /// rows never block re-create) + the branch_id-NULL duplicate-default hole.
  @@index([tenantId])
  @@map("supplier_product_mapping")
}

// ============================================================
// TRANSACTIONAL (Sprint 2 — tenant-scoped, RLS required)
// ============================================================
// NOTE: 3 enums ข้างล่างเป็น Prisma enum ตัวแรกของโปรเจกต์ — Sprint 1 ใช้
// String + comment + z.enum ที่ validation layer (Product.type, primaryDimension).
// Part 10 เลือก Prisma enum เพราะ ledger ต้องการ DB-level guarantee
// (sign CHECK อ้าง enum value ตรง ๆ) ไม่ใช่แค่ app-level pattern — ADR 0011 Q2/Q3/Q10.

enum MovementType {
  PO_RECEIVE // +  IN  — from GR (Part 13)
  ADJUST_GAIN // +  IN  — manual count correction up
  ADJUST_LOSS // -  OUT — manual count down / spoilage / waste

  @@map("movement_type")
}

enum SourceType {
  GR_LINE // -> goods_received_line (Part 13)
  ADJUSTMENT // -> stock_adjustment (Part 10)
  SYSTEM_INITIAL // reserved: onboarding initial stock (no writer in Part 10)

  @@map("source_type")
}

enum AdjustmentReason {
  RECOUNT
  SPOILAGE
  DAMAGE
  OTHER

  @@map("adjustment_reason")
}

/// Append-only stock ledger. INSERT-only: ไม่มี updatedAt / deletedAt และไม่มี
/// update*Logic / delete*Logic (ADR 0011 Q7). การแก้ = compensating row ใหม่ (Q4).
/// Balance = SUM(qty) แบบ realtime (Q8) — qty เป็น base unit ของ product เสมอ (Q1).
model StockMovement {
  id         String       @id @default(uuid()) @db.Uuid
  tenantId   String       @map("tenant_id") @db.Uuid
  productId  String       @map("product_id") @db.Uuid
  /// NOT NULL (Q6) — stock อยู่ที่ใดที่หนึ่งเสมอ, SUM/GROUP BY ไม่ต้องจัดการ NULL
  branchId   String       @map("branch_id") @db.Uuid
  /// signed, base unit (Q1/Q2): + = เข้า, - = ออก
  qty        Decimal      @db.Decimal(15, 3)
  type       MovementType
  sourceType SourceType   @map("source_type")
  /// Polymorphic source — ไม่มี FK โดยเจตนา (Q3): ledger อยู่ยืนกว่า source ของมัน
  sourceId   String       @map("source_id") @db.Uuid
  /// business time — backdate ได้ (Q5)
  occurredAt DateTime     @default(now()) @map("occurred_at")
  /// audit time — immutable (Q5)
  createdAt  DateTime     @default(now()) @map("created_at")
  createdBy  String       @map("created_by")
  notes      String?

  tenant        Tenant  @relation(fields: [tenantId], references: [id])
  product       Product @relation(fields: [productId], references: [id])
  branch        Branch  @relation(fields: [branchId], references: [id])
  createdByUser User    @relation(fields: [createdBy], references: [id])

  /// Sign CHECK (stock_movement_sign_check) เขียน INLINE ที่ท้าย migration.sql ของ Part 10
  /// เพราะ Prisma แสดง CHECK ไม่ได้ — precedent: product_density_xor ใน
  /// 20260529151309_part_7d_density_data_capture. ไม่ใช่ manual file: prisma/manual/
  /// สงวนไว้สำหรับสิ่งที่ migration.sql เขียนมือไม่ได้ (partial index / NULLS NOT
  /// DISTINCT / CREATE EXTENSION) — ดู ADR 0011 Q2 correction.
  /// FULL @@unique ปลอดภัยที่นี่ เพราะ ledger ไม่มี soft-delete → Pitfall #22/#23 ไม่ applied.
  @@unique([sourceType, sourceId], map: "stock_movement_source_unique")
  @@index([branchId, occurredAt], map: "stock_movement_branch_audit_idx")
  @@index([productId, branchId, occurredAt, createdAt], map: "stock_movement_chronological_idx")
  @@index([tenantId])
  @@map("stock_movement")
}

/// Manual adjustment source (Q10). 1 adjustment -> 1 StockMovement ใน transaction เดียวกัน
/// (Q4). เก็บ "หน่วย + จำนวนตามที่ผู้ใช้กรอก" ไว้เพื่อ audit (Q1) ส่วน signed base-unit qty
/// อยู่บน movement. reason ป้อน waste analytics ของ Sprint 2.
model StockAdjustment {
  id          String           @id @default(uuid()) @db.Uuid
  tenantId    String           @map("tenant_id") @db.Uuid
  productId   String           @map("product_id") @db.Uuid
  branchId    String           @map("branch_id") @db.Uuid
  /// ADJUST_GAIN | ADJUST_LOSS เท่านั้น — บังคับด้วย stock_adjustment_type_check
  /// (inline ท้าย migration.sql เดียวกัน, ADR 0011 Q10)
  type        MovementType
  reason      AdjustmentReason
  /// as-entered magnitude (Q1) — precision (15,3) ให้ตรงกับ movement.qty
  /// เพื่อไม่ให้ input_qty × toBaseRatio -> qty มี precision กระโดด
  inputQty    Decimal          @map("input_qty") @db.Decimal(15, 3)
  inputUnitId String           @map("input_unit_id") @db.Uuid
  /// business time — mirror ค่าเดียวกับ movement.occurredAt (Q5)
  occurredAt  DateTime         @map("occurred_at")
  createdAt   DateTime         @default(now()) @map("created_at")
  createdBy   String           @map("created_by")

  tenant        Tenant      @relation(fields: [tenantId], references: [id])
  product       Product     @relation(fields: [productId], references: [id])
  branch        Branch      @relation(fields: [branchId], references: [id])
  inputUnit     ProductUnit @relation(fields: [inputUnitId], references: [id])
  createdByUser User        @relation(fields: [createdBy], references: [id])

  @@index([tenantId])
  @@index([productId, branchId, occurredAt], map: "stock_adjustment_product_branch_idx")
  @@map("stock_adjustment")
}

// ============================================================
// PROCUREMENT (Sprint 2 Part 11 — ADR 0012)
// ============================================================
// A PO is a DOCUMENT THAT LEFT THE BUILDING: editable while DRAFT, frozen from
// SENT (Q4). Every number a line needs in order to still mean the same thing
// years later — unit price, unit name, to_base_ratio — is COPIED onto the line
// (Q3), never followed through a live FK.
//
// Deliberate divergences from master-spec §5.3, all recorded in ADR 0012:
//   - no purchase_request / from_pr_ids / source_pr_id (Q1 — PR is Sprint 3+)
//   - no wht_expected_amount / net_payment_expected (Q6 — WHT is Sprint 3)
//   - no H.2 deferrable trigger pair (Q2 — the allocation sum is app-enforced)
//   - tenant_id lives on ALL THREE tables, unlike the spec's child-table shape:
//     app-layer isolation (ADR 0004) works by filtering tenantId EXPLICITLY, and
//     a column that isn't there cannot be filtered. RLS is still inert.

enum PurchaseOrderStatus {
  DRAFT // editable
  SENT // frozen (Q4); sent_at set
  PARTIALLY_RECEIVED // written by Part 13 (GR) only
  RECEIVED // written by Part 13 (GR) only
  CANCELLED // terminal; a sent PO is never deleted (Q9)

  @@map("purchase_order_status")
}

/// Order header. VAT is snapshotted here at send time (Q6); WHT is not captured.
model PurchaseOrder {
  id         String              @id @default(uuid()) @db.Uuid
  tenantId   String              @map("tenant_id") @db.Uuid
  /// NOT NULL (spec §125) — an order is always placed by a branch, and its code
  /// is baked into po_number.
  branchId   String              @map("branch_id") @db.Uuid
  supplierId String              @map("supplier_id") @db.Uuid
  /// {BRANCH_CODE}-PO-#### (Q8), counter per branch, never resets. Uniqueness =
  /// PARTIAL unique in prisma/manual/purchase_order_number_unique.sql (a DRAFT can
  /// be soft-deleted — Q9 — so a FULL unique would be Pitfall #22/#23).
  poNumber   String              @map("po_number")
  status     PurchaseOrderStatus @default(DRAFT)

  expectedDeliveryDate DateTime? @map("expected_delivery_date") @db.Date

  /// --- VAT snapshot (Q6), frozen when the PO is sent ---
  /// Sum of line totals. 15,2 = THB satang; unit prices carry more precision.
  subtotalExclVat Decimal  @default(0) @map("subtotal_excl_vat") @db.Decimal(15, 2)
  /// null = this order carries no VAT (supplier not registered).
  vatRatePercent  Decimal? @map("vat_rate_percent") @db.Decimal(5, 2)
  vatAmount       Decimal  @default(0) @map("vat_amount") @db.Decimal(15, 2)
  totalAmount     Decimal  @default(0) @map("total_amount") @db.Decimal(15, 2)

  notes String?

  /// --- lifecycle audit (Q4/Q9) ---
  createdBy    String    @map("created_by")
  sentAt       DateTime? @map("sent_at")
  sentBy       String?   @map("sent_by")
  cancelledAt  DateTime? @map("cancelled_at")
  cancelledBy  String?   @map("cancelled_by")
  cancelReason String?   @map("cancel_reason")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  /// DRAFT only (Q9) — a sent PO goes to CANCELLED and stays visible forever.
  deletedAt DateTime? @map("deleted_at")

  tenant          Tenant              @relation(fields: [tenantId], references: [id])
  branch          Branch              @relation(fields: [branchId], references: [id])
  supplier        Supplier            @relation(fields: [supplierId], references: [id])
  createdByUser   User                @relation("PoCreatedBy", fields: [createdBy], references: [id])
  sentByUser      User?               @relation("PoSentBy", fields: [sentBy], references: [id])
  cancelledByUser User?               @relation("PoCancelledBy", fields: [cancelledBy], references: [id])
  items           PurchaseOrderItem[]

  @@index([tenantId])
  @@index([tenantId, status], map: "purchase_order_tenant_status_idx")
  @@index([branchId, status], map: "purchase_order_branch_status_idx")
  @@index([supplierId], map: "purchase_order_supplier_idx")
  @@map("purchase_order")
}

/// One ordered product. Everything under "snapshot" is frozen at send time (Q3)
/// and must never be re-derived from the live ProductUnit / mapping afterwards.
model PurchaseOrderItem {
  id              String @id @default(uuid()) @db.Uuid
  tenantId        String @map("tenant_id") @db.Uuid
  purchaseOrderId String @map("purchase_order_id") @db.Uuid
  productId       String @map("product_id") @db.Uuid
  /// Stable display order + the identity the edit form diffs rows by.
  lineNo          Int    @map("line_no")

  /// Quantity IN THE ORDERED UNIT (Q3) — what the supplier's invoice will say.
  qtyOrdered  Decimal @map("qty_ordered") @db.Decimal(15, 3)
  orderUnitId String  @map("order_unit_id") @db.Uuid

  /// --- snapshot (Q3) ---
  /// Copied from ProductUnit at send time so a later rename/ratio edit cannot
  /// change what this order meant. to_base_ratio mirrors ProductUnit's (15,6).
  orderUnitName String  @map("order_unit_name")
  toBaseRatio   Decimal @map("to_base_ratio") @db.Decimal(15, 6)
  /// excl VAT. 15,4 matches supplier_product_mapping.current_unit_price.
  unitPrice     Decimal @map("unit_price") @db.Decimal(15, 4)
  /// round(qtyOrdered × unitPrice, 2) — computed in the app, stored, never re-derived.
  lineTotal     Decimal @map("line_total") @db.Decimal(15, 2)

  /// Provenance ONLY (Q3). null = the price was typed by hand (Q5).
  supplierProductMappingId String? @map("supplier_product_mapping_id") @db.Uuid

  /// Maintained by Part 13 (GR) exclusively; created here so Part 13 needs no
  /// migration on a table it does not own.
  qtyReceived Decimal @default(0) @map("qty_received") @db.Decimal(15, 3)

  notes String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant                 Tenant                        @relation(fields: [tenantId], references: [id])
  purchaseOrder          PurchaseOrder                 @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product                Product                       @relation(fields: [productId], references: [id])
  orderUnit              ProductUnit                   @relation(fields: [orderUnitId], references: [id])
  supplierProductMapping SupplierProductMapping?       @relation(fields: [supplierProductMappingId], references: [id])
  allocations            PurchaseOrderItemAllocation[]

  @@unique([purchaseOrderId, lineNo], map: "purchase_order_item_line_unique")
  @@index([tenantId])
  @@index([purchaseOrderId], map: "purchase_order_item_parent_idx")
  @@index([productId], map: "purchase_order_item_product_idx")
  @@map("purchase_order_item")
}

/// Department attribution of a line's quantity (Q2). SUM(qtyAllocated) per line
/// MUST equal the line's qtyOrdered — enforced in the write transaction, NOT by
/// the H.2 trigger pair (see ADR 0012 Q2). While departments are off there is
/// exactly one row per line, pointing at "Main".
/// No deletedAt: allocations are replaced wholesale with their (DRAFT) parent line.
model PurchaseOrderItemAllocation {
  id                  String  @id @default(uuid()) @db.Uuid
  tenantId            String  @map("tenant_id") @db.Uuid
  purchaseOrderItemId String  @map("purchase_order_item_id") @db.Uuid
  departmentId        String  @map("department_id") @db.Uuid
  qtyAllocated        Decimal @map("qty_allocated") @db.Decimal(15, 3)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant            Tenant            @relation(fields: [tenantId], references: [id])
  purchaseOrderItem PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id], onDelete: Cascade)
  department        Department        @relation(fields: [departmentId], references: [id])

  @@unique([purchaseOrderItemId, departmentId], map: "po_item_allocation_dept_unique")
  @@index([tenantId])
  @@index([departmentId], map: "po_item_allocation_dept_idx")
  @@map("purchase_order_item_allocation")
}
