// ============================================================
// Mise — Prisma Schema (Sprint 0 — Identity Layer)
// ============================================================
// Based on Master Spec v1.4
// Tables: tenant, branch, app_user, tenant_membership,
//         user_branch_access, department, user_department_assignment
//
// Additional Sprint 0 tables (for Auth.js + RLS support):
//         Account, Session, VerificationToken
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// AUTH.JS TABLES (managed by @auth/prisma-adapter)
// ============================================================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("account")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_token")
}

// ============================================================
// IDENTITY LAYER (Mise — Sprint 0)
// ============================================================

model Tenant {
  id                   String  @id @default(uuid()) @db.Uuid
  name                 String
  legalName            String? @map("legal_name")
  taxId                String? @map("tax_id")
  timezone             String  @default("Asia/Bangkok")
  currency             String  @default("THB")
  fiscalYearStartMonth Int     @default(1) @map("fiscal_year_start_month")
  plan                 String  @default("trial") // trial, basic, pro, enterprise

  /// Which way this shop wants gross profit worked out (ADR 0019 Q17). Two shops
  /// can honestly disagree: one counts stock, the other keeps recipes, and the
  /// right answer follows whichever discipline they actually keep.
  grossProfitMethod GrossProfitMethod @default(PERIODIC_INVENTORY) @map("gross_profit_method")

  /// What a cancelled bill does to stock (ADR 0022 Q3). The file cannot say
  /// whether it was cancelled at the till before anyone cooked or sent back
  /// after — the first returns nothing to stock, the second consumed the
  /// ingredients — and both are common. The shop knows; we do not.
  cancelledSalePolicy CancelledSalePolicy @default(TREAT_AS_COOKED) @map("cancelled_sale_policy")

  // v1.2 opt-in features
  enableDepartments     Boolean @default(false) @map("enable_departments")
  isVatRegistered       Boolean @default(false) @map("is_vat_registered")
  vatRegistrationNo     String? @map("vat_registration_no")
  defaultVatRatePercent Decimal @default(7.00) @map("default_vat_rate_percent") @db.Decimal(5, 2)

  settings Json? @db.JsonB

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  branches                Branch[]
  memberships             TenantMembership[]
  departments             Department[]
  suppliers               Supplier[]
  categories              Category[]
  products                Product[]
  supplierProductMappings SupplierProductMapping[]
  stockMovements          StockMovement[]
  stockAdjustments        StockAdjustment[]
  stockCostDeclarations   StockCostDeclaration[]
  stockCounts             StockCount[]
  stockCountItems         StockCountItem[]
  stockCountEntries       StockCountEntry[]
  purchaseOrders          PurchaseOrder[]
  purchaseOrderItems      PurchaseOrderItem[]
  poItemAllocations       PurchaseOrderItemAllocation[]
  goodsReceipts           GoodsReceipt[]
  goodsReceiptItems       GoodsReceiptItem[]
  grItemAllocations       GoodsReceiptItemAllocation[]
  expenses                Expense[]
  expenseItems            ExpenseItem[]
  recurringExpenses       RecurringExpense[]
  wasteLogs               WasteLog[]
  parLevels               ParLevel[]
  stockTransfers          StockTransfer[]
  stockTransferItems      StockTransferItem[]
  posIntegrations         PosIntegration[]
  salesImportProfiles     SalesImportProfile[]
  salesImportBatches      SalesImportBatch[]
  salesDays               SalesDay[]
  menuCategories          MenuCategory[]
  menus                   Menu[]
  menuAliases             MenuAlias[]
  salesLines              SalesLine[]
  recipes                 Recipe[]
  recipeIngredients       RecipeIngredient[]
  recipeBranches          RecipeBranch[]
  salesConsumptionRuns    SalesConsumptionRun[]
  salesConsumptionItems   SalesConsumptionItem[]

  @@map("tenant")
}

model Branch {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  name     String
  /// NOT NULL since Part 11 (ADR 0012 Q8b) — it prefixes every po_number of this
  /// branch ({CODE}-PO-####), so a branch without one cannot issue a PO.
  /// Uniqueness = PARTIAL unique (tenant_id, code) WHERE deleted_at IS NULL in
  /// prisma/manual/branch_code_unique.sql — a FULL unique would let a soft-deleted
  /// branch reserve its code forever (Pitfall #22/#23). NOTE: Department.code
  /// above still uses a FULL @@unique and carries that trap; not fixed here.
  code     String
  address  String?
  isActive Boolean @default(true) @map("is_active")

  /// ★ ADR 0019 Q15 — where this branch cuts one SALES DAY from the next, as
  /// minutes past midnight (300 = 05:00). A bill closed at 01:30 belongs to the
  /// night before, and a restaurant decides for itself where that line falls.
  ///
  /// Used ONLY when a file carries times but no date. When the file states a day,
  /// that statement wins and Mise never recomputes it — the POS settled it at
  /// shift close and every report the shop already argues over uses it (rule P14).
  ///
  /// Changing this affects FUTURE imports only. `sales_line.business_date` is
  /// already a stored DATE, so past rows do not re-bucket; correcting them means
  /// re-importing those days, which rule P3 supports. This is a value the user
  /// sets and can get wrong, so it belongs in the user manual, not only on screen.
  salesDayCutoffMinutes Int @default(300) @map("sales_day_cutoff_minutes")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  tenant                  Tenant                   @relation(fields: [tenantId], references: [id])
  userAccess              UserBranchAccess[]
  supplierProductMappings SupplierProductMapping[]
  stockMovements          StockMovement[]
  stockAdjustments        StockAdjustment[]
  stockCounts             StockCount[]
  purchaseOrders          PurchaseOrder[]
  goodsReceipts           GoodsReceipt[]
  expenses                Expense[]
  recurringExpenses       RecurringExpense[]
  wasteLogs               WasteLog[]
  parLevels               ParLevel[]
  /// Part 18: a branch sits on BOTH ends of a transfer, so the two sides need
  /// names — without them Prisma cannot tell which FK each list belongs to.
  transfersOut            StockTransfer[]          @relation("TransferFrom")
  transfersIn             StockTransfer[]          @relation("TransferTo")
  posIntegrations         PosIntegration[]
  salesImportBatches      SalesImportBatch[]
  salesDays               SalesDay[]
  salesLines              SalesLine[]
  recipeBranches          RecipeBranch[]
  salesConsumptionRuns    SalesConsumptionRun[]

  @@index([tenantId])
  @@map("branch")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime? @map("email_verified") // For Auth.js
  name          String?
  image         String? // For Auth.js
  phone         String?
  authProvider  String?   @map("auth_provider")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  accounts                  Account[]
  sessions                  Session[]
  memberships               TenantMembership[]
  stockMovements            StockMovement[]
  stockAdjustments          StockAdjustment[]
  stockCostDeclarations     StockCostDeclaration[]
  stockCountsStarted        StockCount[]           @relation("ScStartedBy")
  stockCountsClosed         StockCount[]           @relation("ScClosedBy")
  stockCountsVoided         StockCount[]           @relation("ScVoidedBy")
  stockCountItemsCounted    StockCountItem[]
  purchaseOrdersMade        PurchaseOrder[]        @relation("PoCreatedBy")
  purchaseOrdersSent        PurchaseOrder[]        @relation("PoSentBy")
  purchaseOrdersVoided      PurchaseOrder[]        @relation("PoCancelledBy")
  purchaseOrdersClosedShort PurchaseOrder[]        @relation("PoClosedShortBy")
  goodsReceiptsReceived     GoodsReceipt[]         @relation("GrReceivedBy")
  goodsReceiptsConfirmed    GoodsReceipt[]         @relation("GrConfirmedBy")
  goodsReceiptsVoided       GoodsReceipt[]         @relation("GrVoidedBy")
  expensesCreated           Expense[]
  wasteLogged               WasteLog[]             @relation("WasteWastedBy")
  wasteVoided               WasteLog[]             @relation("WasteVoidedBy")
  consumptionPosted         SalesConsumptionRun[]  @relation("ConsumptionPostedBy")
  consumptionVoided         SalesConsumptionRun[]  @relation("ConsumptionVoidedBy")
  transfersDispatched       StockTransfer[]        @relation("TfDispatchedBy")
  /// Null on every row until user management ships (ADR 0018 Q3) — a company
  /// driver is a member and will confirm as themselves; a hired outside driver
  /// never will, and `driver_name` is the record for both until then.
  transfersDriven           StockTransfer[]        @relation("TfDriver")
  transfersReceived         StockTransfer[]        @relation("TfReceivedBy")
  transfersVoided           StockTransfer[]        @relation("TfVoidedBy")
  salesImportsUploaded      SalesImportBatch[]     @relation("SalesImportUploadedBy")
  menuAliasesConfirmed      MenuAlias[]            @relation("MenuAliasConfirmedBy")
  salesPulsesRecorded       SalesDay[]             @relation("SalesPulseRecordedBy")
  recipesCreated            Recipe[]               @relation("RecipeCreatedBy")

  @@map("app_user")
}

model TenantMembership {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  userId   String  @map("user_id")
  role     String // owner, manager, purchaser, kitchen_staff, accountant, viewer
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant          Tenant                     @relation(fields: [tenantId], references: [id])
  user            User                       @relation(fields: [userId], references: [id])
  branchAccess    UserBranchAccess[]
  deptAssignments UserDepartmentAssignment[]

  @@unique([tenantId, userId])
  @@map("tenant_membership")
}

model UserBranchAccess {
  id                 String @id @default(uuid()) @db.Uuid
  tenantMembershipId String @map("tenant_membership_id") @db.Uuid
  branchId           String @map("branch_id") @db.Uuid

  membership TenantMembership @relation(fields: [tenantMembershipId], references: [id])
  branch     Branch           @relation(fields: [branchId], references: [id])

  @@unique([tenantMembershipId, branchId])
  @@map("user_branch_access")
}

model Department {
  id           String  @id @default(uuid()) @db.Uuid
  tenantId     String  @map("tenant_id") @db.Uuid
  name         String
  code         String
  description  String?
  parentDeptId String? @map("parent_dept_id") @db.Uuid
  isActive     Boolean @default(true) @map("is_active")
  displayOrder Int?    @map("display_order")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  tenant            Tenant                        @relation(fields: [tenantId], references: [id])
  parentDept        Department?                   @relation("DeptHierarchy", fields: [parentDeptId], references: [id])
  childDepts        Department[]                  @relation("DeptHierarchy")
  assignments       UserDepartmentAssignment[]
  poItemAllocations PurchaseOrderItemAllocation[]
  grItemAllocations GoodsReceiptItemAllocation[]
  expenseItems      ExpenseItem[]
  /// Part 19 Q16 — which department a menu earns revenue for.
  menus             Menu[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("department")
}

model UserDepartmentAssignment {
  id                 String @id @default(uuid()) @db.Uuid
  tenantMembershipId String @map("tenant_membership_id") @db.Uuid
  departmentId       String @map("department_id") @db.Uuid

  isPrimary     Boolean @default(false) @map("is_primary")
  canRequestFor Boolean @default(false) @map("can_request_for")
  canApproveFor Boolean @default(false) @map("can_approve_for")
  canReceiveFor Boolean @default(false) @map("can_receive_for")

  membership TenantMembership @relation(fields: [tenantMembershipId], references: [id])
  department Department       @relation(fields: [departmentId], references: [id])

  @@unique([tenantMembershipId, departmentId])
  @@map("user_department_assignment")
}

// ============================================================
// REFERENCE TABLES (Sprint 1 — system-wide, no RLS)
// ============================================================

model UnitTemplate {
  id             String   @id @default(uuid()) @db.Uuid
  unitName       String   @unique @map("unit_name")
  unitDimension  String   @map("unit_dimension") // "WEIGHT" | "VOLUME" | "COUNT"
  toSiRatio      Decimal? @map("to_si_ratio") @db.Decimal(15, 6) // g for WEIGHT, ml for VOLUME, null for COUNT
  displayOrderTh Int?     @map("display_order_th")
  displayOrderEn Int?     @map("display_order_en")

  @@map("unit_template")
}

model LiquidDensityTemplate {
  id           String  @id @default(uuid()) @db.Uuid
  /// FULL unique safe เพราะ table นี้ไม่มี soft-delete (Q7).
  /// ถ้าเพิ่ม deletedAt ในอนาคต → ต้อง swap เป็น partial index
  /// ใน prisma/manual/ (precedent: supplier_code_unique.sql)
  /// เพื่อกัน Pitfall #22/#23 family (full unique + ghost row)
  name         String  @unique
  gPerMl       Decimal @map("g_per_ml") @db.Decimal(15, 6)
  description  String?
  displayOrder Int?    @map("display_order")

  products Product[]

  @@map("liquid_density_template")
}

// ============================================================
// MASTER DATA (Sprint 1 — tenant-scoped, RLS required)
// ============================================================

model Supplier {
  id                    String   @id @default(uuid()) @db.Uuid
  tenantId              String   @map("tenant_id") @db.Uuid
  /// Uniqueness enforced by partial unique index in
  /// prisma/manual/supplier_code_unique.sql (per-tenant, excludes soft-deleted + NULL).
  /// Not a Prisma @@unique because Prisma can't express partial indexes.
  code                  String?
  nameFull              String   @map("name_full")
  nameShort             String?  @map("name_short")
  contactName           String?  @map("contact_name")
  contactPhone          String?  @map("contact_phone")
  contactEmail          String?  @map("contact_email")
  lineId                String?  @map("line_id")
  address               String?
  taxId                 String?  @map("tax_id")
  paymentTerms          String?  @map("payment_terms")
  isActive              Boolean  @default(true) @map("is_active")
  isVatRegistered       Boolean  @default(false) @map("is_vat_registered")
  defaultVatRatePercent Decimal? @map("default_vat_rate_percent") @db.Decimal(5, 2)
  defaultSubjectToWht   Boolean  @default(false) @map("default_subject_to_wht")
  defaultWhtRatePercent Decimal? @map("default_wht_rate_percent") @db.Decimal(5, 2)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  tenant                  Tenant                   @relation(fields: [tenantId], references: [id])
  supplierProductMappings SupplierProductMapping[]
  purchaseOrders          PurchaseOrder[]
  goodsReceipts           GoodsReceipt[]
  expenses                Expense[]
  recurringExpenses       RecurringExpense[]

  @@index([tenantId])
  @@map("supplier")
}

model Category {
  id                String @id @default(uuid()) @db.Uuid
  tenantId          String @map("tenant_id") @db.Uuid
  account           String
  accountingSection String @map("accounting_section")
  groupName         String @map("group")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  tenant            Tenant             @relation(fields: [tenantId], references: [id])
  products          Product[]
  expenseItems      ExpenseItem[]
  recurringExpenses RecurringExpense[]

  @@unique([tenantId, account, accountingSection, groupName])
  @@index([tenantId])
  @@map("category")
}

model Product {
  id                      String   @id @default(uuid()) @db.Uuid
  tenantId                String   @map("tenant_id") @db.Uuid
  /// Uniqueness enforced by partial unique index in
  /// prisma/manual/product_sku_unique.sql (per-tenant, excludes soft-deleted).
  /// Not a Prisma @@unique because Prisma can't express partial indexes.
  sku                     String
  name                    String
  nameEn                  String?  @map("name_en")
  type                    String // "RAW" | "PREPPED"
  primaryDimension        String   @map("primary_dimension") // "WEIGHT" | "VOLUME" | "COUNT"
  categoryId              String?  @map("category_id") @db.Uuid
  liquidDensityTemplateId String?  @map("liquid_density_template_id") @db.Uuid
  densityGPerMlOverride   Decimal? @map("density_g_per_ml_override") @db.Decimal(15, 6)
  yieldPercent            Decimal? @map("yield_percent") @db.Decimal(5, 2)
  parentProductId         String?  @map("parent_product_id") @db.Uuid
  expectedYieldG          Decimal? @map("expected_yield_g") @db.Decimal(15, 6)
  targetMarketPrice       Decimal? @map("target_market_price") @db.Decimal(15, 4)
  imageUrl                String?  @map("image_url")
  isActive                Boolean  @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  tenant                  Tenant                   @relation(fields: [tenantId], references: [id])
  category                Category?                @relation(fields: [categoryId], references: [id])
  liquidDensityTemplate   LiquidDensityTemplate?   @relation(fields: [liquidDensityTemplateId], references: [id])
  parentProduct           Product?                 @relation("ProductPrepped", fields: [parentProductId], references: [id])
  childProducts           Product[]                @relation("ProductPrepped")
  productUnits            ProductUnit[]
  supplierProductMappings SupplierProductMapping[]
  stockMovements          StockMovement[]
  stockAdjustments        StockAdjustment[]
  stockCountItems         StockCountItem[]
  purchaseOrderItems      PurchaseOrderItem[]
  goodsReceiptItems       GoodsReceiptItem[]
  expenseItems            ExpenseItem[]
  wasteLogs               WasteLog[]
  parLevels               ParLevel[]
  stockTransferItems      StockTransferItem[]
  producedByRecipes       Recipe[]                 @relation("RecipeOutputProduct")
  usedInRecipes           RecipeIngredient[]
  salesConsumptionItems   SalesConsumptionItem[]

  /// NOTE: per-tenant sku uniqueness is a PARTIAL unique index (WHERE deleted_at
  /// IS NULL) in prisma/manual/product_sku_unique.sql — NOT a Prisma @@unique,
  /// which Prisma 5.22 can only express as a FULL index (Pitfall #23). See sku field.
  @@index([tenantId])
  @@map("product")
}

model ProductUnit {
  id               String  @id @default(uuid()) @db.Uuid
  productId        String  @map("product_id") @db.Uuid
  unitName         String  @map("unit_name")
  unitDimension    String  @map("unit_dimension")
  toBaseRatio      Decimal @map("to_base_ratio") @db.Decimal(15, 6)
  isBase           Boolean @default(false) @map("is_base")
  isDefaultBuyUnit Boolean @default(false) @map("is_default_buy_unit")
  source           String?
  displayOrder     Int?    @map("display_order")

  product                 Product                  @relation(fields: [productId], references: [id])
  supplierProductMappings SupplierProductMapping[]
  stockAdjustments        StockAdjustment[]
  stockCostDeclarations   StockCostDeclaration[]
  stockCountEntries       StockCountEntry[]
  purchaseOrderItems      PurchaseOrderItem[]
  goodsReceiptItems       GoodsReceiptItem[]
  expenseItems            ExpenseItem[]
  wasteLogs               WasteLog[]
  parLevels               ParLevel[]
  stockTransferItems      StockTransferItem[]
  recipeIngredients       RecipeIngredient[]

  @@unique([productId, unitName])
  @@index([productId])
  @@map("product_unit")
}

model SupplierProductMapping {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  supplierId       String    @map("supplier_id") @db.Uuid
  productId        String    @map("product_id") @db.Uuid
  branchId         String?   @map("branch_id") @db.Uuid // NULL = tenant default, NOT NULL = branch override
  supplierItemCode String?   @map("supplier_item_code")
  supplierItemName String?   @map("supplier_item_name")
  orderUnitId      String?   @map("order_unit_id") @db.Uuid
  currentUnitPrice Decimal?  @map("current_unit_price") @db.Decimal(15, 4)
  minOrderQty      Decimal?  @map("min_order_qty") @db.Decimal(15, 6)
  leadTimeDays     Int?      @map("lead_time_days")
  isPreferred      Boolean   @default(false) @map("is_preferred")
  effectiveFrom    DateTime  @map("effective_from") @db.Date
  effectiveTo      DateTime? @map("effective_to") @db.Date

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  tenant             Tenant              @relation(fields: [tenantId], references: [id])
  supplier           Supplier            @relation(fields: [supplierId], references: [id])
  product            Product             @relation(fields: [productId], references: [id])
  branch             Branch?             @relation(fields: [branchId], references: [id])
  orderUnit          ProductUnit?        @relation(fields: [orderUnitId], references: [id])
  /// Provenance only (ADR 0012 Q3) — a PO line snapshots the numbers it needs and
  /// never reads back through this link.
  purchaseOrderItems PurchaseOrderItem[]

  /// Composite uniqueness enforced by partial unique index in
  /// prisma/manual/supplier_product_mapping_unique.sql
  /// (tenant_id, supplier_id, product_id, branch_id, effective_from)
  /// WHERE deleted_at IS NULL + NULLS NOT DISTINCT.
  /// Not a Prisma @@unique because Prisma can't express partial indexes
  /// (WHERE / NULLS NOT DISTINCT). Closes Pitfall #22/#23 family (soft-deleted
  /// rows never block re-create) + the branch_id-NULL duplicate-default hole.
  @@index([tenantId])
  @@map("supplier_product_mapping")
}

// ============================================================
// TRANSACTIONAL (Sprint 2 — tenant-scoped, RLS required)
// ============================================================
// NOTE: 3 enums ข้างล่างเป็น Prisma enum ตัวแรกของโปรเจกต์ — Sprint 1 ใช้
// String + comment + z.enum ที่ validation layer (Product.type, primaryDimension).
// Part 10 เลือก Prisma enum เพราะ ledger ต้องการ DB-level guarantee
// (sign CHECK อ้าง enum value ตรง ๆ) ไม่ใช่แค่ app-level pattern — ADR 0011 Q2/Q3/Q10.

enum MovementType {
  PO_RECEIVE // +  IN  — written by a GR confirm (Part 13)
  /// -  OUT — written by a GR void (Part 13, ADR 0013 Q6). A confirmed receipt is
  /// never edited; its reversal line posts this compensating movement instead.
  /// Adding it required DROP + re-declare of stock_movement_sign_check — the
  /// standing item ADR 0011 Q2 recorded for every new movement type.
  PO_RECEIVE_REVERSAL
  ADJUST_GAIN // +  IN  — manual count correction up
  ADJUST_LOSS // -  OUT — manual count down / spoilage / waste

  /// Part 18 (ADR 0018 Q4). The FIRST movements that are neither a purchase nor
  /// an adjustment — nothing was bought, nothing was corrected, the goods changed
  /// shelf. Written ONLY by a stock_transfer.
  ///
  /// Why these are TYPES while waste settled for a source type (ADR 0017 Q1):
  ///   1. a transfer is not an adjustment, and one missed exception puts a truck
  ///      of pork into /cost's ส่วนต่าง/ปรับปรุง column;
  ///   2. FIFO NEEDS the distinction — ADR 0014 Q8 says a reversal cuts its OWN
  ///      layer, so TRANSFER_IN_REVERSAL must withdraw the layer this transfer
  ///      pushed rather than pop whatever sits at the front of B's queue.
  ///
  /// All four were added in ONE migration (20260818xxxxxx_part_18a_transfer_movement_types)
  /// and the sign CHECK re-declared in the next: the two-step dance is per
  /// MIGRATION, not per value.
  TRANSFER_OUT // -  OUT — leaves the sending branch
  TRANSFER_IN // +  IN  — arrives at the receiving branch, AT DISPATCH (Q1)
  TRANSFER_OUT_REVERSAL // +  IN  — a void gives the goods back to the sender
  TRANSFER_IN_REVERSAL // -  OUT — a void takes them off the receiver

  /// Part 22 (ADR 0021 Q12, ADR 0022). Stock that left to be cooked and eaten.
  /// Named for WHAT HAPPENED to the stock, not for what caused it, so a sale and
  /// (later) a staff meal share the type and are told apart by `source_type` —
  /// the shape ADJUST_LOSS already has, serving an adjustment, a count variance
  /// and a waste log. Deliberately NOT `RECIPE_CONSUME`: that phrasing claims the
  /// word a production movement will need.
  CONSUMPTION // -  OUT — written by a sales_consumption_item
  /// +  IN  — a re-import or a re-post gives the day back before posting it again.
  ///
  /// A type of its own rather than waste's ADJUST_GAIN answer, because it must
  /// give back the layers the original CONSUMPTION *took*, at the values it took
  /// them at (ADR 0014 Q8). Returning them at last-known cost would let importing
  /// the same file twice change what the stock is worth — 10 kg out at 180 and
  /// back at 220 is ฿400 of inventory conjured by an upload. Waste can afford
  /// that approximation; a month of sales cannot.
  CONSUMPTION_REVERSAL

  @@map("movement_type")
}

enum SourceType {
  /// -> goods_receipt_item (Part 13). ADR 0011 sketched a flat `goods_received_line`;
  /// ADR 0013 Q5 ships the 3-table spec shape instead. The enum VALUE is unchanged,
  /// so nothing in the ledger migrated — only this comment was stale.
  GR_LINE
  ADJUSTMENT // -> stock_adjustment (Part 10)
  /// -> stock_count_item (Part 15, ADR 0015 Q1). The movement TYPE stays
  /// ADJUST_GAIN/ADJUST_LOSS — a count variance is stock going up or down, not a
  /// new kind of event — so stock_movement_sign_check is untouched and Part 13's
  /// two-migration dance does not apply to this Part.
  STOCK_COUNT
  /// -> waste_log (Part 17, ADR 0017 Q1). Same pattern as STOCK_COUNT above: the
  /// movement TYPE stays ADJUST_LOSS (a void appends ADJUST_GAIN) — throwing food
  /// away is stock going out, not a new kind of event — so stock_movement_sign_check
  /// is untouched and Part 13's two-migration dance does not apply. What this value
  /// buys is /cost's split: ของเสีย means WASTE_LOG alone, and ส่วนต่าง/ปรับปรุง
  /// means STOCK_COUNT + ADJUSTMENT (Q4).
  WASTE_LOG
  /// -> stock_transfer_item (Part 18, ADR 0018 Q4). THREE values over ONE row id,
  /// which is what lets a single transfer line post more than one movement without
  /// touching stock_movement_source_unique: that index is a key on the PAIR
  /// (source_type, source_id), so (TRANSFER_OUT, item) and (TRANSFER_IN, item) are
  /// two different keys and each stays independently idempotent.
  TRANSFER_OUT // the sending branch's leg
  TRANSFER_IN // the receiving branch's leg — posted at dispatch, not at receipt
  /// What was dispatched but never arrived (Q2). NOT folded into the generic
  /// ADJUST_LOSS: that one means "stock left without a document", and here there IS
  /// a document — it names the driver who accepted the goods at the roadside.
  TRANSFER_SHORTAGE
  /// -> sales_consumption_item (Part 22, ADR 0022 Q1). The sales LINE cannot be
  /// the source: stock_movement_source_unique keys on the PAIR, and one line
  /// explodes into N raw products. Part 18's three-values-over-one-id trick does
  /// not stretch to an unbounded N, so the run's item is the source instead.
  ///
  /// Named for the sale rather than generically, because a staff meal (Part 23)
  /// brings its own document and its own value here — CONTEXT.md records that
  /// intent, and a generic `origin` column would hold one value for a whole Part.
  SALES_CONSUMPTION
  SYSTEM_INITIAL // reserved: onboarding initial stock (no writer in Part 10)

  @@map("source_type")
}

/// Why something was thrown away (ADR 0017 Q3). Each value names a DIFFERENT
/// person to talk to — the buyer, the storeman, the kitchen, the front of house —
/// which is the whole reason the reason is stored.
///
/// Two values are deliberately ABSENT:
///   PREP_LOSS  — yield_percent owns conversion loss (Decision #59). Yield covers
///                the knife; this log covers the fridge. A shop that lowers yield
///                to "cover" spoilage buries a fixable recurring loss inside a
///                constant, and Sprint 5's variance then looks healthy for the
///                wrong reason.
///   STAFF_MEAL — a staff meal is not waste. It is a sale that collected no money
///                and its cost belongs to labour/welfare; costing one needs
///                sales_transaction (Sprint 4) + recipe (Sprint 5).
enum WasteReason {
  SPOILED // went off, expired      -> the buyer
  DAMAGED // dropped, crushed       -> the storeman
  COOKING_ERROR // burnt, made wrong      -> the kitchen
  CUSTOMER_RETURN // sent back              -> front of house
  OTHER

  @@map("waste_reason")
}

enum AdjustmentReason {
  RECOUNT
  SPOILAGE
  DAMAGE
  OTHER

  @@map("adjustment_reason")
}

/// Append-only stock ledger. INSERT-only: ไม่มี updatedAt / deletedAt และไม่มี
/// update*Logic / delete*Logic (ADR 0011 Q7). การแก้ = compensating row ใหม่ (Q4).
/// Balance = SUM(qty) แบบ realtime (Q8) — qty เป็น base unit ของ product เสมอ (Q1).
model StockMovement {
  id         String       @id @default(uuid()) @db.Uuid
  tenantId   String       @map("tenant_id") @db.Uuid
  productId  String       @map("product_id") @db.Uuid
  /// NOT NULL (Q6) — stock อยู่ที่ใดที่หนึ่งเสมอ, SUM/GROUP BY ไม่ต้องจัดการ NULL
  branchId   String       @map("branch_id") @db.Uuid
  /// signed, base unit (Q1/Q2): + = เข้า, - = ออก
  qty        Decimal      @db.Decimal(15, 3)
  type       MovementType
  sourceType SourceType   @map("source_type")
  /// Polymorphic source — ไม่มี FK โดยเจตนา (Q3): ledger อยู่ยืนกว่า source ของมัน
  sourceId   String       @map("source_id") @db.Uuid
  /// business time — backdate ได้ (Q5)
  occurredAt DateTime     @default(now()) @map("occurred_at")
  /// audit time — immutable (Q5)
  createdAt  DateTime     @default(now()) @map("created_at")
  createdBy  String       @map("created_by")
  notes      String?

  tenant           Tenant                 @relation(fields: [tenantId], references: [id])
  product          Product                @relation(fields: [productId], references: [id])
  branch           Branch                 @relation(fields: [branchId], references: [id])
  createdByUser    User                   @relation(fields: [createdBy], references: [id])
  /// Part 14: ราคาที่มนุษย์ประกาศให้ movement นี้ (ADJUST_GAIN เท่านั้น, ADR 0014 Q6).
  /// ทิศนี้มี FK ได้ ต่างจาก source polymorphic ข้างบน — ledger ไม่เคยถูกลบ (Q7)
  costDeclarations StockCostDeclaration[]

  /// Sign CHECK (stock_movement_sign_check) เขียน INLINE ที่ท้าย migration.sql ของ Part 10
  /// เพราะ Prisma แสดง CHECK ไม่ได้ — precedent: product_density_xor ใน
  /// 20260529151309_part_7d_density_data_capture. ไม่ใช่ manual file: prisma/manual/
  /// สงวนไว้สำหรับสิ่งที่ migration.sql เขียนมือไม่ได้ (partial index / NULLS NOT
  /// DISTINCT / CREATE EXTENSION) — ดู ADR 0011 Q2 correction.
  /// FULL @@unique ปลอดภัยที่นี่ เพราะ ledger ไม่มี soft-delete → Pitfall #22/#23 ไม่ applied.
  @@unique([sourceType, sourceId], map: "stock_movement_source_unique")
  @@index([branchId, occurredAt], map: "stock_movement_branch_audit_idx")
  @@index([productId, branchId, occurredAt, createdAt], map: "stock_movement_chronological_idx")
  @@index([tenantId])
  @@map("stock_movement")
}

/// Manual adjustment source (Q10). 1 adjustment -> 1 StockMovement ใน transaction เดียวกัน
/// (Q4). เก็บ "หน่วย + จำนวนตามที่ผู้ใช้กรอก" ไว้เพื่อ audit (Q1) ส่วน signed base-unit qty
/// อยู่บน movement. reason ป้อน waste analytics ของ Sprint 2.
model StockAdjustment {
  id          String           @id @default(uuid()) @db.Uuid
  tenantId    String           @map("tenant_id") @db.Uuid
  productId   String           @map("product_id") @db.Uuid
  branchId    String           @map("branch_id") @db.Uuid
  /// ADJUST_GAIN | ADJUST_LOSS เท่านั้น — บังคับด้วย stock_adjustment_type_check
  /// (inline ท้าย migration.sql เดียวกัน, ADR 0011 Q10)
  type        MovementType
  reason      AdjustmentReason
  /// as-entered magnitude (Q1) — precision (15,3) ให้ตรงกับ movement.qty
  /// เพื่อไม่ให้ input_qty × toBaseRatio -> qty มี precision กระโดด
  inputQty    Decimal          @map("input_qty") @db.Decimal(15, 3)
  inputUnitId String           @map("input_unit_id") @db.Uuid
  /// business time — mirror ค่าเดียวกับ movement.occurredAt (Q5)
  occurredAt  DateTime         @map("occurred_at")
  createdAt   DateTime         @default(now()) @map("created_at")
  createdBy   String           @map("created_by")

  tenant        Tenant      @relation(fields: [tenantId], references: [id])
  product       Product     @relation(fields: [productId], references: [id])
  branch        Branch      @relation(fields: [branchId], references: [id])
  inputUnit     ProductUnit @relation(fields: [inputUnitId], references: [id])
  createdByUser User        @relation(fields: [createdBy], references: [id])

  @@index([tenantId])
  @@index([productId, branchId, occurredAt], map: "stock_adjustment_product_branch_idx")
  @@map("stock_adjustment")
}

// ============================================================
// COST (Sprint 2 Part 14 — ADR 0014)
// ============================================================
// Product cost is FIFO and is NOT STORED — it is computed by replaying
// stock_movement on every read (ADR 0014 Q2/Q4). There is no cost_layer table
// and no product_cost_history; the one table this Part adds exists solely to
// answer the question the documents cannot: what did stock cost that arrived
// WITHOUT a document (a recount gain — ADR 0011 Q10 gave stock_adjustment no
// price column, deliberately).
// ============================================================

/// A signed, dated statement of the cost of stock that arrived with no document
/// (ADR 0014 Q6). APPEND + SUPERSEDE, exactly like a supplier price series
/// (ADR 0009): a correction never overwrites — it opens a new row and closes the
/// previous one by stamping superseded_at. Overwriting in place would lose who
/// said what, and the feature exists precisely so a person can put their name to
/// a number.
///
/// ADJUST_GAIN movements ONLY. A received item's price belongs to its receipt,
/// and ADR 0013 Q6 already decided a receipt is voided rather than edited.
/// Enforced IN-APP inside the write transaction, not by a CHECK: the rule reads
/// a column on another table (stock_movement.type) and Postgres CHECKs cannot.
/// Same call as ADR 0012 Q2 made for the allocation-sum invariant, and the same
/// reason — a trigger would be the only DB-level option and it is not worth one.
///
/// A declaration applies at EVERY date, including ones already reported: it
/// corrects our knowledge of the past, not the events of the past (contrast a
/// Part 13 void, where the reversal is itself an event and occurs now).
model StockCostDeclaration {
  id         String @id @default(uuid()) @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  movementId String @map("movement_id") @db.Uuid

  /// AS ENTERED (mirrors stock_adjustment's input_qty/input_unit_id, ADR 0011 Q1):
  /// an owner declares "กระสอบละ 4,500", never "180.0000 ฿/kg". Keeping what was
  /// typed is what lets the UI show the number back in the words it was given.
  inputUnitCost Decimal @map("input_unit_cost") @db.Decimal(15, 4)
  inputUnitId   String  @map("input_unit_id") @db.Uuid

  /// DERIVED: inputUnitCost / inputUnit.toBaseRatio — cost per BASE unit, the
  /// denomination the ledger and the replay both work in. Scale 4 matches
  /// goods_receipt_item.unit_price_actual: this is a rate, not money. The layer's
  /// MONEY is computed at replay as round(unitCost x qty, 2) — ADR 0014 Q12 keeps
  /// money, never a rate, as the stored quantity of a layer.
  unitCost Decimal @map("unit_cost") @db.Decimal(15, 4)

  /// Why this number — "ของจากใบส่งของ 15 ส.ค. ที่ลืมคีย์". Free text on purpose:
  /// the reasons are the messy ones a fixed enum would flatten.
  note String?

  declaredAt   DateTime  @default(now()) @map("declared_at")
  declaredBy   String    @map("declared_by")
  /// null = the live declaration. Only one per movement may be null — enforced by
  /// the PARTIAL unique in prisma/manual/stock_cost_declaration_live_unique.sql
  /// (a FULL unique would be Pitfall #22/#23 again: superseded rows would block
  /// the correction that superseded them).
  supersededAt DateTime? @map("superseded_at")

  tenant         Tenant        @relation(fields: [tenantId], references: [id])
  movement       StockMovement @relation(fields: [movementId], references: [id])
  inputUnit      ProductUnit   @relation(fields: [inputUnitId], references: [id])
  declaredByUser User          @relation(fields: [declaredBy], references: [id])

  @@index([tenantId])
  @@index([movementId], map: "stock_cost_declaration_movement_idx")
  @@map("stock_cost_declaration")
}

// ============================================================
// STOCK COUNT (Sprint 3 Part 15 — ADR 0015)
// ============================================================
// The document that reconciles the Ledger with the shelf. DRAFT is a working
// sheet; CLOSED posts each line's variance as an ordinary ADJUST_GAIN/ADJUST_LOSS
// with source_type = STOCK_COUNT; VOIDED appends reversal lines (Q6).
//
// It stores NO money (Q4): a stored valuation would be falsified by the next cost
// declaration, exactly as product_cost_history would have been (ADR 0014). It DOES
// store qty_expected (Q3) — "what did the system say when you stood at the shelf"
// is a past observation, not a valuation.
// ============================================================

enum StockCountStatus {
  DRAFT
  CLOSED
  VOIDED

  @@map("stock_count_status")
}

/// One counting event at one branch. At most one DRAFT per branch — enforced by
/// the partial unique in prisma/manual/stock_count_open_unique.sql, because two
/// people counting the same shelf would otherwise both see the same expected
/// figure, both find the same shortage, and both post it (Q8).
model StockCount {
  id           String           @id @default(uuid()) @db.Uuid
  tenantId     String           @map("tenant_id") @db.Uuid
  branchId     String           @map("branch_id") @db.Uuid
  /// {BRANCH_CODE}-SC-#### per branch. PARTIAL unique (Pitfall #22/#23).
  scNumber     String           @map("sc_number")
  /// The document's HUMAN NAME ("the count of 20 Aug") — NOT an accounting date.
  /// A variance occurs at its own line's counted_at (Q8).
  countDate    DateTime         @map("count_date") @db.Date
  status       StockCountStatus @default(DRAFT)
  /// Q7: blind counting. UI-only — qty_expected is captured either way.
  showExpected Boolean          @default(true) @map("show_expected")
  notes        String?

  startedBy  String    @map("started_by")
  closedAt   DateTime? @map("closed_at")
  closedBy   String?   @map("closed_by")
  voidedAt   DateTime? @map("voided_at")
  voidedBy   String?   @map("voided_by")
  voidReason String?   @map("void_reason")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  tenant        Tenant           @relation(fields: [tenantId], references: [id])
  branch        Branch           @relation(fields: [branchId], references: [id])
  startedByUser User             @relation("ScStartedBy", fields: [startedBy], references: [id])
  closedByUser  User?            @relation("ScClosedBy", fields: [closedBy], references: [id])
  voidedByUser  User?            @relation("ScVoidedBy", fields: [voidedBy], references: [id])
  items         StockCountItem[]

  @@index([tenantId])
  @@index([branchId, countDate], map: "stock_count_branch_date_idx")
  @@map("stock_count")
}

/// One product, counted once. Its presence means the product WAS counted; a
/// counted 0 is a real observation and posts a loss down to zero (Q7).
///
/// This row is the ledger's SOURCE (Q1): source_type = STOCK_COUNT, source_id =
/// this id, which is what makes closing idempotent via the ledger's existing
/// UNIQUE(source_type, source_id).
model StockCountItem {
  id           String @id @default(uuid()) @db.Uuid
  tenantId     String @map("tenant_id") @db.Uuid
  stockCountId String @map("stock_count_id") @db.Uuid
  productId    String @map("product_id") @db.Uuid
  lineNo       Int    @map("line_no")

  /// Base-unit total of this line's entries. Q7: 0 is a real count, not an absence.
  qtyCounted  Decimal @map("qty_counted") @db.Decimal(15, 3)
  /// SNAPSHOT of the ledger balance taken when this line was saved (Q3), NOT at
  /// close and never recomputed. May be negative — ADR 0011 Q9 allows it.
  /// variance = qtyCounted - qtyExpected is computed at READ: it is arithmetic on
  /// two stored columns, not a third fact to keep in step.
  qtyExpected Decimal @map("qty_expected") @db.Decimal(15, 3)

  /// Business time of the variance movement (Q8) — a TRUE INSTANT, the moment
  /// someone stood at the shelf, not the close.
  countedAt     DateTime @map("counted_at")
  countedBy     String   @map("counted_by")
  /// Who actually walked and counted, when that is not the account holder — in a
  /// Thai SME the owner holds the only login and the staff do the counting (Q2).
  countedByName String?  @map("counted_by_name")
  notes         String?

  /// Set on a reversal line appended by a void (Q6). Such a line carries the
  /// ORIGINAL's numbers swapped, so its variance is the exact negation — which is
  /// also why qty_counted's non-negative CHECK exempts reversal rows.
  reversalOfItemId String? @map("reversal_of_item_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant        Tenant            @relation(fields: [tenantId], references: [id])
  stockCount    StockCount        @relation(fields: [stockCountId], references: [id])
  product       Product           @relation(fields: [productId], references: [id])
  countedByUser User              @relation(fields: [countedBy], references: [id])
  reversalOf    StockCountItem?   @relation("ScItemReversal", fields: [reversalOfItemId], references: [id])
  reversals     StockCountItem[]  @relation("ScItemReversal")
  entries       StockCountEntry[]

  @@index([tenantId])
  @@index([stockCountId], map: "stock_count_item_count_idx")
  @@map("stock_count_item")
}

/// What the user actually typed, per unit — "2 กระสอบ + 3 kg" is two rows.
/// The base-unit total lives on the item; these preserve the as-entered form for
/// audit, mirroring stock_adjustment's input_qty/input_unit_id (ADR 0011 Q1).
model StockCountEntry {
  id               String  @id @default(uuid()) @db.Uuid
  tenantId         String  @map("tenant_id") @db.Uuid
  stockCountItemId String  @map("stock_count_item_id") @db.Uuid
  productUnitId    String  @map("product_unit_id") @db.Uuid
  qtyInUnit        Decimal @map("qty_in_unit") @db.Decimal(15, 3)
  displayOrder     Int     @map("display_order")

  createdAt DateTime @default(now()) @map("created_at")

  tenant      Tenant         @relation(fields: [tenantId], references: [id])
  item        StockCountItem @relation(fields: [stockCountItemId], references: [id])
  productUnit ProductUnit    @relation(fields: [productUnitId], references: [id])

  @@index([tenantId])
  @@index([stockCountItemId], map: "stock_count_entry_item_idx")
  @@map("stock_count_entry")
}

// ============================================================
// PROCUREMENT (Sprint 2 Part 11 — ADR 0012)
// ============================================================
// A PO is a DOCUMENT THAT LEFT THE BUILDING: editable while DRAFT, frozen from
// SENT (Q4). Every number a line needs in order to still mean the same thing
// years later — unit price, unit name, to_base_ratio — is COPIED onto the line
// (Q3), never followed through a live FK.
//
// Deliberate divergences from master-spec §5.3, all recorded in ADR 0012:
//   - no purchase_request / from_pr_ids / source_pr_id (Q1 — PR is Sprint 3+)
//   - no wht_expected_amount / net_payment_expected (Q6 — WHT is Sprint 3)
//   - no H.2 deferrable trigger pair (Q2 — the allocation sum is app-enforced)
//   - tenant_id lives on ALL THREE tables, unlike the spec's child-table shape:
//     app-layer isolation (ADR 0004) works by filtering tenantId EXPLICITLY, and
//     a column that isn't there cannot be filtered. RLS is still inert.

enum PurchaseOrderStatus {
  DRAFT // editable
  SENT // frozen (Q4); sent_at set
  PARTIALLY_RECEIVED // written by Part 13 (GR) only
  RECEIVED // written by Part 13 (GR) only
  CANCELLED // terminal; a sent PO is never deleted (Q9)

  @@map("purchase_order_status")
}

/// Order header. VAT is snapshotted here at send time (Q6); WHT is not captured.
model PurchaseOrder {
  id         String              @id @default(uuid()) @db.Uuid
  tenantId   String              @map("tenant_id") @db.Uuid
  /// NOT NULL (spec §125) — an order is always placed by a branch, and its code
  /// is baked into po_number.
  branchId   String              @map("branch_id") @db.Uuid
  supplierId String              @map("supplier_id") @db.Uuid
  /// {BRANCH_CODE}-PO-#### (Q8), counter per branch, never resets. Uniqueness =
  /// PARTIAL unique in prisma/manual/purchase_order_number_unique.sql (a DRAFT can
  /// be soft-deleted — Q9 — so a FULL unique would be Pitfall #22/#23).
  poNumber   String              @map("po_number")
  status     PurchaseOrderStatus @default(DRAFT)

  expectedDeliveryDate DateTime? @map("expected_delivery_date") @db.Date

  /// --- VAT snapshot (Q6), frozen when the PO is sent ---
  /// Sum of line totals. 15,2 = THB satang; unit prices carry more precision.
  subtotalExclVat Decimal  @default(0) @map("subtotal_excl_vat") @db.Decimal(15, 2)
  /// null = this order carries no VAT (supplier not registered).
  vatRatePercent  Decimal? @map("vat_rate_percent") @db.Decimal(5, 2)
  vatAmount       Decimal  @default(0) @map("vat_amount") @db.Decimal(15, 2)
  totalAmount     Decimal  @default(0) @map("total_amount") @db.Decimal(15, 2)

  notes String?

  /// --- lifecycle audit (Q4/Q9) ---
  createdBy    String    @map("created_by")
  sentAt       DateTime? @map("sent_at")
  sentBy       String?   @map("sent_by")
  cancelledAt  DateTime? @map("cancelled_at")
  cancelledBy  String?   @map("cancelled_by")
  cancelReason String?   @map("cancel_reason")

  /// --- manual short-close (Part 13, ADR 0013 Q8) ---
  /// Set when someone declares a partially-received order finished. `status` goes
  /// to RECEIVED; these three record that it got there by decision rather than by
  /// delivery. Deliberately NOT a 5th status value — every existing filter, badge
  /// and label keeps working, and the reason is still on the record.
  closedShortAt     DateTime? @map("closed_short_at")
  closedShortBy     String?   @map("closed_short_by")
  closedShortReason String?   @map("closed_short_reason")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  /// DRAFT only (Q9) — a sent PO goes to CANCELLED and stays visible forever.
  deletedAt DateTime? @map("deleted_at")

  tenant            Tenant              @relation(fields: [tenantId], references: [id])
  branch            Branch              @relation(fields: [branchId], references: [id])
  supplier          Supplier            @relation(fields: [supplierId], references: [id])
  createdByUser     User                @relation("PoCreatedBy", fields: [createdBy], references: [id])
  sentByUser        User?               @relation("PoSentBy", fields: [sentBy], references: [id])
  cancelledByUser   User?               @relation("PoCancelledBy", fields: [cancelledBy], references: [id])
  closedShortByUser User?               @relation("PoClosedShortBy", fields: [closedShortBy], references: [id])
  items             PurchaseOrderItem[]
  goodsReceipts     GoodsReceipt[]

  @@index([tenantId])
  @@index([tenantId, status], map: "purchase_order_tenant_status_idx")
  @@index([branchId, status], map: "purchase_order_branch_status_idx")
  @@index([supplierId], map: "purchase_order_supplier_idx")
  @@map("purchase_order")
}

/// One ordered product. Everything under "snapshot" is frozen at send time (Q3)
/// and must never be re-derived from the live ProductUnit / mapping afterwards.
model PurchaseOrderItem {
  id              String @id @default(uuid()) @db.Uuid
  tenantId        String @map("tenant_id") @db.Uuid
  purchaseOrderId String @map("purchase_order_id") @db.Uuid
  productId       String @map("product_id") @db.Uuid
  /// Stable display order + the identity the edit form diffs rows by.
  lineNo          Int    @map("line_no")

  /// Quantity IN THE ORDERED UNIT (Q3) — what the supplier's invoice will say.
  qtyOrdered  Decimal @map("qty_ordered") @db.Decimal(15, 3)
  orderUnitId String  @map("order_unit_id") @db.Uuid

  /// --- snapshot (Q3) ---
  /// Copied from ProductUnit at send time so a later rename/ratio edit cannot
  /// change what this order meant. to_base_ratio mirrors ProductUnit's (15,6).
  orderUnitName String  @map("order_unit_name")
  toBaseRatio   Decimal @map("to_base_ratio") @db.Decimal(15, 6)
  /// excl VAT. 15,4 matches supplier_product_mapping.current_unit_price.
  unitPrice     Decimal @map("unit_price") @db.Decimal(15, 4)
  /// round(qtyOrdered × unitPrice, 2) — computed in the app, stored, never re-derived.
  lineTotal     Decimal @map("line_total") @db.Decimal(15, 2)

  /// Provenance ONLY (Q3). null = the price was typed by hand (Q5).
  supplierProductMappingId String? @map("supplier_product_mapping_id") @db.Uuid

  /// Maintained by Part 13 (GR) exclusively; created here so Part 13 needs no
  /// migration on a table it does not own.
  qtyReceived Decimal @default(0) @map("qty_received") @db.Decimal(15, 3)

  notes String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant                 Tenant                        @relation(fields: [tenantId], references: [id])
  purchaseOrder          PurchaseOrder                 @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product                Product                       @relation(fields: [productId], references: [id])
  orderUnit              ProductUnit                   @relation(fields: [orderUnitId], references: [id])
  supplierProductMapping SupplierProductMapping?       @relation(fields: [supplierProductMappingId], references: [id])
  allocations            PurchaseOrderItemAllocation[]
  goodsReceiptItems      GoodsReceiptItem[]

  @@unique([purchaseOrderId, lineNo], map: "purchase_order_item_line_unique")
  @@index([tenantId])
  @@index([purchaseOrderId], map: "purchase_order_item_parent_idx")
  @@index([productId], map: "purchase_order_item_product_idx")
  @@map("purchase_order_item")
}

/// Department attribution of a line's quantity (Q2). SUM(qtyAllocated) per line
/// MUST equal the line's qtyOrdered — enforced in the write transaction, NOT by
/// the H.2 trigger pair (see ADR 0012 Q2). While departments are off there is
/// exactly one row per line, pointing at "Main".
/// No deletedAt: allocations are replaced wholesale with their (DRAFT) parent line.
model PurchaseOrderItemAllocation {
  id                  String  @id @default(uuid()) @db.Uuid
  tenantId            String  @map("tenant_id") @db.Uuid
  purchaseOrderItemId String  @map("purchase_order_item_id") @db.Uuid
  departmentId        String  @map("department_id") @db.Uuid
  qtyAllocated        Decimal @map("qty_allocated") @db.Decimal(15, 3)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant            Tenant                       @relation(fields: [tenantId], references: [id])
  purchaseOrderItem PurchaseOrderItem            @relation(fields: [purchaseOrderItemId], references: [id], onDelete: Cascade)
  department        Department                   @relation(fields: [departmentId], references: [id])
  grItemAllocations GoodsReceiptItemAllocation[]

  @@unique([purchaseOrderItemId, departmentId], map: "po_item_allocation_dept_unique")
  @@index([tenantId])
  @@index([departmentId], map: "po_item_allocation_dept_idx")
  @@map("purchase_order_item_allocation")
}

// ============================================================
// GOODS RECEIPT (Sprint 2 Part 13 — ADR 0013)
// ============================================================
// A GR is THE MOMENT STOCK BECOMES REAL. DRAFT posts nothing; CONFIRMED writes
// one PO_RECEIVE movement per line into the append-only ledger, increments each
// PO line's qty_received, and recomputes the PO status (Q2). A confirmed receipt
// is never edited — VOID appends reversal lines with PO_RECEIVE_REVERSAL
// movements into the same document (Q6), because ADR 0011 forbids mutating a
// movement.
//
// Deliberate divergences from master-spec §5.3, all recorded in ADR 0013:
//   - purchase_order_id is NULLABLE — standalone receipts (Q1)
//   - no invoice_image_url (no object storage) and no auto_created_expense_id
//     (no expense module until Sprint 3) — the ADR 0012 Q6 rule against columns
//     that would be null forever
//   - no product_unit_id as a LIVE FK: the line snapshots unit name + ratio, the
//     same correction ADR 0012 Q3 made for the PO line
//   - variance_qty / variance_price are COMPUTED AT READ, never stored (Q7)
//   - tenant_id on all three tables (ADR 0004 filters it explicitly)

enum GoodsReceiptStatus {
  DRAFT // still counting; posts nothing
  CONFIRMED // ledger written; document locked
  VOIDED // reversed by compensating lines (Q6); never deleted

  @@map("goods_receipt_status")
}

/// One physical delivery. `receivedAt` is a TRUE INSTANT (Q4) — this is the first
/// writer of occurred_at values with a time component, which is why the ledger's
/// day bounds moved to Bangkok.
model GoodsReceipt {
  id              String  @id @default(uuid()) @db.Uuid
  tenantId        String  @map("tenant_id") @db.Uuid
  /// NOT NULL (spec §5.0) — denormalized from the PO when there is one.
  branchId        String  @map("branch_id") @db.Uuid
  /// NOT NULL even for a standalone receipt: you always know who delivered.
  supplierId      String  @map("supplier_id") @db.Uuid
  /// NULL = standalone receipt, bought without an order (Q1).
  purchaseOrderId String? @map("purchase_order_id") @db.Uuid

  /// {BRANCH_CODE}-GR-#### (mirrors po_number). Uniqueness = PARTIAL unique in
  /// prisma/manual/goods_receipt_number_unique.sql — a DRAFT can be soft-deleted,
  /// so a FULL unique would be Pitfall #22/#23.
  grNumber String             @map("gr_number")
  status   GoodsReceiptStatus @default(DRAFT)

  /// Supplier's invoice / delivery-note number, as text. No image, no OCR.
  invoiceNo String? @map("invoice_no")

  /// Part 16 (ADR 0016 Q2). VAT sits at the HEADER, following Decision #35's rule
  /// for expenses. Null rate = no VAT on this delivery.
  vatRatePercent Decimal? @map("vat_rate_percent") @db.Decimal(5, 2)
  vatAmount      Decimal  @default(0) @map("vat_amount") @db.Decimal(15, 2)
  /// SNAPSHOT of tenant.is_vat_registered AT RECEIPT TIME — never read live.
  /// A shop that crosses the 1.8M threshold in October must not have the whole
  /// year's stock silently re-valued: it did pay that VAT and nobody refunds it.
  /// Same rule ADR 0012 Q3 applied to to_base_ratio. When false, the VAT is part
  /// of what the stock cost and Part 14's replay adds it to the layer value.
  vatReclaimable Boolean  @default(false) @map("vat_reclaimable")
  /// Business time of the delivery — becomes every movement's occurred_at (Q4).
  receivedAt     DateTime @map("received_at")
  receivedBy     String   @map("received_by")
  notes          String?
  /// Set at confirm when any line over/under-delivers or its price differs from
  /// the PO (Q3/Q7). Drives review-by-exception, not a block.
  hasDiscrepancy Boolean  @default(false) @map("has_discrepancy")

  /// --- lifecycle audit (Q2/Q6) ---
  confirmedAt DateTime? @map("confirmed_at")
  confirmedBy String?   @map("confirmed_by")
  voidedAt    DateTime? @map("voided_at")
  voidedBy    String?   @map("voided_by")
  voidReason  String?   @map("void_reason")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  /// DRAFT only — a confirmed receipt is voided, never deleted.
  deletedAt DateTime? @map("deleted_at")

  tenant          Tenant             @relation(fields: [tenantId], references: [id])
  branch          Branch             @relation(fields: [branchId], references: [id])
  supplier        Supplier           @relation(fields: [supplierId], references: [id])
  purchaseOrder   PurchaseOrder?     @relation(fields: [purchaseOrderId], references: [id])
  /// At most one, enforced by the partial unique in prisma/manual/ (ADR 0016 Q3).
  expenses        Expense[]
  receivedByUser  User               @relation("GrReceivedBy", fields: [receivedBy], references: [id])
  confirmedByUser User?              @relation("GrConfirmedBy", fields: [confirmedBy], references: [id])
  voidedByUser    User?              @relation("GrVoidedBy", fields: [voidedBy], references: [id])
  items           GoodsReceiptItem[]

  @@index([tenantId])
  @@index([tenantId, status], map: "goods_receipt_tenant_status_idx")
  @@index([branchId, receivedAt], map: "goods_receipt_branch_received_idx")
  @@index([purchaseOrderId], map: "goods_receipt_po_idx")
  @@index([supplierId], map: "goods_receipt_supplier_idx")
  @@map("goods_receipt")
}

/// One received product. THE LEDGER'S SOURCE ROW: source_type = GR_LINE,
/// source_id = this id, one movement each (ADR 0011 Q4).
model GoodsReceiptItem {
  id                  String  @id @default(uuid()) @db.Uuid
  tenantId            String  @map("tenant_id") @db.Uuid
  goodsReceiptId      String  @map("goods_receipt_id") @db.Uuid
  /// NULL for a standalone receipt line (Q1), or for a line received against no
  /// particular order line.
  purchaseOrderItemId String? @map("purchase_order_item_id") @db.Uuid
  productId           String  @map("product_id") @db.Uuid
  lineNo              Int     @map("line_no")

  /// Quantity IN THE RECEIVED UNIT. Positive on a normal line, NEGATIVE on a
  /// reversal line — bound by goods_receipt_item_sign_check.
  qtyReceivedActual Decimal @map("qty_received_actual") @db.Decimal(15, 3)
  receivedUnitId    String  @map("received_unit_id") @db.Uuid

  /// --- snapshot ---
  /// For a PO-based line these are COPIED FROM THE PO LINE'S FROZEN VALUES
  /// (ADR 0012 Consequence 1) — never a fresh ProductUnit lookup, or the
  /// "sack was 25 kg, someone made it 30" bug comes straight back. A standalone
  /// line snapshots the live ProductUnit, because the receipt IS the originating
  /// record and there is no earlier document to disagree with.
  receivedUnitName String  @map("received_unit_name")
  toBaseRatio      Decimal @map("to_base_ratio") @db.Decimal(15, 6)
  /// Price actually invoiced, excl VAT (Q7). Defaults from the PO line, editable.
  unitPriceActual  Decimal @map("unit_price_actual") @db.Decimal(15, 4)
  /// round(qtyReceivedActual × unitPriceActual, 2). variance_qty / variance_price
  /// are NOT stored — they are pure functions of values already on this row.
  lineTotalActual  Decimal @map("line_total_actual") @db.Decimal(15, 2)

  /// Set on a reversal line (Q6): points at the line this one undoes, inside the
  /// SAME document, so the mistake and its correction read side by side.
  reversalOfItemId String? @map("reversal_of_item_id") @db.Uuid

  notes String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant            Tenant                       @relation(fields: [tenantId], references: [id])
  goodsReceipt      GoodsReceipt                 @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderItem PurchaseOrderItem?           @relation(fields: [purchaseOrderItemId], references: [id])
  product           Product                      @relation(fields: [productId], references: [id])
  receivedUnit      ProductUnit                  @relation(fields: [receivedUnitId], references: [id])
  reversalOfItem    GoodsReceiptItem?            @relation("GrLineReversal", fields: [reversalOfItemId], references: [id])
  reversedBy        GoodsReceiptItem[]           @relation("GrLineReversal")
  allocations       GoodsReceiptItemAllocation[]

  @@unique([goodsReceiptId, lineNo], map: "goods_receipt_item_line_unique")
  @@index([tenantId])
  @@index([goodsReceiptId], map: "goods_receipt_item_parent_idx")
  @@index([purchaseOrderItemId], map: "goods_receipt_item_po_item_idx")
  @@index([productId], map: "goods_receipt_item_product_idx")
  @@map("goods_receipt_item")
}

/// Department attribution of a received line (spec §5.3, Decision #45's naming).
/// SUM(qtyAllocatedActual) per line MUST equal the line's qtyReceivedActual —
/// enforced in the write transaction, NOT by H.2's trigger pair (ADR 0012 Q2).
/// Shortage pro-rates by ratio with a largest-remainder tiebreak (H.3); while
/// departments are off there is exactly one row per line, pointing at "Main".
model GoodsReceiptItemAllocation {
  id                   String  @id @default(uuid()) @db.Uuid
  tenantId             String  @map("tenant_id") @db.Uuid
  goodsReceiptItemId   String  @map("goods_receipt_item_id") @db.Uuid
  departmentId         String  @map("department_id") @db.Uuid
  /// Renamed from qty_received_actual to avoid the parent-table collision
  /// (Decision #45). Signed like its parent line — negative on a reversal.
  qtyAllocatedActual   Decimal @map("qty_allocated_actual") @db.Decimal(15, 3)
  /// Which PO allocation this satisfies, when there is one. Provenance only.
  sourcePoAllocationId String? @map("source_po_allocation_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant             Tenant                       @relation(fields: [tenantId], references: [id])
  goodsReceiptItem   GoodsReceiptItem             @relation(fields: [goodsReceiptItemId], references: [id], onDelete: Cascade)
  department         Department                   @relation(fields: [departmentId], references: [id])
  sourcePoAllocation PurchaseOrderItemAllocation? @relation(fields: [sourcePoAllocationId], references: [id])

  @@unique([goodsReceiptItemId, departmentId], map: "gr_item_allocation_dept_unique")
  @@index([tenantId])
  @@index([departmentId], map: "gr_item_allocation_dept_idx")
  @@map("goods_receipt_item_allocation")
}

// ============================================================
// EXPENSE (Sprint 3 Part 16 — ADR 0016)
// ============================================================
// Every baht that leaves the business, in ONE table: rent, utilities, wages,
// services — and materials, because confirming a Goods Receipt writes its own
// expense (Q3). That is what lets /cost read spend from a single place without
// double-counting a purchase against its receipt.
//
// NOT built, each for a stated reason (Q1/Q6/Q7): bill_image_url / slip_image_url
// (no object storage) · allocation_method (Q1 removed both shared strategies,
// leaving one possible value) · payment_status = PARTIAL (it describes an amount
// and there is no payments module to hold one).
//
// Voiding: a GR void SOFT-DELETES the expense it created. There is no separate
// void reason here — the receipt that caused it records who voided it and why,
// and duplicating that would let the two disagree.
// ============================================================

enum ExpenseSource {
  MANUAL
  /// Written by confirmGoodsReceiptLogic, in the same transaction (Q3).
  FROM_GOODS_RECEIPT

  @@map("expense_source")
}

enum ExpensePaymentStatus {
  UNPAID
  PAID

  @@map("expense_payment_status")
}

/// One bill. VAT sits at the HEADER (Decision #35), and WHT is computed on the
/// amount BEFORE VAT (ADR 0016 Q6 — master-spec §5.4's formula is wrong).
model Expense {
  id         String  @id @default(uuid()) @db.Uuid
  tenantId   String  @map("tenant_id") @db.Uuid
  branchId   String  @map("branch_id") @db.Uuid
  supplierId String? @map("supplier_id") @db.Uuid

  source     ExpenseSource @default(MANUAL)
  /// The receipt this expense was created from. PARTIAL unique, so a replayed
  /// confirm yields one expense — the mechanism used throughout Sprint 2.
  sourceGrId String?       @map("source_gr_id") @db.Uuid

  /// Set when this bill was confirmed from a recurring template (Q5). `period`
  /// is "YYYY-MM"; the pair is PARTIAL unique so confirming twice yields one.
  recurringExpenseId String? @map("recurring_expense_id") @db.Uuid
  period             String?

  billDate     DateTime @map("bill_date") @db.Date
  billNo       String?  @map("bill_no")
  vatInvoiceNo String?  @map("vat_invoice_no")

  subtotalExclVat     Decimal  @map("subtotal_excl_vat") @db.Decimal(15, 2)
  vatRatePercent      Decimal? @map("vat_rate_percent") @db.Decimal(5, 2)
  vatAmount           Decimal  @default(0) @map("vat_amount") @db.Decimal(15, 2)
  /// How the user TYPED it (Decision #36). A Thai shop's bill usually shows the
  /// total; a tax invoice shows both. Kept because it decides which way the
  /// maths ran, which a reader cannot recover from the results alone.
  isPriceVatInclusive Boolean  @default(true) @map("is_price_vat_inclusive")
  totalAmount         Decimal  @map("total_amount") @db.Decimal(15, 2)

  subjectToWht     Boolean  @default(false) @map("subject_to_wht")
  whtRatePercent   Decimal? @map("wht_rate_percent") @db.Decimal(5, 2)
  /// = subtotal_excl_vat × rate/100 — the PRE-VAT base (Q6). Withholding on the
  /// VAT-inclusive total over-withholds and breaks the 50 ทวิ reconciliation.
  whtAmount        Decimal? @map("wht_amount") @db.Decimal(15, 2)
  whtCertificateNo String?  @map("wht_certificate_no")
  /// = total_amount − wht_amount. What actually leaves the bank.
  netPaymentAmount Decimal  @map("net_payment_amount") @db.Decimal(15, 2)

  paymentMethod String?              @map("payment_method")
  paymentStatus ExpensePaymentStatus @default(UNPAID) @map("payment_status")
  paidAt        DateTime?            @map("paid_at")

  notes String?

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String    @map("created_by")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  tenant        Tenant            @relation(fields: [tenantId], references: [id])
  branch        Branch            @relation(fields: [branchId], references: [id])
  supplier      Supplier?         @relation(fields: [supplierId], references: [id])
  sourceGr      GoodsReceipt?     @relation(fields: [sourceGrId], references: [id])
  recurring     RecurringExpense? @relation(fields: [recurringExpenseId], references: [id])
  createdByUser User              @relation(fields: [createdBy], references: [id])
  items         ExpenseItem[]

  @@index([tenantId])
  @@index([branchId, billDate], map: "expense_branch_date_idx")
  @@map("expense")
}

/// One line of a bill. `category_id` is what puts it on the COGS or the OpEx side
/// of /cost (Q4) — the 3-tier tree has carried `account` since Sprint 1.
model ExpenseItem {
  id        String @id @default(uuid()) @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  expenseId String @map("expense_id") @db.Uuid
  lineNo    Int    @map("line_no")

  categoryId   String  @map("category_id") @db.Uuid
  /// null = shared / overhead (Decision #31). Always null while departments are
  /// off, and meaningful the day they are switched on — which is why it is built
  /// where `allocation_method` was not.
  departmentId String? @map("department_id") @db.Uuid

  /// Set when the line refers to a stocked product — always so on a line written
  /// from a Goods Receipt, usually null on rent or wages.
  productId     String?  @map("product_id") @db.Uuid
  productUnitId String?  @map("product_unit_id") @db.Uuid
  description   String
  qty           Decimal? @db.Decimal(15, 3)
  unitPrice     Decimal? @map("unit_price") @db.Decimal(15, 4)
  /// EXCLUDING VAT — the header carries the tax (Decision #35).
  totalPrice    Decimal  @map("total_price") @db.Decimal(15, 2)

  createdAt DateTime @default(now()) @map("created_at")

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  expense     Expense      @relation(fields: [expenseId], references: [id])
  category    Category     @relation(fields: [categoryId], references: [id])
  department  Department?  @relation(fields: [departmentId], references: [id])
  product     Product?     @relation(fields: [productId], references: [id])
  productUnit ProductUnit? @relation(fields: [productUnitId], references: [id])

  @@index([tenantId])
  @@index([expenseId], map: "expense_item_expense_idx")
  @@map("expense_item")
}

/// A template for something that repeats. It GENERATES NOTHING (Q5): what is due
/// is computed by asking which months have no expense carrying this id, and a
/// human confirms each one. `defaultAmount` is a starting point — an electricity
/// bill differs every month, which is the whole reason confirmation exists.
model RecurringExpense {
  id         String  @id @default(uuid()) @db.Uuid
  tenantId   String  @map("tenant_id") @db.Uuid
  branchId   String  @map("branch_id") @db.Uuid
  supplierId String? @map("supplier_id") @db.Uuid
  categoryId String  @map("category_id") @db.Uuid

  description   String
  defaultAmount Decimal @map("default_amount") @db.Decimal(15, 2)

  isPriceVatInclusive Boolean  @default(true) @map("is_price_vat_inclusive")
  vatRatePercent      Decimal? @map("vat_rate_percent") @db.Decimal(5, 2)
  subjectToWht        Boolean  @default(false) @map("subject_to_wht")
  whtRatePercent      Decimal? @map("wht_rate_percent") @db.Decimal(5, 2)

  /// Capped at 28 by CHECK: a "due on the 30th" template would skip February,
  /// and a template that silently skips a month is worse than one that lands early.
  dayOfMonth  Int     @map("day_of_month")
  /// "YYYY-MM" inclusive bounds. A period label, not a timestamp — no timezone
  /// question to get wrong (Decision #60).
  startPeriod String  @map("start_period")
  endPeriod   String? @map("end_period")
  isActive    Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  branch   Branch    @relation(fields: [branchId], references: [id])
  supplier Supplier? @relation(fields: [supplierId], references: [id])
  category Category  @relation(fields: [categoryId], references: [id])
  expenses Expense[]

  @@index([tenantId])
  @@map("recurring_expense")
}

// ============================================================
// WASTE + PAR LEVEL (Sprint 3 Part 17 — ADR 0017)
// ============================================================

/// One row = ONE thing thrown away, posted to the ledger immediately (Q2).
/// No DRAFT, no shift sheet: recording waste has to fit in the thirty seconds
/// between the bin and the next order, and an unposted draft would leave the
/// ledger claiming stock that is already in the bin.
///
/// This row IS the ledger's source (Q1): source_type = WASTE_LOG, source_id =
/// this id, which is what makes posting idempotent through the ledger's existing
/// UNIQUE(source_type, source_id) — the same trick stock_count_item gets for free.
/// The id is therefore the client's SUBMIT KEY, exactly as stock_adjustment uses
/// it (src/server/stock-movement.ts createStockAdjustmentLogic).
///
/// NO base-unit qty column, on purpose: a waste movement's qty IS this quantity
/// negated, so storing it here would be a second copy of a number the ledger
/// already holds exactly — and no CHECK can keep two copies honest. Mirrors
/// stock_adjustment (input_qty + input_unit_id here, signed base qty on the
/// movement). This is unlike stock_count_item, which stores qty_counted because
/// the ledger there holds only the VARIANCE.
model WasteLog {
  id          String      @id @default(uuid()) @db.Uuid
  tenantId    String      @map("tenant_id") @db.Uuid
  productId   String      @map("product_id") @db.Uuid
  branchId    String      @map("branch_id") @db.Uuid
  reason      WasteReason
  /// as-entered magnitude, always POSITIVE (waste_log_input_qty_check) — direction
  /// comes from reversal_of_id, not from a sign. Precision (15,3) matches
  /// movement.qty so input_qty × toBaseRatio -> qty has no precision jump.
  inputQty    Decimal     @map("input_qty") @db.Decimal(15, 3)
  inputUnitId String      @map("input_unit_id") @db.Uuid
  /// business time — backdate ได้ (ADR 0011 Q5); mirrors movement.occurredAt
  occurredAt  DateTime    @map("occurred_at")

  /// The login that recorded it, plus who actually threw it away (Q7, ADR 0015 Q2):
  /// in a Thai SME the owner holds the only account and the staff do the work, so
  /// the FK alone would record "the owner threw everything away" — tidy and false.
  wastedBy     String  @map("wasted_by")
  wastedByName String? @map("wasted_by_name")
  notes        String?

  /// A void APPENDS this row against the original (Q2) and posts the compensating
  /// ADJUST_GAIN. It cannot be an in-place edit: the ledger is append-only (ADR 0011
  /// Q7) and the compensating movement needs a source_id of its own to satisfy
  /// UNIQUE(source_type, source_id). Mirrors StockCountItem.reversalOfItemId.
  /// At most ONE reversal per row — partial unique in
  /// prisma/manual/waste_and_par_unique.sql, or a double-submitted void would
  /// credit the stock back twice.
  reversalOfId String? @map("reversal_of_id") @db.Uuid

  /// Stamped on the ORIGINAL when it is voided. No deleted_at anywhere on this
  /// table: correcting waste is a void, never a delete — "this was keyed wrong"
  /// is itself worth being able to see.
  voidedAt   DateTime? @map("voided_at")
  voidedBy   String?   @map("voided_by")
  voidReason String?   @map("void_reason")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant       Tenant      @relation(fields: [tenantId], references: [id])
  product      Product     @relation(fields: [productId], references: [id])
  branch       Branch      @relation(fields: [branchId], references: [id])
  inputUnit    ProductUnit @relation(fields: [inputUnitId], references: [id])
  wastedByUser User        @relation("WasteWastedBy", fields: [wastedBy], references: [id])
  voidedByUser User?       @relation("WasteVoidedBy", fields: [voidedBy], references: [id])
  reversalOf   WasteLog?   @relation("WasteReversal", fields: [reversalOfId], references: [id])
  reversals    WasteLog[]  @relation("WasteReversal")

  @@index([tenantId])
  @@index([branchId, occurredAt], map: "waste_log_branch_occurred_idx")
  @@index([productId, branchId, occurredAt], map: "waste_log_product_branch_idx")
  @@map("waste_log")
}

/// "How much of this should be on the shelf at this branch" (Q5). Scoped to
/// product × branch: a branch that is out of pork is out of pork whatever the
/// business holds elsewhere (ADR 0014 Q9b).
///
/// It SUGGESTS NOTHING and ORDERS NOTHING. Auto-drafting a purchase order needs a
/// preferred supplier, a lead time and someone with authority to approve it; ADR
/// 0012 Q1 already dropped the purchase-request layer for the last of those.
///
/// One live par per (product, branch) — PARTIAL unique in
/// prisma/manual/waste_and_par_unique.sql (Pitfall #22/#23), so a removed par does
/// not block a new one.
model ParLevel {
  id        String @id @default(uuid()) @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  productId String @map("product_id") @db.Uuid
  branchId  String @map("branch_id") @db.Uuid

  /// BASE unit — the stored truth, compared against the ledger balance.
  parQty      Decimal @map("par_qty") @db.Decimal(15, 3)
  /// As entered ("2 กระสอบ"), kept so the form re-opens in the unit the user chose.
  /// Both halves live here because — unlike waste — there is no ledger row holding
  /// the base figure.
  inputQty    Decimal @map("input_qty") @db.Decimal(15, 3)
  inputUnitId String  @map("input_unit_id") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  /// Soft delete: removing a par deletes the row. A par of 0 is refused by
  /// par_level_qty_check — "no par" is the absence of a row, not a zero.
  deletedAt DateTime? @map("deleted_at")

  tenant    Tenant      @relation(fields: [tenantId], references: [id])
  product   Product     @relation(fields: [productId], references: [id])
  branch    Branch      @relation(fields: [branchId], references: [id])
  inputUnit ProductUnit @relation(fields: [inputUnitId], references: [id])

  @@index([tenantId])
  @@index([branchId], map: "par_level_branch_idx")
  @@map("par_level")
}

// ============================================================
// Sprint 3 Part 18 — Inter-branch transfer (ADR 0018)
// ============================================================
// The first document whose two halves belong to two different branches and two
// different people, and the first ledger entry that is neither a purchase nor an
// adjustment: nothing was bought, nothing was corrected, the goods changed shelf.
//
// NOT built, each for a stated reason:
//   - no photo_url for the handover evidence (Q3) — there is no object storage,
//     and the vendor decides whether the column holds a URL, a bucket key or a
//     signed path. Captured as Feature 5 in docs/pending-features-v1.5.md, which
//     is the THIRD Part to want a photo (see :1008 and :1190 above).
//   - no deleted_at anywhere — a transfer is VOIDED, never deleted, exactly like
//     waste_log. "This was keyed wrong" is itself worth being able to see.
//   - no in-transit branch / balance. In transit is a state of the DOCUMENT; the
//     goods are already counted at the destination (Q1).
// ============================================================

/// Where a frozen cost figure came from, and therefore how far to trust it
/// (ADR 0014 Q10). Stored here — and nowhere else in the database — because a
/// transfer freezes the money itself (ADR 0018 Q5), and money with no provenance
/// makes "0.00" unreadable: a shop that never keyed a purchase would look like a
/// shop that got the goods free.
///
/// COST_SOURCE_VALUES in src/lib/validations/stock-cost.ts is what every cost
/// READ returns and what the UI labels; this enum is the same vocabulary made
/// storable. An L2 test asserts the two lists agree, so neither can drift.
enum CostSource {
  FRONT_LAYER // the layer the goods actually came out of
  DECLARED // a human declared this layer's price (stock_cost_declaration)
  LAST_KNOWN // nothing on hand — valued at the most recent purchase
  UNPRICED // this product has never been bought into the system: the money is 0

  @@map("cost_source")
}

enum StockTransferStatus {
  /// Dispatched. **BOTH ledger legs are already posted** (ADR 0018 Q1). This value
  /// does NOT mean the stock is missing from the receiving branch — it means nobody
  /// there has confirmed it yet. Anything that gates a BALANCE on this status has
  /// misread it.
  SENT
  /// Someone at the receiving branch counted the goods. Posts at most the shortfall.
  RECEIVED
  /// The document should never have existed (Q6). NOT the same as "the goods came
  /// back" — that is a new transfer in the opposite direction.
  VOIDED

  @@map("stock_transfer_status")
}

/// One dispatch from one branch to another. `id` IS the form's `submit_key`
/// (Part 13.5's pattern): a replayed submit collides on the primary key, so a
/// double-tap cannot move the same goods twice.
model StockTransfer {
  id           String              @id @default(uuid()) @db.Uuid
  tenantId     String              @map("tenant_id") @db.Uuid
  fromBranchId String              @map("from_branch_id") @db.Uuid
  toBranchId   String              @map("to_branch_id") @db.Uuid
  /// {FROM_BRANCH_CODE}-TF-#### — the SENDING branch numbers the document, because
  /// that is who issues it. Generated under withCounterLock (Part 13.5); the FULL
  /// unique below is the backstop. Full, not partial: there is no soft delete here,
  /// so Pitfall #22/#23 cannot apply.
  tfNumber     String              @map("tf_number")
  status       StockTransferStatus @default(SENT)

  /// business time of BOTH legs — backdatable within 90d (ADR 0011 Q5)
  dispatchedAt     DateTime @map("dispatched_at")
  dispatchedBy     String   @map("dispatched_by")
  /// Who actually handed the goods over, when that is not the account holder —
  /// ADR 0015 Q2's pattern, applied to the first of this document's three people.
  dispatchedByName String?  @map("dispatched_by_name")

  /// --- the driver (Q3) ---
  /// TWO KINDS OF DRIVER, and only one will ever have a login. A company driver is
  /// an employee and a tenant member, so `driver_user_id` waits for the day user
  /// management ships — it fills in with NO migration. A hired outside driver never
  /// gets one, and their evidence is a photo, which needs a Part that does not
  /// exist. Until then `driver_name` is the authority and the FK is a bonus, so
  /// every read must treat it that way.
  driverUserId      String?   @map("driver_user_id")
  driverName        String?   @map("driver_name")
  /// Set when the driver agreed the count at the roadside. A confirmation attached
  /// to nobody is not a confirmation — stock_transfer_driver_confirmed_check.
  driverConfirmedAt DateTime? @map("driver_confirmed_at")

  /// --- receipt (Q2) --- posts nothing by itself; it posts the SHORTFALL, if any.
  receivedAt     DateTime? @map("received_at")
  receivedBy     String?   @map("received_by")
  receivedByName String?   @map("received_by_name")

  /// --- void (Q6) --- allowed even after receipt, because that is usually when a
  /// wrong-product / wrong-branch entry surfaces.
  voidedAt   DateTime? @map("voided_at")
  voidedBy   String?   @map("voided_by")
  voidReason String?   @map("void_reason")

  notes String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant           Tenant              @relation(fields: [tenantId], references: [id])
  fromBranch       Branch              @relation("TransferFrom", fields: [fromBranchId], references: [id])
  toBranch         Branch              @relation("TransferTo", fields: [toBranchId], references: [id])
  dispatchedByUser User                @relation("TfDispatchedBy", fields: [dispatchedBy], references: [id])
  driverUser       User?               @relation("TfDriver", fields: [driverUserId], references: [id])
  receivedByUser   User?               @relation("TfReceivedBy", fields: [receivedBy], references: [id])
  voidedByUser     User?               @relation("TfVoidedBy", fields: [voidedBy], references: [id])
  items            StockTransferItem[]

  @@unique([tenantId, tfNumber], map: "stock_transfer_number_unique")
  @@index([tenantId])
  @@index([fromBranchId, dispatchedAt], map: "stock_transfer_from_dispatched_idx")
  /// The "รอรับ" box on /stock and the dashboard of the DESTINATION branch (Q8) —
  /// the one query in this Part that no earlier Part's indexes could serve, because
  /// no earlier document was somebody else's work in another branch.
  @@index([toBranchId, status], map: "stock_transfer_to_status_idx")
  @@map("stock_transfer")
}

/// One product on one transfer. Posts up to THREE movements from this single row —
/// (TRANSFER_OUT, id), (TRANSFER_IN, id) and, when goods go missing on the way,
/// (TRANSFER_SHORTAGE, id). All three are distinct keys under
/// stock_movement_source_unique, which is a unique on the PAIR.
model StockTransferItem {
  id              String @id @default(uuid()) @db.Uuid
  tenantId        String @map("tenant_id") @db.Uuid
  stockTransferId String @map("stock_transfer_id") @db.Uuid
  productId       String @map("product_id") @db.Uuid
  lineNo          Int    @map("line_no")

  /// Quantity IN THE ENTERED UNIT. Positive on a normal line, NEGATIVE on a
  /// reversal line — stock_transfer_item_sign_check. Mirrors goods_receipt_item.
  qtySent     Decimal  @map("qty_sent") @db.Decimal(15, 3)
  /// NULL until a human at the far end counts (Q2). Deliberately nullable rather
  /// than defaulting to qty_sent: the absence of a number is not a zero and it is
  /// not agreement either — the same reasoning that made par_qty refuse 0. A
  /// default would let an unconfirmed transfer claim it arrived in full.
  /// Receiving MORE than was dispatched is refused
  /// (stock_transfer_item_received_le_sent_check): a surplus has no posting, no
  /// cost and no meaning as a transfer — one of the two counts is simply wrong,
  /// and that is a conversation, not a ledger entry.
  qtyReceived Decimal? @map("qty_received") @db.Decimal(15, 3)

  /// --- snapshot (ADR 0012 Q3's frozen-ratio rule) ---
  /// The unit is captured as it was AT DISPATCH. A live ProductUnit lookup brings
  /// back the "sack was 25 kg, someone made it 30" bug — here it would resize goods
  /// that are already on a truck.
  inputUnitId   String  @map("input_unit_id") @db.Uuid
  inputUnitName String  @map("input_unit_name")
  toBaseRatio   Decimal @map("to_base_ratio") @db.Decimal(15, 6)

  /// --- the frozen cost (Q5) ---
  /// The MONEY that left the sending branch with these units, at 2 dp — never a
  /// per-unit rate (ADR 0014 Q12: 1,000 ÷ 90 × 90 loses a fraction of a satang,
  /// per layer, forever). This is the one number in the system that ADR 0014's
  /// "cost is stored nowhere" does not cover, and the exception is deliberate:
  /// computing it live would turn one branch's cost read into a traversal of the
  /// whole transfer graph.
  costTotal  Decimal    @map("cost_total") @db.Decimal(15, 2)
  /// How well the sending branch knew that number. Without it, 0.00 cannot be told
  /// apart from free goods.
  costSource CostSource @map("cost_source")

  /// Set on a reversal line appended by a void (Q6), inside the SAME document, so
  /// the mistake and its correction read side by side. The line carries the
  /// original's numbers negated. At most ONE reversal per line — partial unique in
  /// prisma/manual/stock_transfer_unique.sql, or a double-submitted void moves the
  /// goods back twice.
  reversalOfItemId String? @map("reversal_of_item_id") @db.Uuid

  notes String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant         Tenant              @relation(fields: [tenantId], references: [id])
  stockTransfer  StockTransfer       @relation(fields: [stockTransferId], references: [id], onDelete: Cascade)
  product        Product             @relation(fields: [productId], references: [id])
  inputUnit      ProductUnit         @relation(fields: [inputUnitId], references: [id])
  reversalOfItem StockTransferItem?  @relation("TfLineReversal", fields: [reversalOfItemId], references: [id])
  reversedBy     StockTransferItem[] @relation("TfLineReversal")

  @@unique([stockTransferId, lineNo], map: "stock_transfer_item_line_unique")
  @@index([tenantId])
  @@index([stockTransferId], map: "stock_transfer_item_parent_idx")
  @@index([productId], map: "stock_transfer_item_product_idx")
  @@map("stock_transfer_item")
}

// ============================================================
// Sprint 4 Part 19 — POS sales import (ADR 0019)
// ============================================================
// Sales are a MIRROR OF THE POS, not an event in the warehouse. Nothing in this
// section writes stock_movement: turning "12 plates" into "1.2 kg of pork" needs
// `recipe`, which is Sprint 5 (ADR 0019 Q13). `MovementType.CONSUMPTION` is
// therefore NOT added here — ADR 0018 established the two-migration sign-CHECK
// cost is per MIGRATION, not per value, so reserving it early saves nothing, and
// `SourceType.SYSTEM_INITIAL` (reserved in Part 10, still unwritten eight Parts
// later) is the standing warning against enum values with no writer.
// ============================================================

/// Which POS the branch runs. Only ever used to seed a sensible import profile
/// and to label the screen — no behaviour branches on it, because behaviour
/// belongs to the PROFILE (ADR 0019 Q11). A POS nobody has written a profile for
/// still works: pick CUSTOM and map the columns by hand.
enum PosType {
  FOODSTORY
  WONGNAI
  OCHA
  STOREHUB
  LOYVERSE
  CUSTOM

  @@map("pos_type")
}

/// What one row of the file means. The single most important thing a profile
/// declares, because it decides which columns may legitimately be absent (Q4).
enum SalesFileKind {
  /// One row per menu per BILL. Carries a bill id and usually a time, so bill
  /// counts, average spend per bill and peak-hour views become available.
  BILL_DETAIL
  /// One row per menu per DAY, already summed by the POS. No bill, no time.
  /// Legal and common — most Thai POS back offices export this shape, and it is
  /// enough for revenue, for the category views, and for Sprint 5's consumption.
  DAILY_SUMMARY

  @@map("sales_file_kind")
}

/// How the file reached Mise. `EMAIL` is deliberately ABSENT until Part 20
/// writes it — see the section header on enum values with no writer.
enum SalesImportSource {
  MANUAL_UPLOAD

  @@map("sales_import_source")
}

enum SalesImportBatchStatus {
  /// Uploaded, not yet parsed.
  PENDING
  /// Parsed and staged. The user is looking at what WOULD happen — new menus,
  /// new categories, which days get replaced (Section D.4: never auto-create
  /// without showing it first).
  PREVIEW
  /// Written. Its days now point at this batch in `sales_day`.
  COMMITTED
  /// Refused, with a Thai reason per row in `error_log`. A file that cannot be
  /// read is NEVER partially imported (Q14) — half a day of sales is worse than
  /// none, because nothing on screen looks wrong.
  FAILED
  /// The user backed out at preview.
  CANCELLED

  @@map("sales_import_batch_status")
}

/// Where the sale happened. Optional everywhere: read from the file when a
/// column exists, otherwise inherited from the profile (a file exported from a
/// delivery platform's own back office is entirely one channel).
///
/// Why the delivery values are named individually rather than one DELIVERY: the
/// platforms charge different commission (25-32%) and a shop needs to know which
/// one ate the margin, not merely that something did (Q12).
enum SalesChannel {
  DINE_IN
  TAKEAWAY
  DELIVERY_GRAB
  DELIVERY_LINEMAN
  DELIVERY_FOODPANDA
  DELIVERY_ROBINHOOD
  DELIVERY_SHOPEEFOOD
  ONLINE_ORDER
  OTHER

  @@map("sales_channel")
}

enum MenuSource {
  /// Came from a POS file. Identity is `pos_menu_id`, NOT the name (Q7).
  POS
  /// Typed into Mise. Needed by shops with no POS integration at all.
  MISE

  @@map("menu_source")
}

/// How to decode the bytes. TIS-620 is not an edge case — the real Thai POS
/// export read during the grill was TIS-620, and reading it as UTF-8 produces
/// mojibake menu names that then create a full set of duplicate stub menus.
enum FileEncoding {
  UTF8
  TIS620

  @@map("file_encoding")
}

/// One POS at one branch. Deliberately holds NO credentials (Q2): no Thai SME
/// can enable a POS API for itself, so an encrypted-credentials column would be
/// a security surface with no writer — the same reasoning that kept `photo_url`
/// out of Part 18.
model PosIntegration {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  branchId String  @map("branch_id") @db.Uuid
  posType  PosType @map("pos_type")
  name     String
  isActive Boolean @default(true) @map("is_active")

  /// Last COMMITTED import, not last upload — a failed file is not a sync.
  lastImportAt DateTime? @map("last_import_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  tenant   Tenant               @relation(fields: [tenantId], references: [id])
  branch   Branch               @relation(fields: [branchId], references: [id])
  profiles SalesImportProfile[]
  batches  SalesImportBatch[]
  menus    Menu[]
  aliases  MenuAlias[]

  @@index([tenantId])
  @@index([branchId], map: "pos_integration_branch_idx")
  @@map("pos_integration")
}

/// How to read one SHAPE of file. This is the answer to "every POS formats its
/// columns differently" (Q11), and the reason vendor support is data rather than
/// code: a seeded profile IS the FoodStory adapter.
///
/// One branch can hold several — the POS's own export and a delivery platform's
/// export are two different shapes of the same branch's sales.
model SalesImportProfile {
  id               String @id @default(uuid()) @db.Uuid
  tenantId         String @map("tenant_id") @db.Uuid
  posIntegrationId String @map("pos_integration_id") @db.Uuid
  name             String

  fileKind SalesFileKind @map("file_kind")
  encoding FileEncoding  @default(UTF8)

  /// e.g. "dd/MM/yyyy". Paired with the flag below rather than encoded in the
  /// pattern, because a Buddhist-era year is not a format difference — it is 543
  /// added to the number, and the previous system handled it with `year > 2100`.
  dateFormat     String  @map("date_format")
  isBuddhistYear Boolean @default(false) @map("is_buddhist_year")

  /// Which column is what: `{ "businessDate": 1, "menuName": 6, "qty": 11 }`.
  /// Data, not code — the previous system hard-coded these indexes, so a POS
  /// update that inserted a column would have shifted every figure while they
  /// all still looked plausible.
  columnMap Json @map("column_map") @db.JsonB

  /// Hash of the header row this profile was built against. A file that still
  /// matches imports without asking anything; one that does not is STOPPED and
  /// the user is asked — never read anyway (Q11).
  headerSignature String @map("header_signature")

  /// Properties of the REPORT, not of the data. Guessing either wrong is a silent
  /// 7% (or 10%) error on every row, so both are required, with no default that
  /// could quietly be wrong (Q10, rule P10).
  amountsIncludeVat           Boolean @map("amounts_include_vat")
  amountsIncludeServiceCharge Boolean @map("amounts_include_service_charge")

  /// Used when the file carries no channel column at all.
  defaultChannel SalesChannel? @map("default_channel")

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  tenant         Tenant             @relation(fields: [tenantId], references: [id])
  posIntegration PosIntegration     @relation(fields: [posIntegrationId], references: [id])
  batches        SalesImportBatch[]

  @@index([tenantId])
  @@index([posIntegrationId], map: "sales_import_profile_integration_idx")
  @@map("sales_import_profile")
}

/// One upload. Kept whatever the outcome, because "why is Tuesday missing" is
/// answered here — the previous system's only record of a failure was a status
/// cell that a human overwrote.
///
/// `id` IS the form's submit key (Part 13.5's pattern): a replayed submit
/// collides on the primary key rather than importing the same file twice.
model SalesImportBatch {
  id               String @id @default(uuid()) @db.Uuid
  tenantId         String @map("tenant_id") @db.Uuid
  /// Denormalised from the integration: a batch belongs to exactly one branch and
  /// every read filters by branch first. NOT taken from the file — the previous
  /// system let a human type the branch beside the filename, and a typo moved a
  /// whole day of sales to the wrong shop in silence (rule P12).
  branchId         String @map("branch_id") @db.Uuid
  posIntegrationId String @map("pos_integration_id") @db.Uuid
  profileId        String @map("profile_id") @db.Uuid

  source   SalesImportSource      @default(MANUAL_UPLOAD)
  status   SalesImportBatchStatus @default(PENDING)
  fileName String                 @map("file_name")
  /// Rows accepted into `sales_line`, set at commit — 0 while staged.
  rowCount Int                    @default(0) @map("row_count")

  /// The span of sales days this file turned out to contain, read from the ROWS
  /// (rule P2 — every row carries its own date), never asserted by the uploader.
  coveredFrom DateTime? @map("covered_from") @db.Date
  coveredTo   DateTime? @map("covered_to") @db.Date

  /// Per-row Thai messages. The one idea worth keeping from the previous system:
  /// a failure the shop can read without asking anyone.
  errorLog Json? @map("error_log") @db.JsonB

  uploadedBy  String    @map("uploaded_by")
  uploadedAt  DateTime  @default(now()) @map("uploaded_at")
  committedAt DateTime? @map("committed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant         Tenant             @relation(fields: [tenantId], references: [id])
  branch         Branch             @relation(fields: [branchId], references: [id])
  posIntegration PosIntegration     @relation(fields: [posIntegrationId], references: [id])
  profile        SalesImportProfile @relation(fields: [profileId], references: [id])
  uploadedByUser User               @relation("SalesImportUploadedBy", fields: [uploadedBy], references: [id])

  salesLines      SalesLine[] @relation("SalesLineBatch")
  currentForDays  SalesDay[]  @relation("SalesDayCurrentBatch")
  linesSuperseded SalesLine[] @relation("SalesLineSupersededBy")

  @@index([tenantId])
  @@index([branchId, uploadedAt], map: "sales_import_batch_branch_uploaded_idx")
  @@map("sales_import_batch")
}

/// One branch, one SALES DAY. This table exists to make rule P3 a database fact
/// rather than a promise in application code: `UNIQUE(branch_id, business_date)`
/// means a day has exactly one current source, so re-importing REPLACES rather
/// than doubles (Q5).
///
/// The previous system had no equivalent, gave every row a fresh UUID, and
/// guarded re-imports with a status cell reading "success" — so nothing in the
/// data could ever tell that a day had been imported twice.
///
/// Part 20's daily pulse lands here too: the pulse is one number for exactly
/// this grain, and when detail arrives it wins — but a disagreement between them
/// is WARNED about, never silently overwritten (Q6).
model SalesDay {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  branchId     String   @map("branch_id") @db.Uuid
  businessDate DateTime @map("business_date") @db.Date

  /// Which batch owns this day right now. Nullable because Part 20 can create the
  /// day from a pulse before any detail file exists for it.
  currentBatchId String? @map("current_batch_id") @db.Uuid

  /// --- the daily pulse (Part 20, ADR 0020) ---
  /// **What the customer paid**: after discount, INCLUDING VAT and service charge.
  /// Deliberately not this project's revenue, which excludes both (ADR 0019 Q10) —
  /// the pulse exists to be the same number the owner sees in the POS app, and to
  /// be compared against `net + vat + service_charge` from this day's lines. The
  /// two differ by up to ~17%, so anything that adds or compares them directly is
  /// wrong (rule P27).
  ///
  /// Editable until a detail file lands for this day, then FROZEN (Q2/rule P28):
  /// its job changes from a figure being read to the evidence a file is checked
  /// against, and a pulse anyone could edit to silence a warning is no evidence.
  ///
  /// `>= 0` — the opposite of `sales_line`, and deliberately. That table mirrors
  /// the POS, where a refund really is negative and Mise is not the authority
  /// (ADR 0019 Q14). This is TYPED BY A PERSON, where a leading minus is a slip
  /// and Mise is the only check there is. `sales_day_pulse_amount_check`.
  pulseAmount     Decimal?          @map("pulse_amount") @db.Decimal(15, 2)
  pulseSource     SalesPulseSource? @map("pulse_source")
  /// A figure used as evidence needs a name on it.
  pulseRecordedBy String?           @map("pulse_recorded_by")
  pulseRecordedAt DateTime?         @map("pulse_recorded_at")
  /// "ตู้เย็นเสีย ปิดเร็ว" — why a day looks odd, from the person who was there.
  /// Worth more than any threshold, because it is the explanation rather than the
  /// detection.
  pulseNote       String?           @map("pulse_note")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant              Tenant            @relation(fields: [tenantId], references: [id])
  branch              Branch            @relation(fields: [branchId], references: [id])
  currentBatch        SalesImportBatch? @relation("SalesDayCurrentBatch", fields: [currentBatchId], references: [id])
  pulseRecordedByUser User?             @relation("SalesPulseRecordedBy", fields: [pulseRecordedBy], references: [id])
  salesLines          SalesLine[]

  @@unique([branchId, businessDate], map: "sales_day_branch_date_unique")
  @@index([tenantId])
  @@map("sales_day")
}

/// A grouping of menus that belongs to MISE, mirroring the POS's name rather than
/// being it (Q9) — the same principle as Q7 one level up. The category drill-down
/// and the month-over-month category share are unreadable if a category changes
/// identity every time someone edits the POS.
///
/// NOT the `category` table: that is the COGS/OpEx accounting tree for products
/// and expenses. A menu group and an accounting group are different kinds of thing.
model MenuCategory {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  name     String

  /// What the POS called it when this row was created, kept so a re-import can
  /// recognise the same group without asking again. Advisory only — the shop is
  /// free to rename, split or merge, and the POS's opinion never overwrites.
  posCategoryName String? @map("pos_category_name")

  displayOrder Int?    @map("display_order")
  isActive     Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  menus  Menu[]

  /// Uniqueness is a PARTIAL unique (tenant_id, name) WHERE deleted_at IS NULL in
  /// prisma/manual/sales_unique.sql — a full unique would let a soft-deleted
  /// category hold its name forever (Pitfall #22/#23).
  @@index([tenantId])
  @@map("menu_category")
}

/// A dish that can be sold. The MINIMUM a sale needs (Q1): `pos_raw_snapshot`,
/// `recipe_status` and `recipe_id` belong to Sprint 5, when there is a recipe to
/// protect.
///
/// IDENTITY IS `pos_menu_id`, NOT THE NAME (Q7). A POS rename, a stray space or
/// a dropped character changes nothing.
model Menu {
  id       String     @id @default(uuid()) @db.Uuid
  tenantId String     @map("tenant_id") @db.Uuid
  source   MenuSource

  /// Both NULL on a MISE menu — menu_source_check. `posMenuId` may be null even
  /// on a POS menu: a daily-summary file often carries names only, which is
  /// exactly the case `menu_alias` exists to serve.
  posIntegrationId String? @map("pos_integration_id") @db.Uuid
  posMenuId        String? @map("pos_menu_id")

  /// The name Mise shows. Editable by the shop and NEVER overwritten by a sync —
  /// Section B's layer 2, the one part of the mirror that matters before recipes.
  name        String
  /// The name the POS last sent. Layer 1: kept so a human can see what the file
  /// actually said when a match looks wrong.
  posMenuName String? @map("pos_menu_name")

  menuCategoryId      String? @map("menu_category_id") @db.Uuid
  /// Which department earns this menu's revenue (Q16). NULL is legal and visible:
  /// with departments ON, unassigned revenue shows as its own row rather than
  /// being folded into Main, or the Bar looks profitable on the Kitchen's takings.
  primaryDepartmentId String? @map("primary_department_id") @db.Uuid

  /// Auto-created because a file named a dish Mise had never heard of (Decision
  /// #57). Money lands in full immediately; the dish gets identified later. The
  /// stub is shown in the import preview BEFORE commit, which is what keeps this
  /// inside Section D.4's ban on unannounced auto-creation.
  isPosStub Boolean @default(false) @map("is_pos_stub")
  isActive  Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  tenant            Tenant             @relation(fields: [tenantId], references: [id])
  posIntegration    PosIntegration?    @relation(fields: [posIntegrationId], references: [id])
  menuCategory      MenuCategory?      @relation(fields: [menuCategoryId], references: [id])
  primaryDepartment Department?        @relation(fields: [primaryDepartmentId], references: [id])
  aliases           MenuAlias[]
  salesLines        SalesLine[]
  recipes           Recipe[]
  usedInRecipes     RecipeIngredient[] @relation("RecipeComponentMenu")

  /// UNIQUE(pos_integration_id, pos_menu_id) WHERE source='POS' AND pos_menu_id
  /// IS NOT NULL lives in prisma/manual/sales_unique.sql (Prisma 5.22 cannot
  /// express a partial unique).
  @@index([tenantId])
  @@index([posIntegrationId], map: "menu_integration_idx")
  @@index([menuCategoryId], map: "menu_category_idx")
  @@map("menu")
}

/// A spelling that a human has confirmed points at a given menu (Q7).
///
/// This is the durable half of "the system suggests, a person decides, the system
/// remembers". Automatic merging on a similarity score is FORBIDDEN: Thai menu
/// names differ by one word for genuinely different dishes, so any threshold that
/// catches a typo also merges two real dishes — corrupting revenue now and
/// consuming the wrong ingredient in Sprint 5.
model MenuAlias {
  id               String @id @default(uuid()) @db.Uuid
  tenantId         String @map("tenant_id") @db.Uuid
  posIntegrationId String @map("pos_integration_id") @db.Uuid
  /// Trimmed, inner whitespace collapsed, Unicode NFC. Normalising BEFORE the
  /// exact-match attempt absorbs the stray-space and dropped-character cases with
  /// no guessing at all; the fuzzy suggestion is only for what survives that.
  normalizedName   String @map("normalized_name")
  /// The name exactly as the file spelled it, for the screen that explains why
  /// this alias exists.
  rawName          String @map("raw_name")
  menuId           String @map("menu_id") @db.Uuid

  confirmedBy String   @map("confirmed_by")
  createdAt   DateTime @default(now()) @map("created_at")

  tenant          Tenant         @relation(fields: [tenantId], references: [id])
  posIntegration  PosIntegration @relation(fields: [posIntegrationId], references: [id])
  menu            Menu           @relation(fields: [menuId], references: [id], onDelete: Cascade)
  confirmedByUser User           @relation("MenuAliasConfirmedBy", fields: [confirmedBy], references: [id])

  @@unique([posIntegrationId, normalizedName], map: "menu_alias_name_unique")
  @@index([tenantId])
  @@index([menuId], map: "menu_alias_menu_idx")
  @@map("menu_alias")
}

/// ONE MENU x ONE SALES DAY x ONE BRANCH (Q4).
///
/// A per-bill export and a daily-summary export both land here; a summary row is
/// simply a sale whose bill and time are unknown. Revenue arithmetic and (later)
/// consumption arithmetic are IDENTICAL for both, so there is never a second code
/// path — only bill-count and peak-hour views are unavailable, and the screen
/// must SAY SO rather than show zero.
///
/// THERE ARE NO SIGN CHECKS ON THIS TABLE, DELIBERATELY. Voided bills and refunds
/// are negative; giveaways and tastings are zero. Both are legal (Q14), which
/// makes this the first table in the system with no `.positive()` to lean on — so
/// a BLANK in the file must be caught before it can be coerced to 0 (rule P21,
/// the lesson Part 18 paid for at L2/T14).
model SalesLine {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  branchId String @map("branch_id") @db.Uuid

  /// A plain DATE, never a timestamp to be truncated later — day and week
  /// grouping read it directly, which keeps Decision #60's timezone problem out
  /// of a place where it was already solved (rule P15).
  businessDate  DateTime @map("business_date") @db.Date
  salesDayId    String   @map("sales_day_id") @db.Uuid
  importBatchId String   @map("import_batch_id") @db.Uuid

  menuId      String  @map("menu_id") @db.Uuid
  /// What the file actually said, kept beside the resolved FK so a wrong match is
  /// visible rather than merely wrong.
  posMenuName String? @map("pos_menu_name")
  posMenuCode String? @map("pos_menu_code")

  qty Decimal @db.Decimal(15, 3)

  /// --- money, all normalised AT IMPORT (rule P10) ---
  /// `netAmount` IS revenue: after discount, excluding VAT, excluding service
  /// charge (Q10). There is deliberately no second `revenue` column that could
  /// disagree with it. The other four are kept because the VAT return needs
  /// output VAT and O17 needs to reconcile service charge collected against
  /// service charge paid out.
  grossAmount         Decimal @map("gross_amount") @db.Decimal(15, 2)
  discountAmount      Decimal @map("discount_amount") @db.Decimal(15, 2)
  netAmount           Decimal @map("net_amount") @db.Decimal(15, 2)
  serviceChargeAmount Decimal @map("service_charge_amount") @db.Decimal(15, 2)
  vatAmount           Decimal @map("vat_amount") @db.Decimal(15, 2)

  /// --- present only when the file had them (Q4) ---
  channel   SalesChannel?
  posBillId String?       @map("pos_bill_id")
  soldAt    DateTime?     @map("sold_at")

  /// --- supersede (Q5) ---
  /// Replaced rows are KEPT, never deleted: in Sprint 5 these rows drive
  /// CONSUMPTION into an append-only ledger, and deleting a sale would leave
  /// stock consumed with no document to point at.
  /// The only write this row ever receives after INSERT is this pair, which is
  /// why the model carries no `updatedAt`.
  supersededAt        DateTime? @map("superseded_at")
  supersededByBatchId String?   @map("superseded_by_batch_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  tenant            Tenant            @relation(fields: [tenantId], references: [id])
  branch            Branch            @relation(fields: [branchId], references: [id])
  salesDay          SalesDay          @relation(fields: [salesDayId], references: [id])
  importBatch       SalesImportBatch  @relation("SalesLineBatch", fields: [importBatchId], references: [id])
  supersededByBatch SalesImportBatch? @relation("SalesLineSupersededBy", fields: [supersededByBatchId], references: [id])
  menu              Menu              @relation(fields: [menuId], references: [id])

  @@index([tenantId])
  /// The one read every screen in this Part performs.
  @@index([branchId, businessDate], map: "sales_line_branch_date_idx")
  @@index([salesDayId], map: "sales_line_day_idx")
  @@index([menuId, businessDate], map: "sales_line_menu_date_idx")
  @@index([importBatchId], map: "sales_line_batch_idx")
  @@map("sales_line")
}

/// How `/cost` computes gross profit for a period (ADR 0019 Q17).
///
/// Both are legitimate; neither is a fallback for the other. What differs is
/// which discipline the shop already keeps, and therefore which number it can
/// stand behind when someone asks where it came from.
enum GrossProfitMethod {
  /// **นับสต๊อก** — cost of goods sold = opening inventory + purchases − closing
  /// inventory, all three valued by the FIFO replay (ADR 0014).
  ///
  /// Works today, with no recipes at all — which is the promise Mise makes to a
  /// shop on day one. Its accuracy is exactly the accuracy of the stock counts
  /// that bound the period: with no count at the end, "closing inventory" is
  /// only what the ledger believes, and until Sprint 5 the ledger has no
  /// CONSUMPTION so it believes stock only ever rises. The figure is therefore
  /// shown with when the branch was last counted, never on its own.
  PERIODIC_INVENTORY

  /// **สูตรอาหาร** — cost of goods sold = what the recipes say the sold dishes
  /// consumed. Needs `recipe` and `CONSUMPTION`, which arrive in Sprint 5; until
  /// then a shop that picks this is told the figure is not available yet rather
  /// than shown a different method's answer under this one's name.
  RECIPE_CONSUMPTION

  @@map("gross_profit_method")
}

/// Where a daily pulse came from (ADR 0020).
///
/// `EMAIL` is deliberately ABSENT until Part 20b writes it — an inbound-mail
/// vendor is a stop-and-ask, and an enum value with no writer is debt rather
/// than preparation (the lesson `SourceType.SYSTEM_INITIAL` has been teaching
/// since Part 10).
enum SalesPulseSource {
  /// Typed at close by whoever is shutting the shop.
  MANUAL

  @@map("sales_pulse_source")
}

// ============================================================
// Sprint 5 Part 21 — Recipe (ADR 0021)
// ============================================================

/// WHAT ONE THING IS MADE OF — a menu that is sold, or a PREPPED product that is
/// produced. Never both (Q1, Q2): `recipe_target_check` is the XOR.
///
/// THIS ROW IS ONE VERSION. Versions of the same recipe share a `lineId`; which
/// one applies on a given day is decided by `effectiveFrom`, because Part 19
/// imports periodically and Part 22 must post each past day against the recipe
/// that was true THEN (Q4). Getting this wrong overstates or understates every
/// ingredient for a fortnight with nothing on screen looking wrong.
///
/// WARNING: `supersededAt` does NOT mean "a later version replaced this". A
/// normal change leaves the old version alive and correct for the days it
/// covered. Superseded means **this version was wrong** — someone corrected a
/// typo with the same `effectiveFrom` — and it is therefore excluded from
/// resolution entirely. Exactly the distinction ADR 0014 Q6 draws for cost
/// declarations: correcting our knowledge of the past is not an event.
///
/// Resolution for a date D, at a branch:
///   live rows (deletedAt IS NULL, supersededAt IS NULL) of the line that serves
///   that branch, with effectiveFrom <= D, ordered by (effectiveFrom DESC,
///   createdAt DESC), LIMIT 1.
model Recipe {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  /// Stable across every version of the same recipe. A brand-new recipe gets a
  /// fresh one; creating a version copies its parent's. Deliberately NOT a FK to
  /// the first version — that would be a chicken-and-egg on insert, and the line
  /// must outlive any particular row.
  ///
  /// This is also what `recipe_branch` attaches to, so adding a version never
  /// re-links branches. Attaching branches to the VERSION would mean every new
  /// version has to copy N links, and one missed copy sends that branch silently
  /// back to the central recipe — a wrong number with nothing to notice it.
  lineId String @default(uuid()) @map("line_id") @db.Uuid

  /// Exactly one of these two is set (`recipe_target_check`).
  menuId String? @map("menu_id") @db.Uuid

  /// A PRODUCTION RECIPE (Q1): the one notation that holds MANY inputs, which is
  /// why chilli jam needs it and portioned salmon does not. A PREPPED product is
  /// made by `parentProductId` + `yieldPercent` OR by one of these, never both —
  /// enforced in app logic, because the condition spans two tables and no CHECK
  /// can see across them (the same reason ADR 0007's depth guard lives in code).
  outputProductId String? @map("output_product_id") @db.Uuid

  /// HOW MUCH ONE WRITING OF THIS RECIPE MAKES (Q16), counted in whatever unit
  /// the thing that consumes it counts in:
  ///   - a MENU recipe          -> portions. 1 for a dish cooked to order; 20
  ///                               for a curry cooked by the pot, so the system
  ///                               divides 350 g of paste by 20 instead of the
  ///                               user rounding 17.5 by hand into a form.
  ///   - a PRODUCTION recipe    -> the output product's BASE UNITS. One batch of
  ///                               chilli jam makes 250 g, so `servings` is 250.
  ///
  /// One column, one meaning: "how much comes out". NOT a yield — this splits a
  /// batch into what is taken from it, while yield accounts for what the knife
  /// takes, and BOTH divisions apply, in that order (rule R2).
  servings Decimal @default(1) @map("servings") @db.Decimal(15, 3)

  /// The business date this version starts applying. Editing normally stamps
  /// today and the UI never asks; a correction sets it back (Q4).
  effectiveFrom DateTime @map("effective_from") @db.Date

  supersededAt   DateTime? @map("superseded_at")
  supersededById String?   @map("superseded_by_id") @db.Uuid

  /// Part 24 (ADR 0025 Q4). A recipe the shop is still deciding about, and one
  /// that is true on NO day: it is filtered out in `recipe-resolve.ts` — the
  /// single route by which a recipe reaches the ledger — and in
  /// `recipe-guards.ts`, or drafting a change to a live dish would collide with
  /// that dish's own published recipe.
  ///
  /// A flag rather than a `recipe_draft` table on purpose: `recipe-cost.ts`
  /// holds the only recursive yield-correct cost walk in the system, and a draft
  /// with a shape of its own would need a second one. Two cost engines drift,
  /// and the day the lab disagrees with the recipe page nothing reports it.
  isDraft Boolean @default(false) @map("is_draft")

  /// The price being considered while designing — **ราคาที่ตั้งใจ**, never ราคา.
  ///
  /// ADR 0021 Q10 refused `menu.sale_price` because a typed price goes stale the
  /// day the POS price changes, and that argument bites hardest here: if Menu
  /// Lab works, the dish gets sold. On a draft the number means something that
  /// cannot go stale — a fact about a design session, not a claim about today —
  /// so it never competes with the price read from sales. Kept after publishing,
  /// because "planned ฿89, selling at ฿85" is worth knowing, and **once the dish
  /// has sales the sold price is the price** (ADR 0025 Q2).
  plannedPrice Decimal? @map("planned_price") @db.Decimal(15, 2)

  notes String?

  createdBy String    @map("created_by")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  tenant        Tenant             @relation(fields: [tenantId], references: [id])
  menu          Menu?              @relation(fields: [menuId], references: [id])
  outputProduct Product?           @relation("RecipeOutputProduct", fields: [outputProductId], references: [id])
  supersededBy  Recipe?            @relation("RecipeSupersede", fields: [supersededById], references: [id])
  supersedes    Recipe[]           @relation("RecipeSupersede")
  createdByUser User               @relation("RecipeCreatedBy", fields: [createdBy], references: [id])
  ingredients   RecipeIngredient[]
  branches      RecipeBranch[]

  @@index([tenantId])
  @@index([lineId, effectiveFrom], map: "recipe_line_effective_idx")
  @@index([menuId], map: "recipe_menu_idx")
  @@index([outputProductId], map: "recipe_output_product_idx")
  @@map("recipe")
}

/// ONE LINE OF A RECIPE — and it points at a THING, never at a recipe version
/// (Q3).
///
/// `ref_recipe_id` from master-spec 5.9 is deliberately absent. Pointing at a
/// version means a set menu still references the steak recipe it was written
/// against; pointing at the steak resolves to whatever the steak currently is,
/// which is also how a kitchen says it — "the set contains one steak", never
/// "the set contains steak recipe v3".
///
///   productId       RAW     -> a leaf, priced by the FIFO replay
///                   PREPPED -> descend (production recipe, or parent + yield)
///   componentMenuId         -> descend into that menu's recipe   <- SET MENUS
///
/// A product ingredient carries a unit ("120 g of minced pork"); a menu
/// ingredient does not ("1 steak"). `recipe_ingredient_unit_check` binds the two.
model RecipeIngredient {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  recipeId String @map("recipe_id") @db.Uuid

  /// Exactly one of these two is set (`recipe_ingredient_target_check`).
  productId       String? @map("product_id") @db.Uuid
  componentMenuId String? @map("component_menu_id") @db.Uuid

  /// As written by the person entering the recipe, in `productUnitId`. The
  /// base-unit value is COMPUTED at read and never stored (Q17): a recipe is a
  /// standing instruction ("use one bag"), not a record of a past transaction,
  /// so correcting what a bag weighs should move every recipe that says "bag".
  /// This is the deliberate opposite of ADR 0012 Q3, which freezes the ratio
  /// onto a purchase order line precisely because that IS a record of the past.
  ///
  /// qty > 0 is enforced. Unlike `sales_line`, 0 is not a legal answer here — a
  /// recipe that uses none of something simply has no line — so `.positive()` is
  /// safe to lean on at L2, which is NOT true of the sales tables (rule P21).
  qty Decimal @map("qty") @db.Decimal(15, 3)

  /// NULL exactly when this line points at a menu.
  productUnitId String? @map("product_unit_id") @db.Uuid

  sortOrder Int     @default(0) @map("sort_order")
  notes     String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant        Tenant       @relation(fields: [tenantId], references: [id])
  recipe        Recipe       @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  product       Product?     @relation(fields: [productId], references: [id])
  componentMenu Menu?        @relation("RecipeComponentMenu", fields: [componentMenuId], references: [id])
  productUnit   ProductUnit? @relation(fields: [productUnitId], references: [id])

  @@index([tenantId])
  @@index([recipeId], map: "recipe_ingredient_recipe_idx")
  /// The reverse lookup, and it is load-bearing twice over: Q13's delete guard
  /// has to NAME the recipes blocking a product, and Q14's substitution screen
  /// lists them so a human can tick which ones to change.
  @@index([productId], map: "recipe_ingredient_product_idx")
  @@index([componentMenuId], map: "recipe_ingredient_component_menu_idx")
  @@map("recipe_ingredient")
}

/// WHICH BRANCHES A RECIPE LINE SERVES (Q8).
///
/// NO ROW FOR A BRANCH MEANS THE CENTRAL RECIPE APPLIES — and follows it as it
/// changes, because a branch that has never copied has not decided anything.
/// The moment a recipe is copied to a branch, that branch has declared it
/// decides for itself and nothing central reaches it again: a recipe change is a
/// change to how a kitchen works, and one branch's cooks may be retrained while
/// another's are not.
///
/// A JOIN TABLE, not a `branch_id` column on `recipe` (the rejected shape): five
/// mall branches cooking alike would otherwise be five identical rows kept in
/// step by hand, and the day someone edits four of them nothing says so. That
/// breaks at five branches, not a hundred. It also leaves named recipe sets
/// as a label added later rather than a migration.
///
/// WARNING: nothing here stops a branch being linked to two lines for the SAME
/// menu, which would make "which recipe applies" ambiguous — the condition spans
/// this table and `recipe`, so no constraint can see it. Guarded in app logic,
/// and the resolution query orders and LIMITs so an ambiguity cannot crash a
/// page.
model RecipeBranch {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  /// Attaches to the LINE, not to a version — see `Recipe.lineId`.
  lineId   String @map("line_id") @db.Uuid
  branchId String @map("branch_id") @db.Uuid

  /// Any one version of the line, kept so Prisma can navigate and so a stray row
  /// can be traced back to what created it. Resolution keys on `lineId`.
  recipeId String @map("recipe_id") @db.Uuid

  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  branch Branch @relation(fields: [branchId], references: [id])
  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([lineId, branchId], map: "recipe_branch_unique")
  @@index([tenantId])
  @@index([branchId], map: "recipe_branch_branch_idx")
  @@map("recipe_branch")
}

/// What a cancelled bill does to stock (ADR 0022 Q3, rule N4).
///
/// The POS exports a cancellation as a negative row and says nothing about
/// whether anyone had started cooking. Both readings are common, so this is the
/// shop's to settle rather than ours to assume — and the settings screen shows
/// each option's consequence with a worked example rather than only its name
/// (rule N12).
enum CancelledSalePolicy {
  /// Negative rows are IGNORED: 12 sold and 1 cancelled consumes 12. A count
  /// later shows a SURPLUS, which is itself the evidence that orders were
  /// cancelled — visible, and traceable back to a cause.
  TREAT_AS_COOKED
  /// Negative rows are SUBTRACTED: the same day consumes 11. Right when the till
  /// voided it before the pan was hot; a SHORTFALL indistinguishable from theft
  /// when it did not.
  TREAT_AS_NOT_COOKED

  @@map("cancelled_sale_policy")
}

/// Why a run stopped counting. Machine-set, never typed — unlike waste's
/// free-text voidReason, there are exactly two ways a posted day is taken back.
enum ConsumptionVoidReason {
  /// A newer file replaced the day's sales (ADR 0022 Q5). Fires automatically
  /// inside the import's own transaction: superseding the sales lines makes these
  /// movements refer to sales that no longer stand, and the ledger must not sit
  /// knowingly wrong waiting for someone to notice.
  RE_IMPORT
  /// The user posted the day again — because recipes were added, or one covering
  /// that day was edited (Q2b, Q7). Posting a day is never a top-up.
  REPOST

  @@map("consumption_void_reason")
}

/// การตัดสต๊อกตามยอดขาย — one branch's sales for one business day, turned into
/// stock leaving the Ledger (ADR 0022).
///
/// A document of its own rather than movements hung off `sales_line`, because
/// `stock_movement_source_unique` keys on the PAIR (source_type, source_id) and
/// one sales line explodes into N raw products (Q1).
///
/// Deliberately NOT unique on (branch_id, business_date): a voided run and the
/// run that replaced it both stand, side by side, so the screen shows the mistake
/// and its correction together — ADR 0013 Q6's argument. What IS unique is the
/// LIVE one, enforced by a partial index in
/// prisma/manual/sales_consumption_unique.sql; without it a double-clicked button
/// would consume the day twice.
model SalesConsumptionRun {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  branchId     String   @map("branch_id") @db.Uuid
  /// A plain DATE, like sales_line.business_date — never a timestamp to be
  /// truncated, so no timezone enters the grouping (rule P15).
  businessDate DateTime @map("business_date") @db.Date

  postedAt DateTime @map("posted_at")
  postedBy String   @map("posted_by")

  /// The policy IN FORCE when this run posted (N4). Frozen because changing the
  /// setting later changes what the same day would consume, and a run that cannot
  /// say which rule it followed cannot explain its own numbers.
  cancelledSalePolicy CancelledSalePolicy @map("cancelled_sale_policy")

  voidedAt   DateTime?              @map("voided_at")
  voidedBy   String?                @map("voided_by")
  voidReason ConsumptionVoidReason? @map("void_reason")

  /// Coverage, as a share of REVENUE rather than of dish count, because the
  /// question behind it is how wrong the cost of goods sold is and a ฿20 water is
  /// not a ฿300 steak (rule N3). Stored rather than recomputed: /cost labels every
  /// period with it, and re-deriving would mean re-exploding every recipe for
  /// every day on the heaviest page in the system.
  ///
  /// Not a cost, so ADR 0014's "cost is stored nowhere" does not reach it.
  coveredNetAmount Decimal @map("covered_net_amount") @db.Decimal(15, 2)
  totalNetAmount   Decimal @map("total_net_amount") @db.Decimal(15, 2)
  menusPosted      Int     @map("menus_posted")
  menusSkipped     Int     @map("menus_skipped")

  /// The dishes this run could NOT post, each with its reason — no recipe, a
  /// recipe that would not explode, a component menu with no recipe of its own,
  /// or a business date past the backdate window (N2, N9). Read back by the
  /// coverage screen, so the answer survives the request that computed it.
  /// JSONB, following sales_import_batch.error_log.
  skippedMenus Json? @map("skipped_menus") @db.JsonB

  createdAt DateTime @default(now()) @map("created_at")

  tenant       Tenant                 @relation(fields: [tenantId], references: [id])
  branch       Branch                 @relation(fields: [branchId], references: [id])
  postedByUser User                   @relation("ConsumptionPostedBy", fields: [postedBy], references: [id])
  voidedByUser User?                  @relation("ConsumptionVoidedBy", fields: [voidedBy], references: [id])
  items        SalesConsumptionItem[]

  @@index([tenantId])
  @@index([branchId, businessDate], map: "sales_consumption_run_branch_date_idx")
  @@map("sales_consumption_run")
}

/// One raw product's worth of a day's cooking. THIS ROW IS THE LEDGER'S SOURCE:
/// source_type = SALES_CONSUMPTION, source_id = this id, which is what makes
/// posting idempotent (the waste_log pattern).
///
/// Aggregated across every menu sold that day (Q1). An item per sales line ×
/// product would answer "which dish ate what", which nothing asks — H.8's
/// variance compares at the product level — while multiplying the ledger ~50×
/// and making /cost replay every row of it.
model SalesConsumptionItem {
  id        String @id @default(uuid()) @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  runId     String @map("run_id") @db.Uuid
  productId String @map("product_id") @db.Uuid

  /// SIGNED, in the product's base unit, matching movement.qty exactly — normally
  /// negative (stock leaving). Positive in two cases: a reversal item, and a day
  /// whose cancellations outweighed its sales under TREAT_AS_NOT_COOKED (N8).
  ///
  /// No CHECK binding the sign to the reversal flag, unlike stock_transfer_item:
  /// that second case is a genuine positive on a non-reversal row. Only `<> 0` is
  /// enforced — a zero item is noise with a movement attached.
  qty Decimal @db.Decimal(15, 3)

  /// A void APPENDS reversal items to THIS run and posts the compensating
  /// CONSUMPTION_REVERSAL against them. It cannot be an edit: the ledger is
  /// append-only and the compensating movement needs a source_id of its own to
  /// satisfy UNIQUE(source_type, source_id). At most one reversal per item —
  /// partial unique in prisma/manual/sales_consumption_unique.sql, or a
  /// double-submitted void would credit the stock back twice.
  reversalOfItemId String? @map("reversal_of_item_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  tenant     Tenant                 @relation(fields: [tenantId], references: [id])
  run        SalesConsumptionRun    @relation(fields: [runId], references: [id])
  product    Product                @relation(fields: [productId], references: [id])
  reversalOf SalesConsumptionItem?  @relation("ConsumptionItemReversal", fields: [reversalOfItemId], references: [id])
  reversedBy SalesConsumptionItem[] @relation("ConsumptionItemReversal")

  @@index([tenantId])
  @@index([runId], map: "sales_consumption_item_run_idx")
  @@map("sales_consumption_item")
}
