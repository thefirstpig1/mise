// ============================================================
// Mise — Prisma Schema (Sprint 0 — Identity Layer)
// ============================================================
// Based on Master Spec v1.4
// Tables: tenant, branch, app_user, tenant_membership,
//         user_branch_access, department, user_department_assignment
//
// Additional Sprint 0 tables (for Auth.js + RLS support):
//         Account, Session, VerificationToken
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// AUTH.JS TABLES (managed by @auth/prisma-adapter)
// ============================================================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("account")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_token")
}

// ============================================================
// IDENTITY LAYER (Mise — Sprint 0)
// ============================================================

model Tenant {
  id                   String  @id @default(uuid()) @db.Uuid
  name                 String
  legalName            String? @map("legal_name")
  taxId                String? @map("tax_id")
  timezone             String  @default("Asia/Bangkok")
  currency             String  @default("THB")
  fiscalYearStartMonth Int     @default(1) @map("fiscal_year_start_month")
  plan                 String  @default("trial") // trial, basic, pro, enterprise

  // v1.2 opt-in features
  enableDepartments     Boolean @default(false) @map("enable_departments")
  isVatRegistered       Boolean @default(false) @map("is_vat_registered")
  vatRegistrationNo     String? @map("vat_registration_no")
  defaultVatRatePercent Decimal @default(7.00) @map("default_vat_rate_percent") @db.Decimal(5, 2)

  settings Json? @db.JsonB

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  branches                Branch[]
  memberships             TenantMembership[]
  departments             Department[]
  suppliers               Supplier[]
  categories              Category[]
  products                Product[]
  supplierProductMappings SupplierProductMapping[]
  stockMovements          StockMovement[]
  stockAdjustments        StockAdjustment[]
  stockCostDeclarations   StockCostDeclaration[]
  stockCounts             StockCount[]
  stockCountItems         StockCountItem[]
  stockCountEntries       StockCountEntry[]
  purchaseOrders          PurchaseOrder[]
  purchaseOrderItems      PurchaseOrderItem[]
  poItemAllocations       PurchaseOrderItemAllocation[]
  goodsReceipts           GoodsReceipt[]
  goodsReceiptItems       GoodsReceiptItem[]
  grItemAllocations       GoodsReceiptItemAllocation[]
  expenses                Expense[]
  expenseItems            ExpenseItem[]
  recurringExpenses       RecurringExpense[]
  wasteLogs               WasteLog[]
  parLevels               ParLevel[]

  @@map("tenant")
}

model Branch {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  name     String
  /// NOT NULL since Part 11 (ADR 0012 Q8b) — it prefixes every po_number of this
  /// branch ({CODE}-PO-####), so a branch without one cannot issue a PO.
  /// Uniqueness = PARTIAL unique (tenant_id, code) WHERE deleted_at IS NULL in
  /// prisma/manual/branch_code_unique.sql — a FULL unique would let a soft-deleted
  /// branch reserve its code forever (Pitfall #22/#23). NOTE: Department.code
  /// above still uses a FULL @@unique and carries that trap; not fixed here.
  code     String
  address  String?
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  tenant                  Tenant                   @relation(fields: [tenantId], references: [id])
  userAccess              UserBranchAccess[]
  supplierProductMappings SupplierProductMapping[]
  stockMovements          StockMovement[]
  stockAdjustments        StockAdjustment[]
  stockCounts             StockCount[]
  purchaseOrders          PurchaseOrder[]
  goodsReceipts           GoodsReceipt[]
  expenses                Expense[]
  recurringExpenses       RecurringExpense[]
  wasteLogs               WasteLog[]
  parLevels               ParLevel[]

  @@index([tenantId])
  @@map("branch")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime? @map("email_verified") // For Auth.js
  name          String?
  image         String? // For Auth.js
  phone         String?
  authProvider  String?   @map("auth_provider")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  accounts                  Account[]
  sessions                  Session[]
  memberships               TenantMembership[]
  stockMovements            StockMovement[]
  stockAdjustments          StockAdjustment[]
  stockCostDeclarations     StockCostDeclaration[]
  stockCountsStarted        StockCount[]           @relation("ScStartedBy")
  stockCountsClosed         StockCount[]           @relation("ScClosedBy")
  stockCountsVoided         StockCount[]           @relation("ScVoidedBy")
  stockCountItemsCounted    StockCountItem[]
  purchaseOrdersMade        PurchaseOrder[]        @relation("PoCreatedBy")
  purchaseOrdersSent        PurchaseOrder[]        @relation("PoSentBy")
  purchaseOrdersVoided      PurchaseOrder[]        @relation("PoCancelledBy")
  purchaseOrdersClosedShort PurchaseOrder[]        @relation("PoClosedShortBy")
  goodsReceiptsReceived     GoodsReceipt[]         @relation("GrReceivedBy")
  goodsReceiptsConfirmed    GoodsReceipt[]         @relation("GrConfirmedBy")
  goodsReceiptsVoided       GoodsReceipt[]         @relation("GrVoidedBy")
  expensesCreated           Expense[]
  wasteLogged               WasteLog[]             @relation("WasteWastedBy")
  wasteVoided               WasteLog[]             @relation("WasteVoidedBy")

  @@map("app_user")
}

model TenantMembership {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  userId   String  @map("user_id")
  role     String // owner, manager, purchaser, kitchen_staff, accountant, viewer
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant          Tenant                     @relation(fields: [tenantId], references: [id])
  user            User                       @relation(fields: [userId], references: [id])
  branchAccess    UserBranchAccess[]
  deptAssignments UserDepartmentAssignment[]

  @@unique([tenantId, userId])
  @@map("tenant_membership")
}

model UserBranchAccess {
  id                 String @id @default(uuid()) @db.Uuid
  tenantMembershipId String @map("tenant_membership_id") @db.Uuid
  branchId           String @map("branch_id") @db.Uuid

  membership TenantMembership @relation(fields: [tenantMembershipId], references: [id])
  branch     Branch           @relation(fields: [branchId], references: [id])

  @@unique([tenantMembershipId, branchId])
  @@map("user_branch_access")
}

model Department {
  id           String  @id @default(uuid()) @db.Uuid
  tenantId     String  @map("tenant_id") @db.Uuid
  name         String
  code         String
  description  String?
  parentDeptId String? @map("parent_dept_id") @db.Uuid
  isActive     Boolean @default(true) @map("is_active")
  displayOrder Int?    @map("display_order")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  tenant            Tenant                        @relation(fields: [tenantId], references: [id])
  parentDept        Department?                   @relation("DeptHierarchy", fields: [parentDeptId], references: [id])
  childDepts        Department[]                  @relation("DeptHierarchy")
  assignments       UserDepartmentAssignment[]
  poItemAllocations PurchaseOrderItemAllocation[]
  grItemAllocations GoodsReceiptItemAllocation[]
  expenseItems      ExpenseItem[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("department")
}

model UserDepartmentAssignment {
  id                 String @id @default(uuid()) @db.Uuid
  tenantMembershipId String @map("tenant_membership_id") @db.Uuid
  departmentId       String @map("department_id") @db.Uuid

  isPrimary     Boolean @default(false) @map("is_primary")
  canRequestFor Boolean @default(false) @map("can_request_for")
  canApproveFor Boolean @default(false) @map("can_approve_for")
  canReceiveFor Boolean @default(false) @map("can_receive_for")

  membership TenantMembership @relation(fields: [tenantMembershipId], references: [id])
  department Department       @relation(fields: [departmentId], references: [id])

  @@unique([tenantMembershipId, departmentId])
  @@map("user_department_assignment")
}

// ============================================================
// REFERENCE TABLES (Sprint 1 — system-wide, no RLS)
// ============================================================

model UnitTemplate {
  id             String   @id @default(uuid()) @db.Uuid
  unitName       String   @unique @map("unit_name")
  unitDimension  String   @map("unit_dimension") // "WEIGHT" | "VOLUME" | "COUNT"
  toSiRatio      Decimal? @map("to_si_ratio") @db.Decimal(15, 6) // g for WEIGHT, ml for VOLUME, null for COUNT
  displayOrderTh Int?     @map("display_order_th")
  displayOrderEn Int?     @map("display_order_en")

  @@map("unit_template")
}

model LiquidDensityTemplate {
  id           String  @id @default(uuid()) @db.Uuid
  /// FULL unique safe เพราะ table นี้ไม่มี soft-delete (Q7).
  /// ถ้าเพิ่ม deletedAt ในอนาคต → ต้อง swap เป็น partial index
  /// ใน prisma/manual/ (precedent: supplier_code_unique.sql)
  /// เพื่อกัน Pitfall #22/#23 family (full unique + ghost row)
  name         String  @unique
  gPerMl       Decimal @map("g_per_ml") @db.Decimal(15, 6)
  description  String?
  displayOrder Int?    @map("display_order")

  products Product[]

  @@map("liquid_density_template")
}

// ============================================================
// MASTER DATA (Sprint 1 — tenant-scoped, RLS required)
// ============================================================

model Supplier {
  id                    String   @id @default(uuid()) @db.Uuid
  tenantId              String   @map("tenant_id") @db.Uuid
  /// Uniqueness enforced by partial unique index in
  /// prisma/manual/supplier_code_unique.sql (per-tenant, excludes soft-deleted + NULL).
  /// Not a Prisma @@unique because Prisma can't express partial indexes.
  code                  String?
  nameFull              String   @map("name_full")
  nameShort             String?  @map("name_short")
  contactName           String?  @map("contact_name")
  contactPhone          String?  @map("contact_phone")
  contactEmail          String?  @map("contact_email")
  lineId                String?  @map("line_id")
  address               String?
  taxId                 String?  @map("tax_id")
  paymentTerms          String?  @map("payment_terms")
  isActive              Boolean  @default(true) @map("is_active")
  isVatRegistered       Boolean  @default(false) @map("is_vat_registered")
  defaultVatRatePercent Decimal? @map("default_vat_rate_percent") @db.Decimal(5, 2)
  defaultSubjectToWht   Boolean  @default(false) @map("default_subject_to_wht")
  defaultWhtRatePercent Decimal? @map("default_wht_rate_percent") @db.Decimal(5, 2)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  tenant                  Tenant                   @relation(fields: [tenantId], references: [id])
  supplierProductMappings SupplierProductMapping[]
  purchaseOrders          PurchaseOrder[]
  goodsReceipts           GoodsReceipt[]
  expenses                Expense[]
  recurringExpenses       RecurringExpense[]

  @@index([tenantId])
  @@map("supplier")
}

model Category {
  id                String @id @default(uuid()) @db.Uuid
  tenantId          String @map("tenant_id") @db.Uuid
  account           String
  accountingSection String @map("accounting_section")
  groupName         String @map("group")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  tenant            Tenant             @relation(fields: [tenantId], references: [id])
  products          Product[]
  expenseItems      ExpenseItem[]
  recurringExpenses RecurringExpense[]

  @@unique([tenantId, account, accountingSection, groupName])
  @@index([tenantId])
  @@map("category")
}

model Product {
  id                      String   @id @default(uuid()) @db.Uuid
  tenantId                String   @map("tenant_id") @db.Uuid
  /// Uniqueness enforced by partial unique index in
  /// prisma/manual/product_sku_unique.sql (per-tenant, excludes soft-deleted).
  /// Not a Prisma @@unique because Prisma can't express partial indexes.
  sku                     String
  name                    String
  nameEn                  String?  @map("name_en")
  type                    String // "RAW" | "PREPPED"
  primaryDimension        String   @map("primary_dimension") // "WEIGHT" | "VOLUME" | "COUNT"
  categoryId              String?  @map("category_id") @db.Uuid
  liquidDensityTemplateId String?  @map("liquid_density_template_id") @db.Uuid
  densityGPerMlOverride   Decimal? @map("density_g_per_ml_override") @db.Decimal(15, 6)
  yieldPercent            Decimal? @map("yield_percent") @db.Decimal(5, 2)
  parentProductId         String?  @map("parent_product_id") @db.Uuid
  expectedYieldG          Decimal? @map("expected_yield_g") @db.Decimal(15, 6)
  targetMarketPrice       Decimal? @map("target_market_price") @db.Decimal(15, 4)
  imageUrl                String?  @map("image_url")
  isActive                Boolean  @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  tenant                  Tenant                   @relation(fields: [tenantId], references: [id])
  category                Category?                @relation(fields: [categoryId], references: [id])
  liquidDensityTemplate   LiquidDensityTemplate?   @relation(fields: [liquidDensityTemplateId], references: [id])
  parentProduct           Product?                 @relation("ProductPrepped", fields: [parentProductId], references: [id])
  childProducts           Product[]                @relation("ProductPrepped")
  productUnits            ProductUnit[]
  supplierProductMappings SupplierProductMapping[]
  stockMovements          StockMovement[]
  stockAdjustments        StockAdjustment[]
  stockCountItems         StockCountItem[]
  purchaseOrderItems      PurchaseOrderItem[]
  goodsReceiptItems       GoodsReceiptItem[]
  expenseItems            ExpenseItem[]
  wasteLogs               WasteLog[]
  parLevels               ParLevel[]

  /// NOTE: per-tenant sku uniqueness is a PARTIAL unique index (WHERE deleted_at
  /// IS NULL) in prisma/manual/product_sku_unique.sql — NOT a Prisma @@unique,
  /// which Prisma 5.22 can only express as a FULL index (Pitfall #23). See sku field.
  @@index([tenantId])
  @@map("product")
}

model ProductUnit {
  id               String  @id @default(uuid()) @db.Uuid
  productId        String  @map("product_id") @db.Uuid
  unitName         String  @map("unit_name")
  unitDimension    String  @map("unit_dimension")
  toBaseRatio      Decimal @map("to_base_ratio") @db.Decimal(15, 6)
  isBase           Boolean @default(false) @map("is_base")
  isDefaultBuyUnit Boolean @default(false) @map("is_default_buy_unit")
  source           String?
  displayOrder     Int?    @map("display_order")

  product                 Product                  @relation(fields: [productId], references: [id])
  supplierProductMappings SupplierProductMapping[]
  stockAdjustments        StockAdjustment[]
  stockCostDeclarations   StockCostDeclaration[]
  stockCountEntries       StockCountEntry[]
  purchaseOrderItems      PurchaseOrderItem[]
  goodsReceiptItems       GoodsReceiptItem[]
  expenseItems            ExpenseItem[]
  wasteLogs               WasteLog[]
  parLevels               ParLevel[]

  @@unique([productId, unitName])
  @@index([productId])
  @@map("product_unit")
}

model SupplierProductMapping {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  supplierId       String    @map("supplier_id") @db.Uuid
  productId        String    @map("product_id") @db.Uuid
  branchId         String?   @map("branch_id") @db.Uuid // NULL = tenant default, NOT NULL = branch override
  supplierItemCode String?   @map("supplier_item_code")
  supplierItemName String?   @map("supplier_item_name")
  orderUnitId      String?   @map("order_unit_id") @db.Uuid
  currentUnitPrice Decimal?  @map("current_unit_price") @db.Decimal(15, 4)
  minOrderQty      Decimal?  @map("min_order_qty") @db.Decimal(15, 6)
  leadTimeDays     Int?      @map("lead_time_days")
  isPreferred      Boolean   @default(false) @map("is_preferred")
  effectiveFrom    DateTime  @map("effective_from") @db.Date
  effectiveTo      DateTime? @map("effective_to") @db.Date

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  tenant             Tenant              @relation(fields: [tenantId], references: [id])
  supplier           Supplier            @relation(fields: [supplierId], references: [id])
  product            Product             @relation(fields: [productId], references: [id])
  branch             Branch?             @relation(fields: [branchId], references: [id])
  orderUnit          ProductUnit?        @relation(fields: [orderUnitId], references: [id])
  /// Provenance only (ADR 0012 Q3) — a PO line snapshots the numbers it needs and
  /// never reads back through this link.
  purchaseOrderItems PurchaseOrderItem[]

  /// Composite uniqueness enforced by partial unique index in
  /// prisma/manual/supplier_product_mapping_unique.sql
  /// (tenant_id, supplier_id, product_id, branch_id, effective_from)
  /// WHERE deleted_at IS NULL + NULLS NOT DISTINCT.
  /// Not a Prisma @@unique because Prisma can't express partial indexes
  /// (WHERE / NULLS NOT DISTINCT). Closes Pitfall #22/#23 family (soft-deleted
  /// rows never block re-create) + the branch_id-NULL duplicate-default hole.
  @@index([tenantId])
  @@map("supplier_product_mapping")
}

// ============================================================
// TRANSACTIONAL (Sprint 2 — tenant-scoped, RLS required)
// ============================================================
// NOTE: 3 enums ข้างล่างเป็น Prisma enum ตัวแรกของโปรเจกต์ — Sprint 1 ใช้
// String + comment + z.enum ที่ validation layer (Product.type, primaryDimension).
// Part 10 เลือก Prisma enum เพราะ ledger ต้องการ DB-level guarantee
// (sign CHECK อ้าง enum value ตรง ๆ) ไม่ใช่แค่ app-level pattern — ADR 0011 Q2/Q3/Q10.

enum MovementType {
  PO_RECEIVE // +  IN  — written by a GR confirm (Part 13)
  /// -  OUT — written by a GR void (Part 13, ADR 0013 Q6). A confirmed receipt is
  /// never edited; its reversal line posts this compensating movement instead.
  /// Adding it required DROP + re-declare of stock_movement_sign_check — the
  /// standing item ADR 0011 Q2 recorded for every new movement type.
  PO_RECEIVE_REVERSAL
  ADJUST_GAIN // +  IN  — manual count correction up
  ADJUST_LOSS // -  OUT — manual count down / spoilage / waste

  @@map("movement_type")
}

enum SourceType {
  /// -> goods_receipt_item (Part 13). ADR 0011 sketched a flat `goods_received_line`;
  /// ADR 0013 Q5 ships the 3-table spec shape instead. The enum VALUE is unchanged,
  /// so nothing in the ledger migrated — only this comment was stale.
  GR_LINE
  ADJUSTMENT // -> stock_adjustment (Part 10)
  /// -> stock_count_item (Part 15, ADR 0015 Q1). The movement TYPE stays
  /// ADJUST_GAIN/ADJUST_LOSS — a count variance is stock going up or down, not a
  /// new kind of event — so stock_movement_sign_check is untouched and Part 13's
  /// two-migration dance does not apply to this Part.
  STOCK_COUNT
  /// -> waste_log (Part 17, ADR 0017 Q1). Same pattern as STOCK_COUNT above: the
  /// movement TYPE stays ADJUST_LOSS (a void appends ADJUST_GAIN) — throwing food
  /// away is stock going out, not a new kind of event — so stock_movement_sign_check
  /// is untouched and Part 13's two-migration dance does not apply. What this value
  /// buys is /cost's split: ของเสีย means WASTE_LOG alone, and ส่วนต่าง/ปรับปรุง
  /// means STOCK_COUNT + ADJUSTMENT (Q4).
  WASTE_LOG
  SYSTEM_INITIAL // reserved: onboarding initial stock (no writer in Part 10)

  @@map("source_type")
}

/// Why something was thrown away (ADR 0017 Q3). Each value names a DIFFERENT
/// person to talk to — the buyer, the storeman, the kitchen, the front of house —
/// which is the whole reason the reason is stored.
///
/// Two values are deliberately ABSENT:
///   PREP_LOSS  — yield_percent owns conversion loss (Decision #59). Yield covers
///                the knife; this log covers the fridge. A shop that lowers yield
///                to "cover" spoilage buries a fixable recurring loss inside a
///                constant, and Sprint 5's variance then looks healthy for the
///                wrong reason.
///   STAFF_MEAL — a staff meal is not waste. It is a sale that collected no money
///                and its cost belongs to labour/welfare; costing one needs
///                sales_transaction (Sprint 4) + recipe (Sprint 5).
enum WasteReason {
  SPOILED // went off, expired      -> the buyer
  DAMAGED // dropped, crushed       -> the storeman
  COOKING_ERROR // burnt, made wrong      -> the kitchen
  CUSTOMER_RETURN // sent back              -> front of house
  OTHER

  @@map("waste_reason")
}

enum AdjustmentReason {
  RECOUNT
  SPOILAGE
  DAMAGE
  OTHER

  @@map("adjustment_reason")
}

/// Append-only stock ledger. INSERT-only: ไม่มี updatedAt / deletedAt และไม่มี
/// update*Logic / delete*Logic (ADR 0011 Q7). การแก้ = compensating row ใหม่ (Q4).
/// Balance = SUM(qty) แบบ realtime (Q8) — qty เป็น base unit ของ product เสมอ (Q1).
model StockMovement {
  id         String       @id @default(uuid()) @db.Uuid
  tenantId   String       @map("tenant_id") @db.Uuid
  productId  String       @map("product_id") @db.Uuid
  /// NOT NULL (Q6) — stock อยู่ที่ใดที่หนึ่งเสมอ, SUM/GROUP BY ไม่ต้องจัดการ NULL
  branchId   String       @map("branch_id") @db.Uuid
  /// signed, base unit (Q1/Q2): + = เข้า, - = ออก
  qty        Decimal      @db.Decimal(15, 3)
  type       MovementType
  sourceType SourceType   @map("source_type")
  /// Polymorphic source — ไม่มี FK โดยเจตนา (Q3): ledger อยู่ยืนกว่า source ของมัน
  sourceId   String       @map("source_id") @db.Uuid
  /// business time — backdate ได้ (Q5)
  occurredAt DateTime     @default(now()) @map("occurred_at")
  /// audit time — immutable (Q5)
  createdAt  DateTime     @default(now()) @map("created_at")
  createdBy  String       @map("created_by")
  notes      String?

  tenant           Tenant                 @relation(fields: [tenantId], references: [id])
  product          Product                @relation(fields: [productId], references: [id])
  branch           Branch                 @relation(fields: [branchId], references: [id])
  createdByUser    User                   @relation(fields: [createdBy], references: [id])
  /// Part 14: ราคาที่มนุษย์ประกาศให้ movement นี้ (ADJUST_GAIN เท่านั้น, ADR 0014 Q6).
  /// ทิศนี้มี FK ได้ ต่างจาก source polymorphic ข้างบน — ledger ไม่เคยถูกลบ (Q7)
  costDeclarations StockCostDeclaration[]

  /// Sign CHECK (stock_movement_sign_check) เขียน INLINE ที่ท้าย migration.sql ของ Part 10
  /// เพราะ Prisma แสดง CHECK ไม่ได้ — precedent: product_density_xor ใน
  /// 20260529151309_part_7d_density_data_capture. ไม่ใช่ manual file: prisma/manual/
  /// สงวนไว้สำหรับสิ่งที่ migration.sql เขียนมือไม่ได้ (partial index / NULLS NOT
  /// DISTINCT / CREATE EXTENSION) — ดู ADR 0011 Q2 correction.
  /// FULL @@unique ปลอดภัยที่นี่ เพราะ ledger ไม่มี soft-delete → Pitfall #22/#23 ไม่ applied.
  @@unique([sourceType, sourceId], map: "stock_movement_source_unique")
  @@index([branchId, occurredAt], map: "stock_movement_branch_audit_idx")
  @@index([productId, branchId, occurredAt, createdAt], map: "stock_movement_chronological_idx")
  @@index([tenantId])
  @@map("stock_movement")
}

/// Manual adjustment source (Q10). 1 adjustment -> 1 StockMovement ใน transaction เดียวกัน
/// (Q4). เก็บ "หน่วย + จำนวนตามที่ผู้ใช้กรอก" ไว้เพื่อ audit (Q1) ส่วน signed base-unit qty
/// อยู่บน movement. reason ป้อน waste analytics ของ Sprint 2.
model StockAdjustment {
  id          String           @id @default(uuid()) @db.Uuid
  tenantId    String           @map("tenant_id") @db.Uuid
  productId   String           @map("product_id") @db.Uuid
  branchId    String           @map("branch_id") @db.Uuid
  /// ADJUST_GAIN | ADJUST_LOSS เท่านั้น — บังคับด้วย stock_adjustment_type_check
  /// (inline ท้าย migration.sql เดียวกัน, ADR 0011 Q10)
  type        MovementType
  reason      AdjustmentReason
  /// as-entered magnitude (Q1) — precision (15,3) ให้ตรงกับ movement.qty
  /// เพื่อไม่ให้ input_qty × toBaseRatio -> qty มี precision กระโดด
  inputQty    Decimal          @map("input_qty") @db.Decimal(15, 3)
  inputUnitId String           @map("input_unit_id") @db.Uuid
  /// business time — mirror ค่าเดียวกับ movement.occurredAt (Q5)
  occurredAt  DateTime         @map("occurred_at")
  createdAt   DateTime         @default(now()) @map("created_at")
  createdBy   String           @map("created_by")

  tenant        Tenant      @relation(fields: [tenantId], references: [id])
  product       Product     @relation(fields: [productId], references: [id])
  branch        Branch      @relation(fields: [branchId], references: [id])
  inputUnit     ProductUnit @relation(fields: [inputUnitId], references: [id])
  createdByUser User        @relation(fields: [createdBy], references: [id])

  @@index([tenantId])
  @@index([productId, branchId, occurredAt], map: "stock_adjustment_product_branch_idx")
  @@map("stock_adjustment")
}

// ============================================================
// COST (Sprint 2 Part 14 — ADR 0014)
// ============================================================
// Product cost is FIFO and is NOT STORED — it is computed by replaying
// stock_movement on every read (ADR 0014 Q2/Q4). There is no cost_layer table
// and no product_cost_history; the one table this Part adds exists solely to
// answer the question the documents cannot: what did stock cost that arrived
// WITHOUT a document (a recount gain — ADR 0011 Q10 gave stock_adjustment no
// price column, deliberately).
// ============================================================

/// A signed, dated statement of the cost of stock that arrived with no document
/// (ADR 0014 Q6). APPEND + SUPERSEDE, exactly like a supplier price series
/// (ADR 0009): a correction never overwrites — it opens a new row and closes the
/// previous one by stamping superseded_at. Overwriting in place would lose who
/// said what, and the feature exists precisely so a person can put their name to
/// a number.
///
/// ADJUST_GAIN movements ONLY. A received item's price belongs to its receipt,
/// and ADR 0013 Q6 already decided a receipt is voided rather than edited.
/// Enforced IN-APP inside the write transaction, not by a CHECK: the rule reads
/// a column on another table (stock_movement.type) and Postgres CHECKs cannot.
/// Same call as ADR 0012 Q2 made for the allocation-sum invariant, and the same
/// reason — a trigger would be the only DB-level option and it is not worth one.
///
/// A declaration applies at EVERY date, including ones already reported: it
/// corrects our knowledge of the past, not the events of the past (contrast a
/// Part 13 void, where the reversal is itself an event and occurs now).
model StockCostDeclaration {
  id         String @id @default(uuid()) @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  movementId String @map("movement_id") @db.Uuid

  /// AS ENTERED (mirrors stock_adjustment's input_qty/input_unit_id, ADR 0011 Q1):
  /// an owner declares "กระสอบละ 4,500", never "180.0000 ฿/kg". Keeping what was
  /// typed is what lets the UI show the number back in the words it was given.
  inputUnitCost Decimal @map("input_unit_cost") @db.Decimal(15, 4)
  inputUnitId   String  @map("input_unit_id") @db.Uuid

  /// DERIVED: inputUnitCost / inputUnit.toBaseRatio — cost per BASE unit, the
  /// denomination the ledger and the replay both work in. Scale 4 matches
  /// goods_receipt_item.unit_price_actual: this is a rate, not money. The layer's
  /// MONEY is computed at replay as round(unitCost x qty, 2) — ADR 0014 Q12 keeps
  /// money, never a rate, as the stored quantity of a layer.
  unitCost Decimal @map("unit_cost") @db.Decimal(15, 4)

  /// Why this number — "ของจากใบส่งของ 15 ส.ค. ที่ลืมคีย์". Free text on purpose:
  /// the reasons are the messy ones a fixed enum would flatten.
  note String?

  declaredAt   DateTime  @default(now()) @map("declared_at")
  declaredBy   String    @map("declared_by")
  /// null = the live declaration. Only one per movement may be null — enforced by
  /// the PARTIAL unique in prisma/manual/stock_cost_declaration_live_unique.sql
  /// (a FULL unique would be Pitfall #22/#23 again: superseded rows would block
  /// the correction that superseded them).
  supersededAt DateTime? @map("superseded_at")

  tenant         Tenant        @relation(fields: [tenantId], references: [id])
  movement       StockMovement @relation(fields: [movementId], references: [id])
  inputUnit      ProductUnit   @relation(fields: [inputUnitId], references: [id])
  declaredByUser User          @relation(fields: [declaredBy], references: [id])

  @@index([tenantId])
  @@index([movementId], map: "stock_cost_declaration_movement_idx")
  @@map("stock_cost_declaration")
}

// ============================================================
// STOCK COUNT (Sprint 3 Part 15 — ADR 0015)
// ============================================================
// The document that reconciles the Ledger with the shelf. DRAFT is a working
// sheet; CLOSED posts each line's variance as an ordinary ADJUST_GAIN/ADJUST_LOSS
// with source_type = STOCK_COUNT; VOIDED appends reversal lines (Q6).
//
// It stores NO money (Q4): a stored valuation would be falsified by the next cost
// declaration, exactly as product_cost_history would have been (ADR 0014). It DOES
// store qty_expected (Q3) — "what did the system say when you stood at the shelf"
// is a past observation, not a valuation.
// ============================================================

enum StockCountStatus {
  DRAFT
  CLOSED
  VOIDED

  @@map("stock_count_status")
}

/// One counting event at one branch. At most one DRAFT per branch — enforced by
/// the partial unique in prisma/manual/stock_count_open_unique.sql, because two
/// people counting the same shelf would otherwise both see the same expected
/// figure, both find the same shortage, and both post it (Q8).
model StockCount {
  id           String           @id @default(uuid()) @db.Uuid
  tenantId     String           @map("tenant_id") @db.Uuid
  branchId     String           @map("branch_id") @db.Uuid
  /// {BRANCH_CODE}-SC-#### per branch. PARTIAL unique (Pitfall #22/#23).
  scNumber     String           @map("sc_number")
  /// The document's HUMAN NAME ("the count of 20 Aug") — NOT an accounting date.
  /// A variance occurs at its own line's counted_at (Q8).
  countDate    DateTime         @map("count_date") @db.Date
  status       StockCountStatus @default(DRAFT)
  /// Q7: blind counting. UI-only — qty_expected is captured either way.
  showExpected Boolean          @default(true) @map("show_expected")
  notes        String?

  startedBy  String    @map("started_by")
  closedAt   DateTime? @map("closed_at")
  closedBy   String?   @map("closed_by")
  voidedAt   DateTime? @map("voided_at")
  voidedBy   String?   @map("voided_by")
  voidReason String?   @map("void_reason")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  tenant        Tenant           @relation(fields: [tenantId], references: [id])
  branch        Branch           @relation(fields: [branchId], references: [id])
  startedByUser User             @relation("ScStartedBy", fields: [startedBy], references: [id])
  closedByUser  User?            @relation("ScClosedBy", fields: [closedBy], references: [id])
  voidedByUser  User?            @relation("ScVoidedBy", fields: [voidedBy], references: [id])
  items         StockCountItem[]

  @@index([tenantId])
  @@index([branchId, countDate], map: "stock_count_branch_date_idx")
  @@map("stock_count")
}

/// One product, counted once. Its presence means the product WAS counted; a
/// counted 0 is a real observation and posts a loss down to zero (Q7).
///
/// This row is the ledger's SOURCE (Q1): source_type = STOCK_COUNT, source_id =
/// this id, which is what makes closing idempotent via the ledger's existing
/// UNIQUE(source_type, source_id).
model StockCountItem {
  id           String @id @default(uuid()) @db.Uuid
  tenantId     String @map("tenant_id") @db.Uuid
  stockCountId String @map("stock_count_id") @db.Uuid
  productId    String @map("product_id") @db.Uuid
  lineNo       Int    @map("line_no")

  /// Base-unit total of this line's entries. Q7: 0 is a real count, not an absence.
  qtyCounted  Decimal @map("qty_counted") @db.Decimal(15, 3)
  /// SNAPSHOT of the ledger balance taken when this line was saved (Q3), NOT at
  /// close and never recomputed. May be negative — ADR 0011 Q9 allows it.
  /// variance = qtyCounted - qtyExpected is computed at READ: it is arithmetic on
  /// two stored columns, not a third fact to keep in step.
  qtyExpected Decimal @map("qty_expected") @db.Decimal(15, 3)

  /// Business time of the variance movement (Q8) — a TRUE INSTANT, the moment
  /// someone stood at the shelf, not the close.
  countedAt     DateTime @map("counted_at")
  countedBy     String   @map("counted_by")
  /// Who actually walked and counted, when that is not the account holder — in a
  /// Thai SME the owner holds the only login and the staff do the counting (Q2).
  countedByName String?  @map("counted_by_name")
  notes         String?

  /// Set on a reversal line appended by a void (Q6). Such a line carries the
  /// ORIGINAL's numbers swapped, so its variance is the exact negation — which is
  /// also why qty_counted's non-negative CHECK exempts reversal rows.
  reversalOfItemId String? @map("reversal_of_item_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant        Tenant            @relation(fields: [tenantId], references: [id])
  stockCount    StockCount        @relation(fields: [stockCountId], references: [id])
  product       Product           @relation(fields: [productId], references: [id])
  countedByUser User              @relation(fields: [countedBy], references: [id])
  reversalOf    StockCountItem?   @relation("ScItemReversal", fields: [reversalOfItemId], references: [id])
  reversals     StockCountItem[]  @relation("ScItemReversal")
  entries       StockCountEntry[]

  @@index([tenantId])
  @@index([stockCountId], map: "stock_count_item_count_idx")
  @@map("stock_count_item")
}

/// What the user actually typed, per unit — "2 กระสอบ + 3 kg" is two rows.
/// The base-unit total lives on the item; these preserve the as-entered form for
/// audit, mirroring stock_adjustment's input_qty/input_unit_id (ADR 0011 Q1).
model StockCountEntry {
  id               String  @id @default(uuid()) @db.Uuid
  tenantId         String  @map("tenant_id") @db.Uuid
  stockCountItemId String  @map("stock_count_item_id") @db.Uuid
  productUnitId    String  @map("product_unit_id") @db.Uuid
  qtyInUnit        Decimal @map("qty_in_unit") @db.Decimal(15, 3)
  displayOrder     Int     @map("display_order")

  createdAt DateTime @default(now()) @map("created_at")

  tenant      Tenant         @relation(fields: [tenantId], references: [id])
  item        StockCountItem @relation(fields: [stockCountItemId], references: [id])
  productUnit ProductUnit    @relation(fields: [productUnitId], references: [id])

  @@index([tenantId])
  @@index([stockCountItemId], map: "stock_count_entry_item_idx")
  @@map("stock_count_entry")
}

// ============================================================
// PROCUREMENT (Sprint 2 Part 11 — ADR 0012)
// ============================================================
// A PO is a DOCUMENT THAT LEFT THE BUILDING: editable while DRAFT, frozen from
// SENT (Q4). Every number a line needs in order to still mean the same thing
// years later — unit price, unit name, to_base_ratio — is COPIED onto the line
// (Q3), never followed through a live FK.
//
// Deliberate divergences from master-spec §5.3, all recorded in ADR 0012:
//   - no purchase_request / from_pr_ids / source_pr_id (Q1 — PR is Sprint 3+)
//   - no wht_expected_amount / net_payment_expected (Q6 — WHT is Sprint 3)
//   - no H.2 deferrable trigger pair (Q2 — the allocation sum is app-enforced)
//   - tenant_id lives on ALL THREE tables, unlike the spec's child-table shape:
//     app-layer isolation (ADR 0004) works by filtering tenantId EXPLICITLY, and
//     a column that isn't there cannot be filtered. RLS is still inert.

enum PurchaseOrderStatus {
  DRAFT // editable
  SENT // frozen (Q4); sent_at set
  PARTIALLY_RECEIVED // written by Part 13 (GR) only
  RECEIVED // written by Part 13 (GR) only
  CANCELLED // terminal; a sent PO is never deleted (Q9)

  @@map("purchase_order_status")
}

/// Order header. VAT is snapshotted here at send time (Q6); WHT is not captured.
model PurchaseOrder {
  id         String              @id @default(uuid()) @db.Uuid
  tenantId   String              @map("tenant_id") @db.Uuid
  /// NOT NULL (spec §125) — an order is always placed by a branch, and its code
  /// is baked into po_number.
  branchId   String              @map("branch_id") @db.Uuid
  supplierId String              @map("supplier_id") @db.Uuid
  /// {BRANCH_CODE}-PO-#### (Q8), counter per branch, never resets. Uniqueness =
  /// PARTIAL unique in prisma/manual/purchase_order_number_unique.sql (a DRAFT can
  /// be soft-deleted — Q9 — so a FULL unique would be Pitfall #22/#23).
  poNumber   String              @map("po_number")
  status     PurchaseOrderStatus @default(DRAFT)

  expectedDeliveryDate DateTime? @map("expected_delivery_date") @db.Date

  /// --- VAT snapshot (Q6), frozen when the PO is sent ---
  /// Sum of line totals. 15,2 = THB satang; unit prices carry more precision.
  subtotalExclVat Decimal  @default(0) @map("subtotal_excl_vat") @db.Decimal(15, 2)
  /// null = this order carries no VAT (supplier not registered).
  vatRatePercent  Decimal? @map("vat_rate_percent") @db.Decimal(5, 2)
  vatAmount       Decimal  @default(0) @map("vat_amount") @db.Decimal(15, 2)
  totalAmount     Decimal  @default(0) @map("total_amount") @db.Decimal(15, 2)

  notes String?

  /// --- lifecycle audit (Q4/Q9) ---
  createdBy    String    @map("created_by")
  sentAt       DateTime? @map("sent_at")
  sentBy       String?   @map("sent_by")
  cancelledAt  DateTime? @map("cancelled_at")
  cancelledBy  String?   @map("cancelled_by")
  cancelReason String?   @map("cancel_reason")

  /// --- manual short-close (Part 13, ADR 0013 Q8) ---
  /// Set when someone declares a partially-received order finished. `status` goes
  /// to RECEIVED; these three record that it got there by decision rather than by
  /// delivery. Deliberately NOT a 5th status value — every existing filter, badge
  /// and label keeps working, and the reason is still on the record.
  closedShortAt     DateTime? @map("closed_short_at")
  closedShortBy     String?   @map("closed_short_by")
  closedShortReason String?   @map("closed_short_reason")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  /// DRAFT only (Q9) — a sent PO goes to CANCELLED and stays visible forever.
  deletedAt DateTime? @map("deleted_at")

  tenant            Tenant              @relation(fields: [tenantId], references: [id])
  branch            Branch              @relation(fields: [branchId], references: [id])
  supplier          Supplier            @relation(fields: [supplierId], references: [id])
  createdByUser     User                @relation("PoCreatedBy", fields: [createdBy], references: [id])
  sentByUser        User?               @relation("PoSentBy", fields: [sentBy], references: [id])
  cancelledByUser   User?               @relation("PoCancelledBy", fields: [cancelledBy], references: [id])
  closedShortByUser User?               @relation("PoClosedShortBy", fields: [closedShortBy], references: [id])
  items             PurchaseOrderItem[]
  goodsReceipts     GoodsReceipt[]

  @@index([tenantId])
  @@index([tenantId, status], map: "purchase_order_tenant_status_idx")
  @@index([branchId, status], map: "purchase_order_branch_status_idx")
  @@index([supplierId], map: "purchase_order_supplier_idx")
  @@map("purchase_order")
}

/// One ordered product. Everything under "snapshot" is frozen at send time (Q3)
/// and must never be re-derived from the live ProductUnit / mapping afterwards.
model PurchaseOrderItem {
  id              String @id @default(uuid()) @db.Uuid
  tenantId        String @map("tenant_id") @db.Uuid
  purchaseOrderId String @map("purchase_order_id") @db.Uuid
  productId       String @map("product_id") @db.Uuid
  /// Stable display order + the identity the edit form diffs rows by.
  lineNo          Int    @map("line_no")

  /// Quantity IN THE ORDERED UNIT (Q3) — what the supplier's invoice will say.
  qtyOrdered  Decimal @map("qty_ordered") @db.Decimal(15, 3)
  orderUnitId String  @map("order_unit_id") @db.Uuid

  /// --- snapshot (Q3) ---
  /// Copied from ProductUnit at send time so a later rename/ratio edit cannot
  /// change what this order meant. to_base_ratio mirrors ProductUnit's (15,6).
  orderUnitName String  @map("order_unit_name")
  toBaseRatio   Decimal @map("to_base_ratio") @db.Decimal(15, 6)
  /// excl VAT. 15,4 matches supplier_product_mapping.current_unit_price.
  unitPrice     Decimal @map("unit_price") @db.Decimal(15, 4)
  /// round(qtyOrdered × unitPrice, 2) — computed in the app, stored, never re-derived.
  lineTotal     Decimal @map("line_total") @db.Decimal(15, 2)

  /// Provenance ONLY (Q3). null = the price was typed by hand (Q5).
  supplierProductMappingId String? @map("supplier_product_mapping_id") @db.Uuid

  /// Maintained by Part 13 (GR) exclusively; created here so Part 13 needs no
  /// migration on a table it does not own.
  qtyReceived Decimal @default(0) @map("qty_received") @db.Decimal(15, 3)

  notes String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant                 Tenant                        @relation(fields: [tenantId], references: [id])
  purchaseOrder          PurchaseOrder                 @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product                Product                       @relation(fields: [productId], references: [id])
  orderUnit              ProductUnit                   @relation(fields: [orderUnitId], references: [id])
  supplierProductMapping SupplierProductMapping?       @relation(fields: [supplierProductMappingId], references: [id])
  allocations            PurchaseOrderItemAllocation[]
  goodsReceiptItems      GoodsReceiptItem[]

  @@unique([purchaseOrderId, lineNo], map: "purchase_order_item_line_unique")
  @@index([tenantId])
  @@index([purchaseOrderId], map: "purchase_order_item_parent_idx")
  @@index([productId], map: "purchase_order_item_product_idx")
  @@map("purchase_order_item")
}

/// Department attribution of a line's quantity (Q2). SUM(qtyAllocated) per line
/// MUST equal the line's qtyOrdered — enforced in the write transaction, NOT by
/// the H.2 trigger pair (see ADR 0012 Q2). While departments are off there is
/// exactly one row per line, pointing at "Main".
/// No deletedAt: allocations are replaced wholesale with their (DRAFT) parent line.
model PurchaseOrderItemAllocation {
  id                  String  @id @default(uuid()) @db.Uuid
  tenantId            String  @map("tenant_id") @db.Uuid
  purchaseOrderItemId String  @map("purchase_order_item_id") @db.Uuid
  departmentId        String  @map("department_id") @db.Uuid
  qtyAllocated        Decimal @map("qty_allocated") @db.Decimal(15, 3)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant            Tenant                       @relation(fields: [tenantId], references: [id])
  purchaseOrderItem PurchaseOrderItem            @relation(fields: [purchaseOrderItemId], references: [id], onDelete: Cascade)
  department        Department                   @relation(fields: [departmentId], references: [id])
  grItemAllocations GoodsReceiptItemAllocation[]

  @@unique([purchaseOrderItemId, departmentId], map: "po_item_allocation_dept_unique")
  @@index([tenantId])
  @@index([departmentId], map: "po_item_allocation_dept_idx")
  @@map("purchase_order_item_allocation")
}

// ============================================================
// GOODS RECEIPT (Sprint 2 Part 13 — ADR 0013)
// ============================================================
// A GR is THE MOMENT STOCK BECOMES REAL. DRAFT posts nothing; CONFIRMED writes
// one PO_RECEIVE movement per line into the append-only ledger, increments each
// PO line's qty_received, and recomputes the PO status (Q2). A confirmed receipt
// is never edited — VOID appends reversal lines with PO_RECEIVE_REVERSAL
// movements into the same document (Q6), because ADR 0011 forbids mutating a
// movement.
//
// Deliberate divergences from master-spec §5.3, all recorded in ADR 0013:
//   - purchase_order_id is NULLABLE — standalone receipts (Q1)
//   - no invoice_image_url (no object storage) and no auto_created_expense_id
//     (no expense module until Sprint 3) — the ADR 0012 Q6 rule against columns
//     that would be null forever
//   - no product_unit_id as a LIVE FK: the line snapshots unit name + ratio, the
//     same correction ADR 0012 Q3 made for the PO line
//   - variance_qty / variance_price are COMPUTED AT READ, never stored (Q7)
//   - tenant_id on all three tables (ADR 0004 filters it explicitly)

enum GoodsReceiptStatus {
  DRAFT // still counting; posts nothing
  CONFIRMED // ledger written; document locked
  VOIDED // reversed by compensating lines (Q6); never deleted

  @@map("goods_receipt_status")
}

/// One physical delivery. `receivedAt` is a TRUE INSTANT (Q4) — this is the first
/// writer of occurred_at values with a time component, which is why the ledger's
/// day bounds moved to Bangkok.
model GoodsReceipt {
  id              String  @id @default(uuid()) @db.Uuid
  tenantId        String  @map("tenant_id") @db.Uuid
  /// NOT NULL (spec §5.0) — denormalized from the PO when there is one.
  branchId        String  @map("branch_id") @db.Uuid
  /// NOT NULL even for a standalone receipt: you always know who delivered.
  supplierId      String  @map("supplier_id") @db.Uuid
  /// NULL = standalone receipt, bought without an order (Q1).
  purchaseOrderId String? @map("purchase_order_id") @db.Uuid

  /// {BRANCH_CODE}-GR-#### (mirrors po_number). Uniqueness = PARTIAL unique in
  /// prisma/manual/goods_receipt_number_unique.sql — a DRAFT can be soft-deleted,
  /// so a FULL unique would be Pitfall #22/#23.
  grNumber String             @map("gr_number")
  status   GoodsReceiptStatus @default(DRAFT)

  /// Supplier's invoice / delivery-note number, as text. No image, no OCR.
  invoiceNo String? @map("invoice_no")

  /// Part 16 (ADR 0016 Q2). VAT sits at the HEADER, following Decision #35's rule
  /// for expenses. Null rate = no VAT on this delivery.
  vatRatePercent Decimal? @map("vat_rate_percent") @db.Decimal(5, 2)
  vatAmount      Decimal  @default(0) @map("vat_amount") @db.Decimal(15, 2)
  /// SNAPSHOT of tenant.is_vat_registered AT RECEIPT TIME — never read live.
  /// A shop that crosses the 1.8M threshold in October must not have the whole
  /// year's stock silently re-valued: it did pay that VAT and nobody refunds it.
  /// Same rule ADR 0012 Q3 applied to to_base_ratio. When false, the VAT is part
  /// of what the stock cost and Part 14's replay adds it to the layer value.
  vatReclaimable Boolean  @default(false) @map("vat_reclaimable")
  /// Business time of the delivery — becomes every movement's occurred_at (Q4).
  receivedAt     DateTime @map("received_at")
  receivedBy     String   @map("received_by")
  notes          String?
  /// Set at confirm when any line over/under-delivers or its price differs from
  /// the PO (Q3/Q7). Drives review-by-exception, not a block.
  hasDiscrepancy Boolean  @default(false) @map("has_discrepancy")

  /// --- lifecycle audit (Q2/Q6) ---
  confirmedAt DateTime? @map("confirmed_at")
  confirmedBy String?   @map("confirmed_by")
  voidedAt    DateTime? @map("voided_at")
  voidedBy    String?   @map("voided_by")
  voidReason  String?   @map("void_reason")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  /// DRAFT only — a confirmed receipt is voided, never deleted.
  deletedAt DateTime? @map("deleted_at")

  tenant          Tenant             @relation(fields: [tenantId], references: [id])
  branch          Branch             @relation(fields: [branchId], references: [id])
  supplier        Supplier           @relation(fields: [supplierId], references: [id])
  purchaseOrder   PurchaseOrder?     @relation(fields: [purchaseOrderId], references: [id])
  /// At most one, enforced by the partial unique in prisma/manual/ (ADR 0016 Q3).
  expenses        Expense[]
  receivedByUser  User               @relation("GrReceivedBy", fields: [receivedBy], references: [id])
  confirmedByUser User?              @relation("GrConfirmedBy", fields: [confirmedBy], references: [id])
  voidedByUser    User?              @relation("GrVoidedBy", fields: [voidedBy], references: [id])
  items           GoodsReceiptItem[]

  @@index([tenantId])
  @@index([tenantId, status], map: "goods_receipt_tenant_status_idx")
  @@index([branchId, receivedAt], map: "goods_receipt_branch_received_idx")
  @@index([purchaseOrderId], map: "goods_receipt_po_idx")
  @@index([supplierId], map: "goods_receipt_supplier_idx")
  @@map("goods_receipt")
}

/// One received product. THE LEDGER'S SOURCE ROW: source_type = GR_LINE,
/// source_id = this id, one movement each (ADR 0011 Q4).
model GoodsReceiptItem {
  id                  String  @id @default(uuid()) @db.Uuid
  tenantId            String  @map("tenant_id") @db.Uuid
  goodsReceiptId      String  @map("goods_receipt_id") @db.Uuid
  /// NULL for a standalone receipt line (Q1), or for a line received against no
  /// particular order line.
  purchaseOrderItemId String? @map("purchase_order_item_id") @db.Uuid
  productId           String  @map("product_id") @db.Uuid
  lineNo              Int     @map("line_no")

  /// Quantity IN THE RECEIVED UNIT. Positive on a normal line, NEGATIVE on a
  /// reversal line — bound by goods_receipt_item_sign_check.
  qtyReceivedActual Decimal @map("qty_received_actual") @db.Decimal(15, 3)
  receivedUnitId    String  @map("received_unit_id") @db.Uuid

  /// --- snapshot ---
  /// For a PO-based line these are COPIED FROM THE PO LINE'S FROZEN VALUES
  /// (ADR 0012 Consequence 1) — never a fresh ProductUnit lookup, or the
  /// "sack was 25 kg, someone made it 30" bug comes straight back. A standalone
  /// line snapshots the live ProductUnit, because the receipt IS the originating
  /// record and there is no earlier document to disagree with.
  receivedUnitName String  @map("received_unit_name")
  toBaseRatio      Decimal @map("to_base_ratio") @db.Decimal(15, 6)
  /// Price actually invoiced, excl VAT (Q7). Defaults from the PO line, editable.
  unitPriceActual  Decimal @map("unit_price_actual") @db.Decimal(15, 4)
  /// round(qtyReceivedActual × unitPriceActual, 2). variance_qty / variance_price
  /// are NOT stored — they are pure functions of values already on this row.
  lineTotalActual  Decimal @map("line_total_actual") @db.Decimal(15, 2)

  /// Set on a reversal line (Q6): points at the line this one undoes, inside the
  /// SAME document, so the mistake and its correction read side by side.
  reversalOfItemId String? @map("reversal_of_item_id") @db.Uuid

  notes String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant            Tenant                       @relation(fields: [tenantId], references: [id])
  goodsReceipt      GoodsReceipt                 @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderItem PurchaseOrderItem?           @relation(fields: [purchaseOrderItemId], references: [id])
  product           Product                      @relation(fields: [productId], references: [id])
  receivedUnit      ProductUnit                  @relation(fields: [receivedUnitId], references: [id])
  reversalOfItem    GoodsReceiptItem?            @relation("GrLineReversal", fields: [reversalOfItemId], references: [id])
  reversedBy        GoodsReceiptItem[]           @relation("GrLineReversal")
  allocations       GoodsReceiptItemAllocation[]

  @@unique([goodsReceiptId, lineNo], map: "goods_receipt_item_line_unique")
  @@index([tenantId])
  @@index([goodsReceiptId], map: "goods_receipt_item_parent_idx")
  @@index([purchaseOrderItemId], map: "goods_receipt_item_po_item_idx")
  @@index([productId], map: "goods_receipt_item_product_idx")
  @@map("goods_receipt_item")
}

/// Department attribution of a received line (spec §5.3, Decision #45's naming).
/// SUM(qtyAllocatedActual) per line MUST equal the line's qtyReceivedActual —
/// enforced in the write transaction, NOT by H.2's trigger pair (ADR 0012 Q2).
/// Shortage pro-rates by ratio with a largest-remainder tiebreak (H.3); while
/// departments are off there is exactly one row per line, pointing at "Main".
model GoodsReceiptItemAllocation {
  id                   String  @id @default(uuid()) @db.Uuid
  tenantId             String  @map("tenant_id") @db.Uuid
  goodsReceiptItemId   String  @map("goods_receipt_item_id") @db.Uuid
  departmentId         String  @map("department_id") @db.Uuid
  /// Renamed from qty_received_actual to avoid the parent-table collision
  /// (Decision #45). Signed like its parent line — negative on a reversal.
  qtyAllocatedActual   Decimal @map("qty_allocated_actual") @db.Decimal(15, 3)
  /// Which PO allocation this satisfies, when there is one. Provenance only.
  sourcePoAllocationId String? @map("source_po_allocation_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant             Tenant                       @relation(fields: [tenantId], references: [id])
  goodsReceiptItem   GoodsReceiptItem             @relation(fields: [goodsReceiptItemId], references: [id], onDelete: Cascade)
  department         Department                   @relation(fields: [departmentId], references: [id])
  sourcePoAllocation PurchaseOrderItemAllocation? @relation(fields: [sourcePoAllocationId], references: [id])

  @@unique([goodsReceiptItemId, departmentId], map: "gr_item_allocation_dept_unique")
  @@index([tenantId])
  @@index([departmentId], map: "gr_item_allocation_dept_idx")
  @@map("goods_receipt_item_allocation")
}

// ============================================================
// EXPENSE (Sprint 3 Part 16 — ADR 0016)
// ============================================================
// Every baht that leaves the business, in ONE table: rent, utilities, wages,
// services — and materials, because confirming a Goods Receipt writes its own
// expense (Q3). That is what lets /cost read spend from a single place without
// double-counting a purchase against its receipt.
//
// NOT built, each for a stated reason (Q1/Q6/Q7): bill_image_url / slip_image_url
// (no object storage) · allocation_method (Q1 removed both shared strategies,
// leaving one possible value) · payment_status = PARTIAL (it describes an amount
// and there is no payments module to hold one).
//
// Voiding: a GR void SOFT-DELETES the expense it created. There is no separate
// void reason here — the receipt that caused it records who voided it and why,
// and duplicating that would let the two disagree.
// ============================================================

enum ExpenseSource {
  MANUAL
  /// Written by confirmGoodsReceiptLogic, in the same transaction (Q3).
  FROM_GOODS_RECEIPT

  @@map("expense_source")
}

enum ExpensePaymentStatus {
  UNPAID
  PAID

  @@map("expense_payment_status")
}

/// One bill. VAT sits at the HEADER (Decision #35), and WHT is computed on the
/// amount BEFORE VAT (ADR 0016 Q6 — master-spec §5.4's formula is wrong).
model Expense {
  id         String  @id @default(uuid()) @db.Uuid
  tenantId   String  @map("tenant_id") @db.Uuid
  branchId   String  @map("branch_id") @db.Uuid
  supplierId String? @map("supplier_id") @db.Uuid

  source     ExpenseSource @default(MANUAL)
  /// The receipt this expense was created from. PARTIAL unique, so a replayed
  /// confirm yields one expense — the mechanism used throughout Sprint 2.
  sourceGrId String?       @map("source_gr_id") @db.Uuid

  /// Set when this bill was confirmed from a recurring template (Q5). `period`
  /// is "YYYY-MM"; the pair is PARTIAL unique so confirming twice yields one.
  recurringExpenseId String? @map("recurring_expense_id") @db.Uuid
  period             String?

  billDate     DateTime @map("bill_date") @db.Date
  billNo       String?  @map("bill_no")
  vatInvoiceNo String?  @map("vat_invoice_no")

  subtotalExclVat     Decimal  @map("subtotal_excl_vat") @db.Decimal(15, 2)
  vatRatePercent      Decimal? @map("vat_rate_percent") @db.Decimal(5, 2)
  vatAmount           Decimal  @default(0) @map("vat_amount") @db.Decimal(15, 2)
  /// How the user TYPED it (Decision #36). A Thai shop's bill usually shows the
  /// total; a tax invoice shows both. Kept because it decides which way the
  /// maths ran, which a reader cannot recover from the results alone.
  isPriceVatInclusive Boolean  @default(true) @map("is_price_vat_inclusive")
  totalAmount         Decimal  @map("total_amount") @db.Decimal(15, 2)

  subjectToWht     Boolean  @default(false) @map("subject_to_wht")
  whtRatePercent   Decimal? @map("wht_rate_percent") @db.Decimal(5, 2)
  /// = subtotal_excl_vat × rate/100 — the PRE-VAT base (Q6). Withholding on the
  /// VAT-inclusive total over-withholds and breaks the 50 ทวิ reconciliation.
  whtAmount        Decimal? @map("wht_amount") @db.Decimal(15, 2)
  whtCertificateNo String?  @map("wht_certificate_no")
  /// = total_amount − wht_amount. What actually leaves the bank.
  netPaymentAmount Decimal  @map("net_payment_amount") @db.Decimal(15, 2)

  paymentMethod String?              @map("payment_method")
  paymentStatus ExpensePaymentStatus @default(UNPAID) @map("payment_status")
  paidAt        DateTime?            @map("paid_at")

  notes String?

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String    @map("created_by")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  tenant        Tenant            @relation(fields: [tenantId], references: [id])
  branch        Branch            @relation(fields: [branchId], references: [id])
  supplier      Supplier?         @relation(fields: [supplierId], references: [id])
  sourceGr      GoodsReceipt?     @relation(fields: [sourceGrId], references: [id])
  recurring     RecurringExpense? @relation(fields: [recurringExpenseId], references: [id])
  createdByUser User              @relation(fields: [createdBy], references: [id])
  items         ExpenseItem[]

  @@index([tenantId])
  @@index([branchId, billDate], map: "expense_branch_date_idx")
  @@map("expense")
}

/// One line of a bill. `category_id` is what puts it on the COGS or the OpEx side
/// of /cost (Q4) — the 3-tier tree has carried `account` since Sprint 1.
model ExpenseItem {
  id        String @id @default(uuid()) @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  expenseId String @map("expense_id") @db.Uuid
  lineNo    Int    @map("line_no")

  categoryId   String  @map("category_id") @db.Uuid
  /// null = shared / overhead (Decision #31). Always null while departments are
  /// off, and meaningful the day they are switched on — which is why it is built
  /// where `allocation_method` was not.
  departmentId String? @map("department_id") @db.Uuid

  /// Set when the line refers to a stocked product — always so on a line written
  /// from a Goods Receipt, usually null on rent or wages.
  productId     String?  @map("product_id") @db.Uuid
  productUnitId String?  @map("product_unit_id") @db.Uuid
  description   String
  qty           Decimal? @db.Decimal(15, 3)
  unitPrice     Decimal? @map("unit_price") @db.Decimal(15, 4)
  /// EXCLUDING VAT — the header carries the tax (Decision #35).
  totalPrice    Decimal  @map("total_price") @db.Decimal(15, 2)

  createdAt DateTime @default(now()) @map("created_at")

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  expense     Expense      @relation(fields: [expenseId], references: [id])
  category    Category     @relation(fields: [categoryId], references: [id])
  department  Department?  @relation(fields: [departmentId], references: [id])
  product     Product?     @relation(fields: [productId], references: [id])
  productUnit ProductUnit? @relation(fields: [productUnitId], references: [id])

  @@index([tenantId])
  @@index([expenseId], map: "expense_item_expense_idx")
  @@map("expense_item")
}

/// A template for something that repeats. It GENERATES NOTHING (Q5): what is due
/// is computed by asking which months have no expense carrying this id, and a
/// human confirms each one. `defaultAmount` is a starting point — an electricity
/// bill differs every month, which is the whole reason confirmation exists.
model RecurringExpense {
  id         String  @id @default(uuid()) @db.Uuid
  tenantId   String  @map("tenant_id") @db.Uuid
  branchId   String  @map("branch_id") @db.Uuid
  supplierId String? @map("supplier_id") @db.Uuid
  categoryId String  @map("category_id") @db.Uuid

  description   String
  defaultAmount Decimal @map("default_amount") @db.Decimal(15, 2)

  isPriceVatInclusive Boolean  @default(true) @map("is_price_vat_inclusive")
  vatRatePercent      Decimal? @map("vat_rate_percent") @db.Decimal(5, 2)
  subjectToWht        Boolean  @default(false) @map("subject_to_wht")
  whtRatePercent      Decimal? @map("wht_rate_percent") @db.Decimal(5, 2)

  /// Capped at 28 by CHECK: a "due on the 30th" template would skip February,
  /// and a template that silently skips a month is worse than one that lands early.
  dayOfMonth  Int     @map("day_of_month")
  /// "YYYY-MM" inclusive bounds. A period label, not a timestamp — no timezone
  /// question to get wrong (Decision #60).
  startPeriod String  @map("start_period")
  endPeriod   String? @map("end_period")
  isActive    Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  branch   Branch    @relation(fields: [branchId], references: [id])
  supplier Supplier? @relation(fields: [supplierId], references: [id])
  category Category  @relation(fields: [categoryId], references: [id])
  expenses Expense[]

  @@index([tenantId])
  @@map("recurring_expense")
}

// ============================================================
// WASTE + PAR LEVEL (Sprint 3 Part 17 — ADR 0017)
// ============================================================

/// One row = ONE thing thrown away, posted to the ledger immediately (Q2).
/// No DRAFT, no shift sheet: recording waste has to fit in the thirty seconds
/// between the bin and the next order, and an unposted draft would leave the
/// ledger claiming stock that is already in the bin.
///
/// This row IS the ledger's source (Q1): source_type = WASTE_LOG, source_id =
/// this id, which is what makes posting idempotent through the ledger's existing
/// UNIQUE(source_type, source_id) — the same trick stock_count_item gets for free.
/// The id is therefore the client's SUBMIT KEY, exactly as stock_adjustment uses
/// it (src/server/stock-movement.ts createStockAdjustmentLogic).
///
/// NO base-unit qty column, on purpose: a waste movement's qty IS this quantity
/// negated, so storing it here would be a second copy of a number the ledger
/// already holds exactly — and no CHECK can keep two copies honest. Mirrors
/// stock_adjustment (input_qty + input_unit_id here, signed base qty on the
/// movement). This is unlike stock_count_item, which stores qty_counted because
/// the ledger there holds only the VARIANCE.
model WasteLog {
  id          String      @id @default(uuid()) @db.Uuid
  tenantId    String      @map("tenant_id") @db.Uuid
  productId   String      @map("product_id") @db.Uuid
  branchId    String      @map("branch_id") @db.Uuid
  reason      WasteReason
  /// as-entered magnitude, always POSITIVE (waste_log_input_qty_check) — direction
  /// comes from reversal_of_id, not from a sign. Precision (15,3) matches
  /// movement.qty so input_qty × toBaseRatio -> qty has no precision jump.
  inputQty    Decimal     @map("input_qty") @db.Decimal(15, 3)
  inputUnitId String      @map("input_unit_id") @db.Uuid
  /// business time — backdate ได้ (ADR 0011 Q5); mirrors movement.occurredAt
  occurredAt  DateTime    @map("occurred_at")

  /// The login that recorded it, plus who actually threw it away (Q7, ADR 0015 Q2):
  /// in a Thai SME the owner holds the only account and the staff do the work, so
  /// the FK alone would record "the owner threw everything away" — tidy and false.
  wastedBy     String  @map("wasted_by")
  wastedByName String? @map("wasted_by_name")
  notes        String?

  /// A void APPENDS this row against the original (Q2) and posts the compensating
  /// ADJUST_GAIN. It cannot be an in-place edit: the ledger is append-only (ADR 0011
  /// Q7) and the compensating movement needs a source_id of its own to satisfy
  /// UNIQUE(source_type, source_id). Mirrors StockCountItem.reversalOfItemId.
  /// At most ONE reversal per row — partial unique in
  /// prisma/manual/waste_and_par_unique.sql, or a double-submitted void would
  /// credit the stock back twice.
  reversalOfId String? @map("reversal_of_id") @db.Uuid

  /// Stamped on the ORIGINAL when it is voided. No deleted_at anywhere on this
  /// table: correcting waste is a void, never a delete — "this was keyed wrong"
  /// is itself worth being able to see.
  voidedAt   DateTime? @map("voided_at")
  voidedBy   String?   @map("voided_by")
  voidReason String?   @map("void_reason")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant       Tenant      @relation(fields: [tenantId], references: [id])
  product      Product     @relation(fields: [productId], references: [id])
  branch       Branch      @relation(fields: [branchId], references: [id])
  inputUnit    ProductUnit @relation(fields: [inputUnitId], references: [id])
  wastedByUser User        @relation("WasteWastedBy", fields: [wastedBy], references: [id])
  voidedByUser User?       @relation("WasteVoidedBy", fields: [voidedBy], references: [id])
  reversalOf   WasteLog?   @relation("WasteReversal", fields: [reversalOfId], references: [id])
  reversals    WasteLog[]  @relation("WasteReversal")

  @@index([tenantId])
  @@index([branchId, occurredAt], map: "waste_log_branch_occurred_idx")
  @@index([productId, branchId, occurredAt], map: "waste_log_product_branch_idx")
  @@map("waste_log")
}

/// "How much of this should be on the shelf at this branch" (Q5). Scoped to
/// product × branch: a branch that is out of pork is out of pork whatever the
/// business holds elsewhere (ADR 0014 Q9b).
///
/// It SUGGESTS NOTHING and ORDERS NOTHING. Auto-drafting a purchase order needs a
/// preferred supplier, a lead time and someone with authority to approve it; ADR
/// 0012 Q1 already dropped the purchase-request layer for the last of those.
///
/// One live par per (product, branch) — PARTIAL unique in
/// prisma/manual/waste_and_par_unique.sql (Pitfall #22/#23), so a removed par does
/// not block a new one.
model ParLevel {
  id        String @id @default(uuid()) @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  productId String @map("product_id") @db.Uuid
  branchId  String @map("branch_id") @db.Uuid

  /// BASE unit — the stored truth, compared against the ledger balance.
  parQty      Decimal @map("par_qty") @db.Decimal(15, 3)
  /// As entered ("2 กระสอบ"), kept so the form re-opens in the unit the user chose.
  /// Both halves live here because — unlike waste — there is no ledger row holding
  /// the base figure.
  inputQty    Decimal @map("input_qty") @db.Decimal(15, 3)
  inputUnitId String  @map("input_unit_id") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  /// Soft delete: removing a par deletes the row. A par of 0 is refused by
  /// par_level_qty_check — "no par" is the absence of a row, not a zero.
  deletedAt DateTime? @map("deleted_at")

  tenant    Tenant      @relation(fields: [tenantId], references: [id])
  product   Product     @relation(fields: [productId], references: [id])
  branch    Branch      @relation(fields: [branchId], references: [id])
  inputUnit ProductUnit @relation(fields: [inputUnitId], references: [id])

  @@index([tenantId])
  @@index([branchId], map: "par_level_branch_idx")
  @@map("par_level")
}
